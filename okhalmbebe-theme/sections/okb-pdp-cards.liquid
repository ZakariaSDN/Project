{%- comment -%}
  OKB · Cartes confort (fiche produit)
  Trois cartes photo + pictogramme + titre + texte.
  Sur mobile, les cartes défilent horizontalement pour limiter le scroll.
{%- endcomment -%}
{{- 'okb-cododo.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign st = section.settings
-%}

<div class="okb okb-cd okb-cd-cards">
  <div class="okb-wrap">
    {%- if st.eyebrow != blank -%}
      <div class="okb-eyebrow okb-cd-center">{{ st.eyebrow | escape }}</div>
    {%- endif -%}
    {%- if st.heading != blank -%}
      <h2 class="okb-h2">{{ st.heading | escape }}</h2>
    {%- endif -%}

    <ul class="okb-cd-cards__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image
          if block.settings.image_source == 'produit' and product != blank
            assign rang = block.settings.image_index | minus: 1
            assign photo = product.images[rang]
            if photo != blank
              assign img = photo
            endif
          endif
        -%}
        <li class="okb-cd-card" {{ block.shopify_attributes }}>
          <div class="okb-cd-card__media">
            {%- if img != blank -%}
              <img
                src="{{ img | image_url: width: 700 }}"
                srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1000 }} 1000w"
                sizes="(min-width: 990px) 370px, 82vw"
                width="{{ img.width }}" height="{{ img.height }}"
                alt="{{ block.settings.image_alt | default: block.settings.title | escape }}"
                loading="lazy" decoding="async">
            {%- else -%}
              <div class="okb-cd-ph" role="img" aria-label="{{ block.settings.image_alt | default: block.settings.title | escape }}">
                {{- 'product-apparel-1' | placeholder_svg_tag -}}
              </div>
            {%- endif -%}
          </div>
          <div class="okb-cd-card__body">
            <div class="okb-cd-card__tag">
              <span class="okb-cd-badge okb-cd-badge--sm">{%- render 'okb-cododo-icon', icon: block.settings.icon -%}</span>
              {%- if block.settings.label != blank -%}<span>{{ block.settings.label | escape }}</span>{%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3>{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="okb-cd-card__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "OKB · Cartes confort",
  "class": "okb-section okb-section--cd-cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pensé pour le confort du quotidien" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Carte",
      "limit": 4,
      "settings": [
        {
          "type": "select", "id": "image_source", "label": "Source du visuel",
          "options": [
            { "value": "image", "label": "Image que je dépose" },
            { "value": "produit", "label": "Photo du produit affiché" }
          ],
          "default": "image"
        },
        { "type": "range", "id": "image_index", "label": "Numéro de la photo du produit", "min": 1, "max": 15, "step": 1, "default": 1 },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif de l'image" },
        { "type": "select", "id": "icon", "label": "Pictogramme", "options": [{"value": "aucun", "label": "Aucun"}, {"value": "hauteur", "label": "Hauteur réglable"}, {"value": "roue_frein", "label": "Roue + frein"}, {"value": "bercement", "label": "Mode bercement"}, {"value": "mode_fixe", "label": "Mode fixe"}, {"value": "selecteur", "label": "Sélecteur"}, {"value": "maille", "label": "Maille respirante"}, {"value": "moustiquaire", "label": "Moustiquaire / protection"}, {"value": "panier", "label": "Panier de rangement"}, {"value": "pliable", "label": "Pliable"}, {"value": "compact", "label": "Compact"}, {"value": "transport", "label": "Rangement / transport"}, {"value": "structure", "label": "Structure triangulaire"}, {"value": "rotation", "label": "Rotation 360°"}, {"value": "frein", "label": "Frein"}, {"value": "silence", "label": "Silencieux"}, {"value": "acier", "label": "Acier"}, {"value": "raccord", "label": "Raccord renforcé"}, {"value": "finition", "label": "Finition / anti-corrosion"}, {"value": "textile", "label": "Textile"}, {"value": "demontable", "label": "Démontable"}, {"value": "lavable", "label": "Lavable"}, {"value": "lune", "label": "Lune / nuit"}, {"value": "coeur", "label": "Cœur"}, {"value": "livraison", "label": "Livraison"}, {"value": "cadenas", "label": "Paiement sécurisé"}, {"value": "retour", "label": "Retour"}, {"value": "stock", "label": "Colis / stock"}, {"value": "check", "label": "Coche"}], "default": "maille" },
        { "type": "text", "id": "label", "label": "Étiquette", "info": "Ex. : Maille respirante" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "richtext", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OKB · Cartes confort",
      "blocks": [
        { "type": "card", "settings": { "icon": "maille", "label": "Maille respirante" } },
        { "type": "card", "settings": { "icon": "moustiquaire", "label": "Moustiquaire" } },
        { "type": "card", "settings": { "icon": "panier", "label": "Panier" } }
      ]
    }
  ]
}
{% endschema %}
