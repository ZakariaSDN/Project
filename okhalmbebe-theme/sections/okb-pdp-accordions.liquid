{%- comment -%}
  OKB · Accordéons produit
  Contenus repliés (description courte, bénéfices, spécifications,
  entretien...). Un bloc « Accordéon » peut reprendre la description
  saisie dans la fiche produit Shopify.
{%- endcomment -%}
{{- 'okb-cododo.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign st = section.settings
-%}

<div class="okb okb-cd okb-cd-acc">
  <div class="okb-wrap">
    {%- if st.heading != blank -%}
      <h2 class="okb-h2">{{ st.heading | escape }}</h2>
    {%- endif -%}
    <div class="okb-cd-acc__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign contenu = block.settings.content
          if block.settings.use_description and product != blank and product.description != blank
            assign contenu = product.description
          endif
        -%}
        {%- if block.settings.title == blank or contenu == blank %}{% continue %}{% endif -%}
        <details class="okb-cd-acc__item" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
          <summary>
            {%- if block.settings.icon != 'aucun' -%}
              <span class="okb-cd-badge okb-cd-badge--sm">{%- render 'okb-cododo-icon', icon: block.settings.icon -%}</span>
            {%- endif -%}
            <span class="okb-cd-acc__label">{{ block.settings.title | escape }}</span>
            <span class="okb-cd-acc__sign" aria-hidden="true"></span>
          </summary>
          <div class="okb-cd-acc__content">{{ contenu }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "OKB · Accordéons produit",
  "class": "okb-section okb-section--cd-acc",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre (facultatif)" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Accordéon",
      "settings": [
        { "type": "select", "id": "icon", "label": "Pictogramme", "options": [{"value": "aucun", "label": "Aucun"}, {"value": "hauteur", "label": "Hauteur réglable"}, {"value": "roue_frein", "label": "Roue + frein"}, {"value": "bercement", "label": "Mode bercement"}, {"value": "mode_fixe", "label": "Mode fixe"}, {"value": "selecteur", "label": "Sélecteur"}, {"value": "maille", "label": "Maille respirante"}, {"value": "moustiquaire", "label": "Moustiquaire / protection"}, {"value": "panier", "label": "Panier de rangement"}, {"value": "pliable", "label": "Pliable"}, {"value": "compact", "label": "Compact"}, {"value": "transport", "label": "Rangement / transport"}, {"value": "structure", "label": "Structure triangulaire"}, {"value": "rotation", "label": "Rotation 360°"}, {"value": "frein", "label": "Frein"}, {"value": "silence", "label": "Silencieux"}, {"value": "acier", "label": "Acier"}, {"value": "raccord", "label": "Raccord renforcé"}, {"value": "finition", "label": "Finition / anti-corrosion"}, {"value": "textile", "label": "Textile"}, {"value": "demontable", "label": "Démontable"}, {"value": "lavable", "label": "Lavable"}, {"value": "lune", "label": "Lune / nuit"}, {"value": "coeur", "label": "Cœur"}, {"value": "livraison", "label": "Livraison"}, {"value": "cadenas", "label": "Paiement sécurisé"}, {"value": "retour", "label": "Retour"}, {"value": "stock", "label": "Colis / stock"}, {"value": "check", "label": "Coche"}], "default": "aucun" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "richtext", "id": "content", "label": "Contenu" },
        {
          "type": "checkbox", "id": "use_description", "label": "Utiliser la description du produit",
          "info": "Remplace le contenu ci-dessus par la description saisie dans la fiche produit Shopify.",
          "default": false
        },
        { "type": "checkbox", "id": "open", "label": "Ouvert par défaut", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "OKB · Accordéons produit",
      "blocks": [
        { "type": "item", "settings": { "title": "Description", "use_description": true } },
        { "type": "item", "settings": { "title": "Spécifications" } }
      ]
    }
  ]
}
{% endschema %}
