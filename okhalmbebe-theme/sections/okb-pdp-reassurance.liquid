{%- comment -%}
  OKB · Bandeau de réassurance (fiche produit)
  Quatre caractéristiques courtes avec pictogramme, posées juste sous le
  premier écran. 2 × 2 sur mobile, une seule ligne sur ordinateur.
{%- endcomment -%}
{{- 'okb-cododo.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign st = section.settings
-%}

<div class="okb okb-cd okb-cd-reas okb-cd--{{ st.style }}">
  <div class="okb-wrap">
    {%- if st.heading != blank -%}
      <h2 class="okb-cd-reas__heading">{{ st.heading | escape }}</h2>
    {%- endif -%}
    <ul class="okb-cd-reas__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="okb-cd-reas__item" {{ block.shopify_attributes }}>
          <span class="okb-cd-badge">{%- render 'okb-cododo-icon', icon: block.settings.icon -%}</span>
          <div>
            {%- if block.settings.title != blank -%}
              <h3>{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "OKB · Réassurance produit",
  "class": "okb-section okb-section--cd-reas",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre (facultatif)" },
    {
      "type": "select", "id": "style", "label": "Fond",
      "options": [
        { "value": "sable", "label": "Sable" },
        { "value": "lavande", "label": "Lavande" },
        { "value": "blanc", "label": "Blanc avec filet" }
      ],
      "default": "sable"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Caractéristique",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Pictogramme", "options": [{"value": "aucun", "label": "Aucun"}, {"value": "hauteur", "label": "Hauteur réglable"}, {"value": "roue_frein", "label": "Roue + frein"}, {"value": "bercement", "label": "Mode bercement"}, {"value": "mode_fixe", "label": "Mode fixe"}, {"value": "selecteur", "label": "Sélecteur"}, {"value": "maille", "label": "Maille respirante"}, {"value": "moustiquaire", "label": "Moustiquaire / protection"}, {"value": "panier", "label": "Panier de rangement"}, {"value": "pliable", "label": "Pliable"}, {"value": "compact", "label": "Compact"}, {"value": "transport", "label": "Rangement / transport"}, {"value": "structure", "label": "Structure triangulaire"}, {"value": "rotation", "label": "Rotation 360°"}, {"value": "frein", "label": "Frein"}, {"value": "silence", "label": "Silencieux"}, {"value": "acier", "label": "Acier"}, {"value": "raccord", "label": "Raccord renforcé"}, {"value": "finition", "label": "Finition / anti-corrosion"}, {"value": "textile", "label": "Textile"}, {"value": "demontable", "label": "Démontable"}, {"value": "lavable", "label": "Lavable"}, {"value": "lune", "label": "Lune / nuit"}, {"value": "coeur", "label": "Cœur"}, {"value": "livraison", "label": "Livraison"}, {"value": "cadenas", "label": "Paiement sécurisé"}, {"value": "retour", "label": "Retour"}, {"value": "stock", "label": "Colis / stock"}, {"value": "check", "label": "Coche"}], "default": "hauteur" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "text", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OKB · Réassurance produit",
      "blocks": [
        { "type": "item", "settings": { "icon": "hauteur", "title": "3 niveaux de hauteur", "text": "S’adapte plus facilement à votre environnement." } },
        { "type": "item", "settings": { "icon": "roue_frein", "title": "Roues 360° avec freins", "text": "Facile à déplacer puis à immobiliser." } },
        { "type": "item", "settings": { "icon": "bercement", "title": "Mode bercement", "text": "Passez du mode fixe à un balancement doux." } },
        { "type": "item", "settings": { "icon": "moustiquaire", "title": "Moustiquaire intégrée", "text": "Une protection pratique contre les moustiques et petits insectes." } }
      ]
    }
  ]
}
{% endschema %}
