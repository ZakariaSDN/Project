{%- comment -%}
  OKB · Caractéristiques en un coup d'œil (fiche produit)
  Chaque bloc « Groupe » affiche une liste « Libellé : Valeur ».
  Écrivez une caractéristique par ligne, le libellé et la valeur séparés
  par deux-points. Deux colonnes sur ordinateur, une sur mobile.
{%- endcomment -%}
{{- 'okb-cododo.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign st = section.settings
-%}

<div class="okb okb-cd okb-cd-specs">
  <div class="okb-wrap">
    <div class="okb-cd-specs__panel">
      {%- if st.eyebrow != blank -%}
        <div class="okb-eyebrow okb-cd-center">{{ st.eyebrow | escape }}</div>
      {%- endif -%}
      {%- if st.heading != blank -%}
        <h2 class="okb-h2">{{ st.heading | escape }}</h2>
      {%- endif -%}

      <div class="okb-cd-specs__grid">
        {%- for block in section.blocks -%}
          {%- assign lignes = block.settings.lines | newline_to_br | split: '<br />' -%}
          <div class="okb-cd-specs__group" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3 class="okb-cd-specs__title">
                {%- render 'okb-cododo-icon', icon: block.settings.icon -%}
                <span>{{ block.settings.title | escape }}</span>
              </h3>
            {%- endif -%}
            <dl>
              {%- for ligne in lignes -%}
                {%- assign l = ligne | strip -%}
                {%- if l == blank %}{% continue %}{% endif -%}
                {%- if l contains ':' -%}
                  {%- assign morceaux = l | split: ':' -%}
                  {%- assign libelle = morceaux.first | strip -%}
                  {%- assign valeur = l | remove_first: morceaux.first | remove_first: ':' | strip -%}
                {%- else -%}
                  {%- assign libelle = l -%}
                  {%- assign valeur = '' -%}
                {%- endif -%}
                <div class="okb-cd-specs__row">
                  <dt>{{ libelle | escape }}</dt>
                  <dd>{{ valeur | escape }}</dd>
                </div>
              {%- endfor -%}
            </dl>
          </div>
        {%- endfor -%}
      </div>

      {%- if st.footnote != blank -%}
        <p class="okb-cd-specs__foot">{{ st.footnote | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "OKB · Caractéristiques",
  "class": "okb-section okb-section--cd-specs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Toutes les caractéristiques en un coup d’œil" },
    { "type": "text", "id": "footnote", "label": "Note de bas de tableau", "info": "Ex. : Données indiquées par le fabricant." }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Groupe",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Pictogramme", "options": [{"value": "aucun", "label": "Aucun"}, {"value": "hauteur", "label": "Hauteur réglable"}, {"value": "roue_frein", "label": "Roue + frein"}, {"value": "bercement", "label": "Mode bercement"}, {"value": "mode_fixe", "label": "Mode fixe"}, {"value": "selecteur", "label": "Sélecteur"}, {"value": "maille", "label": "Maille respirante"}, {"value": "moustiquaire", "label": "Moustiquaire / protection"}, {"value": "panier", "label": "Panier de rangement"}, {"value": "pliable", "label": "Pliable"}, {"value": "compact", "label": "Compact"}, {"value": "transport", "label": "Rangement / transport"}, {"value": "structure", "label": "Structure triangulaire"}, {"value": "rotation", "label": "Rotation 360°"}, {"value": "frein", "label": "Frein"}, {"value": "silence", "label": "Silencieux"}, {"value": "acier", "label": "Acier"}, {"value": "raccord", "label": "Raccord renforcé"}, {"value": "finition", "label": "Finition / anti-corrosion"}, {"value": "textile", "label": "Textile"}, {"value": "demontable", "label": "Démontable"}, {"value": "lavable", "label": "Lavable"}, {"value": "lune", "label": "Lune / nuit"}, {"value": "coeur", "label": "Cœur"}, {"value": "livraison", "label": "Livraison"}, {"value": "cadenas", "label": "Paiement sécurisé"}, {"value": "retour", "label": "Retour"}, {"value": "stock", "label": "Colis / stock"}, {"value": "check", "label": "Coche"}], "default": "check" },
        { "type": "text", "id": "title", "label": "Titre du groupe" },
        {
          "type": "textarea", "id": "lines", "label": "Caractéristiques",
          "info": "Une par ligne, sous la forme « Libellé : Valeur »."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "OKB · Caractéristiques",
      "blocks": [
        { "type": "group", "settings": { "title": "Dimensions & utilisation", "icon": "hauteur" } },
        { "type": "group", "settings": { "title": "Structure & mobilité", "icon": "structure" } }
      ]
    }
  ]
}
{% endschema %}
