{%- if d != blank -%}
  <svg class="okb-cd-ico{% if class != blank %} {{ class }}{% endif %}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
