{{ 'parallax.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'parallax.css' | asset_url | stylesheet_tag }}
<div class="color-scheme-{{ section.settings.color_scheme }}">
  <div class="parallax-media-container parallax-height-{{ section.settings.height }}">
    <div class="parallax-media-card">
      <parallax-media class="parallax parallax-media-wrapper parallax-media-main" data-parallax>
        <div
          class="media-wrapper{% if section.settings.video != blank %} video-wrapper{% endif %}"
        >
          {% if section.settings.video != blank %}
            <deferred-media
              class="deferred-media autoplay-true"
              data-type="{{ section.settings.video_url.type }}"
            >
              <template>
                {{
                  section.settings.video
                  | video_tag: image_size: '1100x', autoplay: true, loop: true, controls: false, muted: true
                }}
              </template>
            </deferred-media>
          {% elsif section.settings.image != blank %}
            {%- liquid
              assign height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio | round
              assign sizes = '100vw'
              assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
            %}
            {{
              section.settings.image
              | image_url: width: 3840
              | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
            }}
          {% else %}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </parallax-media>
      {% if section.blocks.size > 0 %}
        <div class="container">
          <div class="parallax-media-content media-content-{{ section.settings.content_width }} text-{{ section.settings.desktop_content_position }} text-{{ section.settings.mobile_content_position }} text-align-{{ section.settings.text_alignment }}">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'subheading' %}
                  {% if block.settings.subheading != blank %}
                    <span class="subheading h4">{{ block.settings.subheading }}</span>
                  {% endif %}
                {% when 'heading' %}
                  {% if block.settings.heading != blank %}
                    <h2 class="parallax-heading {{ block.settings.heading_size }}">
                      <span
                        {% if block.settings.text_style == 'stroke' %}
                          text-stroke
                        {% endif %}
                      >
                        {{- block.settings.heading -}}
                      </span>
                    </h2>
                  {% endif %}
                {% when 'text' %}
                  {% if block.settings.text != blank %}
                    <div class="{{ block.settings.description_size }}">
                      {{ block.settings.text | replace: '<p></p>', '<br>' }}
                    </div>
                  {% endif %}
                {% when 'button' %}
                  {% if block.settings.text != blank and block.settings.link != blank %}
                    <a
                      href="{{ block.settings.link }}"
                      class="scrolling-content-button button button-{{ block.settings.btn_size }}"
                      {{ block.shopify_attributes }}
                    >
                      <span class="button-text">{{ block.settings.text }}</span>
                    </a>
                  {% endif %}
              {% endcase %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
   #shopify-section-{{ section.id }} {
     --color-overlay-background: {{ section.settings.overlay_color.red }},{{ section.settings.overlay_color.green }},{{ section.settings.overlay_color.blue }};
     --color-overlay-opacity: {{ section.settings.overlay_opacity | divided_by:100.0 }};
  position: relative;
   }

   #shopify-section-{{ section.id }} .parallax__container:before {
   content: "";
   position: absolute;
   top: 0;
   left: 0;
   right: 0;
   bottom: 0;
   background: rgba(var(--color-overlay-background));
   opacity: var(--color-overlay-opacity);
   z-index: 1;
    }
</style>

