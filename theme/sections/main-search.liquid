{{ 'nouislider.min.css' | asset_url | stylesheet_tag }}
{{ 'collection-list.css' | asset_url | stylesheet_tag }}
{{ 'featured-blog.css' | asset_url | stylesheet_tag }}
{% paginate search.results by 24 %}
  <div class="section-space color-scheme-{{ section.settings.color_scheme }}">
    <div class="main-search-form">
      <div class="container">
        <div class="search-result-form-wrapper">
          <h3 class="search-main-title">{{ 'templates.search.title' | t }}</h3>
          <search-form>
            <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
              <input type="hidden" name="type" value="product">
              <div class="search-input-box">
                <label for="search-input-{{ section.id }}" class="visually-hidden">Search</label>
                <input
                  id="search-input-{{ section.id }}"
                  type="search"
                  name="q"
                  value="{{ search.terms | escape }}"
                  placeholder="I’ looking for ..."
                  autocomplete="off"
                  autocorrect="off"
                  autocapitalize="off"
                  spellcheck="false"
                  aria-label="Search"
                  data-main-search-input
                >
                <button type="submit" class="drawer-search-icon" aria-label="{{ 'general.search.search' | t }}" style="order:1">
                  <svg
                    class="icon-small"
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M19 19L15.5967 15.5963M18.0385 9.5202C18.0385 14.2258 14.2243 18.0405 9.5192 18.0405C4.8142 18.0405 1 14.2258 1 9.5202C1 4.81464 4.8142 1 9.5192 1C14.2243 1 18.0385 4.81464 18.0385 9.5202Z" stroke="black" stroke-width="1.5" stroke-linecap="round"></path>
                  </svg>
                </button>
                <button type="clear" value="Clear" class="text-size-small" data-main-search-clear>Clear</button>
              </div>
            </form>
          </search-form>
          {%- if search.performed -%}
            <div class="main-search-tab">
              <ul class="list-style-none tab-nav-wrapper border-enabled content-justify-center">
                <li class="tab-nav-item">
                  <a
                    class="tab-nav-link {% if search.types contains 'product' %}active{% endif %}"
                    href="{{ '?type=product&options%5Bprefix%5D=last&q=' | append: search.terms | escape }}"
                  >
                    {{ 'templates.search.product' | t }}
                  </a>
                </li>
                <li class="tab-nav-item">
                  <a
                    class="tab-nav-link {% if search.types contains 'article' %}active{% endif %}"
                    href="{{ '?type=article&options%5Bprefix%5D=last&q=' | append: search.terms | escape }}"
                  >
                    {{ 'templates.search.article' | t }}
                  </a>
                </li>
                <li class="tab-nav-item">
                  <a
                    class="tab-nav-link {% if search.types contains 'page' %}active{% endif %}"
                    href="{{ '?type=page&options%5Bprefix%5D=last&q=' | append: search.terms | escape }}"
                  >
                    {{ 'templates.search.page' | t }}
                  </a>
                </li>
              </ul>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
    <div class="search-results-section">
      {%- if search.performed -%}
        <div class="search-result-wrapper">
          <div class="container">
            {% if search.results_count == 0 %}
              <div class="search-result not-found text-align-center">
                <h5 class="empty-heading">{{ 'templates.search.no_results_simple' | t }} “{{ search.terms }}”</h5>
                <p class="empty-desc text-size-medium">{{ 'templates.search.no_results_sub' | t }}</p>
              </div>
            {% endif %}
            {%- if search.types contains 'product' -%}
              <div class="search-result-products">
                {% if search.filters.size > 0 %}
                  {% render 'filter-sort', section: section, results: search %}
                {% endif %}
                {% if section.settings.enable_filtering and search.filters.size > 0 %}
                  {% render 'filters', results: search %}
                {% endif %}
                <div class="product-contain" id="products-container">
                  {% capture selected_filter %}
                    {%- for filter in search.filters -%}
                      {%- for value in filter.active_values -%}
                        <facet-remove class="remove-facet">
                          {{ value.label | escape }}
                          <a
                            href="{{ value.url_to_remove }}"
                            class="remove-icon"
                            aria-label='Remove filter "Brands"'
                            data-no-instant=""
                          >
                            <svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M8.30594 0.693923C8.17923 0.567253 8.0074 0.496094 7.82823 0.496094C7.64907 0.496094 7.47724 0.567253 7.35053 0.693923L4.25188 3.79257L1.15323 0.693923C1.02653 0.567253 0.854696 0.496094 0.675531 0.496094C0.496366 0.496094 0.324537 0.567253 0.197829 0.693923C0.0711591 0.82063 0 0.99246 0 1.17163C0 1.35079 0.0711591 1.52262 0.197829 1.64933L3.29648 4.74798L0.197829 7.84662C0.0711591 7.97333 0 8.14516 0 8.32433C0 8.50349 0.0711591 8.67532 0.197829 8.80203C0.324537 8.9287 0.496366 8.99986 0.675531 8.99986C0.854696 8.99986 1.02653 8.9287 1.15323 8.80203L4.25188 5.70338L7.35053 8.80203C7.47724 8.9287 7.64907 8.99986 7.82823 8.99986C8.0074 8.99986 8.17923 8.9287 8.30594 8.80203C8.43261 8.67532 8.50376 8.50349 8.50376 8.32433C8.50376 8.14516 8.43261 7.97333 8.30594 7.84662L5.20729 4.74798L8.30594 1.64933C8.43261 1.52262 8.50376 1.35079 8.50376 1.17163C8.50376 0.99246 8.43261 0.82063 8.30594 0.693923Z" fill="currentColor"/>
                            </svg>
                          </a>
                        </facet-remove>
                      {% endfor %}
                      {% if filter.type == 'price_range' %}
                        {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                          <facet-remove class="remove-facet">
                            {%- if filter.min_value.value -%}
                              {{ filter.min_value.value | money }}
                            {%- else -%}
                              {{ 0 | money }}
                            {%- endif -%}
                            -
                            {%- if filter.max_value.value -%}
                              {{ filter.max_value.value | money }}
                            {%- else -%}
                              {{ filter.range_max | money }}
                            {%- endif -%}
                            <a href="{{ filter.url_to_remove }}" class="remove-icon">
                              <svg
                                width="9"
                                height="9"
                                viewBox="0 0 9 9"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path d="M8.30594 0.693923C8.17923 0.567253 8.0074 0.496094 7.82823 0.496094C7.64907 0.496094 7.47724 0.567253 7.35053 0.693923L4.25188 3.79257L1.15323 0.693923C1.02653 0.567253 0.854696 0.496094 0.675531 0.496094C0.496366 0.496094 0.324537 0.567253 0.197829 0.693923C0.0711591 0.82063 0 0.99246 0 1.17163C0 1.35079 0.0711591 1.52262 0.197829 1.64933L3.29648 4.74798L0.197829 7.84662C0.0711591 7.97333 0 8.14516 0 8.32433C0 8.50349 0.0711591 8.67532 0.197829 8.80203C0.324537 8.9287 0.496366 8.99986 0.675531 8.99986C0.854696 8.99986 1.02653 8.9287 1.15323 8.80203L4.25188 5.70338L7.35053 8.80203C7.47724 8.9287 7.64907 8.99986 7.82823 8.99986C8.0074 8.99986 8.17923 8.9287 8.30594 8.80203C8.43261 8.67532 8.50376 8.50349 8.50376 8.32433C8.50376 8.14516 8.43261 7.97333 8.30594 7.84662L5.20729 4.74798L8.30594 1.64933C8.43261 1.52262 8.50376 1.35079 8.50376 1.17163C8.50376 0.99246 8.43261 0.82063 8.30594 0.693923Z" fill="currentColor"/>
                              </svg>
                            </a>
                          </facet-remove>
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                {% endcapture %}
                  <div class="active-facets-wrapper active-facet">
                    {% if section.settings.enable_filtering and search.filters.size > 0 and selected_filter != blank %}
                      <div class="remove-facet-card">
                        {{ selected_filter }}
                        <a
                          href="{{ '?type=product&options%5Bprefix%5D=last&q=' | append: search.terms | escape }}"
                          class="facet-clear-all button-underline"
                        >
                          <span class="link">{{ 'products.facets.clear_all' | t }}</span>
                        </a>
                      </div>
                    {% endif %}
                  </div>
                  <div class="loading-overlay"></div>
                  <product-card-grid
                    id="product-card-grid"
                    class="product-card-grid card-grid-view card-grid-view-3"
                    data-id="{{  section.id  }}"
                  >
                    {%- for item in search.results -%}
                      {%- case item.object_type -%}
                        {%- when 'product' -%}
                          {%- capture current -%}{% cycle section.id: 1, 2, 3, 4 %}{%- endcapture -%}
                          {%- assign placeholder_image = 'product-apparel-' | append: current -%}
                          {% assign product_formid = 'product-form-'
                            | append: section.id
                            | append: forloop.index
                            | append: '-'
                            | append: collection.handle
                          %}

                          <product-card-item class="product-card-item">
                            {% render 'product-card',
                              card_product: item,
                              section: section,
                              productFormId: product_formid,
                              placeholder_image: placeholder_image,
                              media_aspect_ratio: section.settings.grid_image_size
                            %}
                          </product-card-item>
                      {% endcase %}
                    {% endfor %}
                  </product-card-grid>
                  {%- if paginate.pages > 1 -%}
                    <div class="page-navigation text-align-center">
                      {% render 'pagination', paginate: paginate, anchor: '' %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
            {% if search.types contains 'article' %}
              <div class="search-result-article">
                <div class="blog-grid-wrapper ">
                  {%- for item in search.results -%}
                    {%- case item.object_type -%}
                      {%- when 'article' -%}
                        {% assign placeholder_image_index = forloop.index0 | modulo: 3 | plus: 1 %}
                        {% assign placeholder_image = 'blog-apparel-' | append: placeholder_image_index %}
                        {% render 'blog-post',
                          article: item,
                          section: section,
                          placeholder_image: placeholder_image,
                          media_aspect_ratio: section.settings.grid_image_size
                        %}
                    {% endcase %}
                  {% endfor %}
                  {%- liquid
                    if search.types contains 'article'
                      if paginate.pages > 1
                        echo '<div class="page-navigation text-align-center">'
                        render 'pagination', paginate: paginate, anchor: ''
                        echo '</div>'
                      endif
                    endif
                  -%}
                </div>
              </div>
            {% endif %}
            {% if search.types contains 'page' %}
              <div class="search-result-pages">
                <ul class="search-pages-list card-grid-view card-grid-view-3">
                  {%- for item in search.results limit: 50 -%}
                    <li>
                      <a href="{{ item.url }}">
                        {{ item.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
                {%- liquid
                  if search.types contains 'page'
                    if paginate.pages > 1
                      echo '<div class="page-navigation text-align-center">'
                      render 'pagination', paginate: paginate, anchor: ''
                      echo '</di>'
                    endif
                  endif
                -%}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{%- endpaginate -%}
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
  }
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }
  }
</style>
<script src="{{ 'nouislider.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'filter.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "t:sections.main_search.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main_search.settings.enable_filtering.label"

    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main_search.settings.enable_sorting.label"
    },
    {
    "type": "select",
    "id": "grid_image_size",
      "label": "t:global.grid_image_size.label",
      "default": "adapt",
      "options": [
         {
            "value": "adapt",
            "label": "t:global.grid_image_size.options.auto.label"
          },
          {
            "value": "landscape",
            "label": "t:global.grid_image_size.options.landscape.label"
          },
          {
            "value": "portrait",
            "label": "t:global.grid_image_size.options.portrait.label"
          },
          {
            "value": "square",
            "label": "t:global.grid_image_size.options.square.label"
          }
      ]
    },
     {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
        "label": "t:global.color_scheme.label"
    },
    {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }


  ]
}
{% endschema %}
