{{ 'scrolling-text.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'scrolling-text.css' | asset_url | stylesheet_tag }}
<div class="section-space color-scheme-{{ section.settings.color_scheme }}">
  {% if section.settings.background_image != blank %}
    <div class="section-background-image">
      {%- liquid
        assign height = section.settings.background_image.width | divided_by: section.settings.background_image.aspect_ratio | round
        assign sizes = '100vw'
        assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
      -%}
      {{
        section.settings.background_image
        | image_url: width: 3840
        | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
      }}
    </div>
  {% endif %}
  <scrolling-text-card class="scrolling-text-card">
    {% assign limit = 10 %}
    {% if section.blocks.size > 0 %}
      <scrolling-text-item class="scrolling-text-card-item scrolling-text-{{ section.settings.direction }}">
        {% for i in (1..limit) %}
          <div class="scrolling-slide">
            {% for block in section.blocks %}
              <div class="scrolling-text-wrapper">
                {% case block.type %}
                  {% when 'text' %}
                    <span
                      id="text-{{ block.id }}"
                      class="scrolling-text-item scrolling-content-text font-{{ section.settings.text_font }} {% if block.settings.text_style == 'gradient' %}gradient-enabled{% endif %}"
                      {% if block.settings.text_style == 'stroke' %}
                        text-stroke
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.text }}
                    </span>
                  {% when 'icon' %}
                    {% if block.settings.custom_icon != blank %}
                      <span
                        class="scrolling-text-item scrolling-text-icon icon-size-{{ block.settings.icon_size }}"
                        id="icon-{{ block.id }}"
                        {{ block.shopify_attributes }}
                      >
                        {{ block.settings.custom_icon }}
                      </span>
                    {% endif %}
                  {% when 'image' %}
                    {% if block.settings.image != blank %}
                      <span
                        class="scrolling-text-item scrolling-text-image image-size-{{ block.settings.image_size }}"
                        {{ block.shopify_attributes }}
                      >
                        {% assign image_url = block.settings.image %}
                        <img
                          srcset="
                            {%- if image_url.width >= 50 -%}{{ image_url | image_url: width: 50 }} 50w,{%- endif -%}
                            {%- if image_url.width >= 70 -%}{{ image_url | image_url: width: 70 }} 70w,{%- endif -%}
                            {%- if image_url.width >= 80 -%}{{ image_url | image_url: width: 80 }} 80w,{%- endif -%}

                            {{ image_url | image_url }} {{ image_url.width }}w
                          "
                          src="{{ image_url | image_url: width: 80 }}"
                          sizes="calc(100vw - 3rem)"
                          alt="{{ image_url.alt | escape }}"
                          height="{{ image_url.height }}"
                          width="{{ image_url.width }}"
                          loading="lazy"
                        >
                      </span>
                    {% endif %}
                  {% when 'button' %}
                    {% if block.settings.btn_text != blank and block.settings.btn_link != blank %}
                      <span
                        id="button-{{ block.id }}"
                        class="scrolling-text-item scrolling-text-button"
                        {{ block.shopify_attributes }}
                      >
                        <a href="{{ block.settings.btn_link}}" class="button button-{{ block.settings.btn_size }}">
                          <span class="btn__text">{{ block.settings.btn_text }}</span>
                        </a>
                      </span>
                    {% endif %}
                {% endcase %}
              </div>
            {% endfor %}
          </div>
        {% endfor %}
      </scrolling-text-item>
    {% endif %}
  </scrolling-text-card>
</div>
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
    --scrolling-speed:{{section.settings.scrolling_speed}}s;
    position: relative;
  }
   {% if section.settings.background_image != blank %}
     #shopify-section-{{ section.id }} .section-background-image {
       position: absolute;
       width: 100%;
       height: 100%;
       top: 0;
       left: 0;
       z-index: 0;
     }
     #shopify-section-{{ section.id }} .section-background-image img {
       width: 100%;
       height: 100%;
       object-fit: cover;
     }

      #shopify-section-{{ section.id }} .section-background-image:before {
         content: '';
         position: absolute;
         width: 100%;
         height: 100%;
         background: rgb({{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity }}%);
     }
   {% endif %}
  {% for block in section.blocks %}
    #shopify-section-{{ section.id }} #text-{{ block.id }}{
      --color-text:{{ block.settings.text_color.red }},{{ block.settings.text_color.green }},{{ block.settings.text_color.blue }};
      --color-gradient:{{ block.settings.gradient_text }};
      font-size:{{block.settings.desktop_font_size}}px;
    }

     #shopify-section-{{ section.id }} #icon-{{ block.id }}{
       color:{{ block.settings.icon_color | color_to_rgb }}
      }
  {% endfor %}

  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
     --section-top-space:{{ section.settings.top_space_mobile }}px;
     --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
     --scrolling-speed:{{section.settings.scrolling_speed_mobile}}s;
    }

  {% for block in section.blocks %}
    #shopify-section-{{ section.id }} #text-{{ block.id }}{
      font-size:{{block.settings.mobile_font_size}}px;
    }
  {% endfor %}
  }
</style>
{% schema %}
{
  "name": "t:sections.scrolling_content.name",
  "tag": "section",
  "class":"section-scrolling-text",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
      {
        "type":"image_picker",
        "id":"background_image",
         "label":"t:global.general_labels.background_image"
      },
     {
        "type": "range",
        "id": "scrolling_speed",
        "label": "t:sections.scrolling_content.settings.scrolling_speed.label",
        "min": 1,
        "max": 100,
        "unit": "s",
        "default": 15
     },
     {
        "type": "range",
        "id": "scrolling_speed_mobile",
       "label": "t:sections.scrolling_content.settings.scrolling_speed_mobile.label",
        "min": 1,
        "max": 100,
        "unit": "s",
        "default": 15
     },
    {
      "type": "select",
      "id": "direction",
      "label": "t:sections.scrolling_content.settings.direction.label",
      "options": [
        {
          "value": "right",
          "label": "t:sections.scrolling_content.settings.direction.options.right.label"
        },
        {
          "value": "left",
          "label": "t:sections.scrolling_content.settings.direction.options.left.label"
        }
      ],
      "default": "left"
    },
    {
        "type": "select",
        "id": "text_font",
        "label": "t:sections.scrolling_content.settings.text_font.label",
        "default": "body",
        "options": [
          {
            "value": "heading",
            "label": "t:sections.scrolling_content.settings.text_font.options.heading.label"
          },
          {
            "value": "body",
            "label": "t:sections.scrolling_content.settings.text_font.options.body.label"
          }
        ]
    },
    {
      "type":"header",
      "content":"t:global.general_labels.colors"
    },
     {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
       "label": "t:global.color_scheme.label"
    },
      {
        "type": "color",
        "id": "overlay_color",
        "default": "#000000",
        "label":"t:global.general_labels.overlay"
    },
     {
      "type": "range",
      "id": "overlay_opacity",
      "label":"t:global.general_labels.overlay_opacity" ,
      "default": 50,
       "min": 0,
       "max": 100,
      "step": 1,
       "unit": "%"
    },
   {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:sections.scrolling_content.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label":"t:global.general_labels.text",
          "default": "Scrolling text"
        },
        {
          "type": "select",
          "id":"text_style",
          "label":"t:global.text_style.label",
          "default":"none",
          "options": [
            {
              "value":"none",
              "label": "t:global.text_style.options.none.label"

            },
            {
              "value":"stroke",
            "label": "t:global.text_style.options.stroke.label"
            },
            {
              "value":"gradient",
             "label": "t:global.text_style.options.gradient.label"
            }
          ]
        },
        {
          "type":"header",
         "content": "t:global.general_labels.colors"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "t:global.general_labels.text"
        },
        {
          "type": "color_background",
          "id": "gradient_text",
          "label": "t:sections.scrolling_content.blocks.text.settings.gradient_text.label"
        },
        {
          "type": "number",
          "id": "desktop_font_size",
          "label": "t:sections.scrolling_content.blocks.text.settings.desktop_font_size.label",
          "default": 40
        },
        {
          "type": "number",
          "id": "mobile_font_size",
          "label": "t:sections.scrolling_content.blocks.text.settings.mobile_font_size.label",
          "default": 20
        }
      ]
    },
    {
      "type": "icon",
      "name": "t:sections.scrolling_content.blocks.icon.name",
      "settings": [
        {
          "type": "html",
          "id": "custom_icon",
          "label": "t:sections.scrolling_content.blocks.icon.settings.custom_icon.label"
        },
        {
          "type": "select",
          "id": "icon_size",
          "label": "t:sections.scrolling_content.blocks.icon.settings.icon_size.label",
          "default": "medium",
          "options": [
            {
              "value": "small",
               "label": "t:global.general_labels.small"
            },
            {
              "value": "medium",
                "label": "t:global.general_labels.medium"
            },
            {
              "value": "large",
              "label": "t:global.general_labels.large"
            }
          ]
        },
        {
          "type": "color",
          "id":"icon_color",
          "label": "t:sections.scrolling_content.blocks.icon.settings.icon_color.label",
        }
      ]
    },
    {
      "type":"image",
      "name":"t:sections.scrolling_content.blocks.image.name",
      "settings":[
        {
          "type":"image_picker",
          "id":"image",
          "label":"t:global.general_labels.image"
        },
        {
          "type": "select",
          "id": "image_size",
           "label":"t:sections.scrolling_content.blocks.image.settings.image_size.label",
          "default": "medium",
          "options": [
            {
              "value": "small",
               "label": "t:sections.scrolling_content.blocks.image.settings.image_size.options.small.label"
            },
            {
              "value": "medium",
                 "label": "t:sections.scrolling_content.blocks.image.settings.image_size.options.medium.label"
            },
            {
              "value": "large",
               "label": "t:sections.scrolling_content.blocks.image.settings.image_size.options.large.label"
            }
          ]
        }
      ]
    },
    {
      "type":"button",
      "name":"t:sections.scrolling_content.blocks.button.name",
       "settings":[
        {
          "type": "text",
          "id": "btn_text",
          "label": "t:global.general_labels.text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "t:global.general_labels.link"
        },
        {
          "type": "select",
          "id": "btn_size",
          "label": "t:global.btn_size.label",
          "default": "medium",
          "options": [
           {
            "value": "xsmall",
            "label": "t:global.btn_size.options.xsmall.label"
          },
          {
            "value": "small",
            "label": "t:global.btn_size.options.small.label"
          },
          {
            "value": "medium",
            "label": "t:global.btn_size.options.medium.label"
          },
          {
            "value": "large",
            "label": "t:global.btn_size.options.large.label"
          }

          ]
        }

       ]
    }
  ],
  "presets": [
    {
      "name":"t:sections.scrolling_content.presets.name",
       "blocks": [
        {
          "type": "text"
        }

      ]
    }
  ]
}
{% endschema %}
