{{ 'collection-carousel.css'| asset_url | stylesheet_tag: preload: true }}
{{ 'collection-carousel.css' | asset_url | stylesheet_tag }}
<div class="section-space color-scheme-{{ section.settings.color_scheme }} overflow-hidden">
  <div class="container">
    {% if section.settings.heading != blank %}
      <section-heading class="section-header section-header-with-button">
        <h2 class="heading-main {{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </h2>

        {% if section.settings.btn_link != blank and section.settings.btn_text != blank %}
          <div class="action-wrapper text-align-right">
            <a href="{{ section.settings.btn_link }}" class="action-text button-underline">
              {{- section.settings.btn_text -}}
            </a>
          </div>
        {% endif %}
      </section-heading>
    {% endif %}
  </div>
  <div{% unless section.settings.enable_fullwidth %} class="container"{% endunless %}>
  {% liquid
    assign itemsCount = section.settings.number_item 
    if section.settings.slider_slide_shadow
      assign itemsCount = itemsCount | plus: 0.5
    endif
  %}
  <collection-carousel class="p-relative"{% if section.settings.content_style == 'hover_description'%} description-on-hover{% endif %}>
    <slider-main-component
      class="collection-slider-wrapper {% if section.settings.slider_enable %}swiper-container swiper swiper-slider{% else %} collection-grid-wrapper{% endif %} round-enabled
                  {% if section.settings.content_style == 'hover_description' or section.settings.content_style == 'hover_content' %} collection-overlay-content{% endif %}{% if section.settings.content_style == 'hover_content' %} text-hover-on{% elsif section.settings.content_style == 'hover_description' %} description-hover-on{% else %} content-below-image{% endif %}"
      {% if section.settings.slider_enable %}
        data-settings='
            {
            "loop": true,
            "slidesPerView":{{ section.settings.columns_mobile }}{% if section.settings.slider_slide_shadow %}.1{% endif %},
            "spaceBetween":"{{ section.settings.column_gap }}px",
            "navigation": {
              "nextEl": ".swiper-button-next-{{ section.id }}",
              "prevEl": ".swiper-button-prev-{{ section.id }}"
            },
            "breakpoints": {
              "600": {
                "slidesPerView": {{ itemsCount }}
              }
            },
            "scrollbar": {
              "el": ".swiper-progressbar-{{ section.id }}",
              "dragSize":"auto"
            }
          }
        '
      {% endif %}
    >
      <!-- card-grid-view -->
      <div class="swiper-wrapper{% if section.settings.slider_enable == false %} card-grid-view{% if section.settings.swipe_on_mobile %} mobile-swipe{% endif %}{% endif %}">
        {%- for block in section.blocks -%}
          {% liquid
            assign collection = block.settings.collection
            assign image_url = ''
            if block.settings.image != blank
              assign image_url = block.settings.image
            elsif collection.featured_image
              assign image_url = collection.featured_image
            endif

            assign media_aspect_ratio = section.settings.image_ratio
                if media_aspect_ratio == 'landscape'
                  assign imageratio = 75
                elsif media_aspect_ratio == 'square'
                  assign imageratio = 100
                elsif media_aspect_ratio == 'portrait'
                  assign imageratio = 125
                else
                  if image_url != blank
                    assign imageratio = 1 | divided_by: image_url.aspect_ratio | times: 100
                  else
                    assign imageratio = 100
                  endif
                endif
              

          %}
          <div
            id="collection-block-{{ block.id }}"
            class="collection-card {% if section.settings.slider_enable %}swiper-slide{% endif %} {% if section.settings.enable_background %} background-enabled{% endif %} color-scheme-{{ block.settings.color_scheme }}"
            {{ block.shopify_attributes }}
          >
            <div class="collection-image">
              <div class="media-wrapper"  style="--media-ratio:{{ imageratio }}%">
                {% if image_url != blank %}
                  <img
                    srcset="
                      {%- if image_url.width >= 165 -%}{{ image_url | image_url: width: 165 }} 165w,{%- endif -%}
                      {%- if image_url.width >= 330 -%}{{ image_url | image_url: width: 330 }} 330w,{%- endif -%}
                      {%- if image_url.width >= 535 -%}{{ image_url | image_url: width: 535 }} 535w,{%- endif -%}
                      {%- if image_url.width >= 750 -%}{{ image_url | image_url: width: 750 }} 750w,{%- endif -%}
                      {%- if image_url.width >= 1000 -%}{{ image_url | image_url: width: 1000 }} 1000w,{%- endif -%}
                      {%- if image_url.width >= 1500 -%}{{ image_url | image_url: width: 1500 }} 1500w,{%- endif -%}
                      {%- if image_url.width >= 3000 -%}{{ image_url | image_url: width: 3000 }} 3000w,{%- endif -%}
                      {{ image_url | image_url }} {{ image_url.width }}w
                    "
                    src="{{ image_url | image_url: width: 1500 }}"
                    sizes="calc(100vw - 3rem)"
                    alt="{{ image_url.alt | escape }}"
                    height="{{ image_url.height }}"
                    width="{{ image_url.width }}"
                    loading="lazy"
                  >

                {% else %}
                  {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
                  {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
                  {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
              <div class="collection-icon-wrapper">
                {% if block.settings.subheading != blank %}
                  <div class="collection-name">{{ block.settings.subheading }}</div>
                {% endif %}
                {% if collection != blank %}
                  <a href="{{ collection.url }}" class="arrow-icon-wrapper" aria-label="{{ collection.title }}">
                    <svg class="icon-xxsmall" width="13" height="13" viewBox="0 0 13 13" fill="none">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M9.46695 2.30979L0.605106 2.30974L0.6051 0.666385L12.2724 0.666382L12.2724 12.3336L10.6291 12.3337L10.629 3.47182L1.18614 12.9147L0.0241138 11.7526L9.46695 2.30979Z" fill="currentcolor"></path>
                    </svg>
                  </a>
                {% endif %}
              </div>
            </div>
            {% if collection != blank or block.settings.heading != blank or block.settings.description != blank %}
              <div class="collection-content-box">
                <div class="collection-title-wrapper">
                  {% if collection != blank or block.settings.heading != blank %}
                    <h2 class="collection-heading h5">
                      {% if block.settings.heading != blank -%}
                        {{- block.settings.heading -}}
                      {%- elsif collection != blank -%}
                        {{- collection.title -}}
                      {% else %}
                        {{ 'onboarding.collection_title' | t }}
                      {%- endif %}
                    </h2>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <div class="collection-desc-wrapper" data-collection-description>
                      <p class="collection-desc">
                        {{ block.settings.description }}
                      </p>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </slider-main-component>
      {% if section.settings.slider_enable %}
        <div class="swiper-pagination swiper-progressbar swiper-progressbar-{{ section.id }}"></div>
        <div class="swiper-button-wrapper swiper-button-bottomright">
           <div class="swiper-button swiper-button-prev swiper-button-prev-{{ section.id }}"></div>
          <div class="swiper-button swiper-button-next swiper-button-next-{{ section.id }}"></div>
         
        </div>
      {% endif %}
  </collection-carousel>
  </div>
</div>
<style>
   #shopify-section-{{ section.id }} {
     --section-top-space:{{ section.settings.top_space_desktop }}px;
     --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
     --space-column: {{ section.settings.column_gap }}px;
   
   }
  #shopify-section-{{ section.id }} .card-grid-view{
     --card-item-perrow:{{ section.settings.number_item }};
  }
  {% for block in section.blocks  %}
     #shopify-section-{{ section.id }}  #collection-block-{{ block.id }}{
       --color-overlay-background:{{ block.settings.overlay_color.rgb  }};
       --color-overlay-opacity:{{ block.settings.overlay_opacity }}%;
     }
    
   {% endfor %}
   @media only screen and (max-width:767px) {
     #shopify-section-{{ section.id }}.shopify-section{
       --section-top-space:{{ section.settings.top_space_mobile }}px;
       --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
     }
      #shopify-section-{{ section.id }} .card-grid-view{
         --card-item-perrow:{{ section.settings.columns_mobile }};
      }

   }
</style>
{% schema %}
{
  "name": "t:sections.collection_carousel.name",
  "tag": "section",
  "class":"section-collection",
  "max_blocks": 10,
   "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id":"enable_fullwidth",
      "label":"t:global.general_labels.enable_fullwidth",
      "default":false
    },
    {
      "type":"checkbox",
      "id":"slider_enable",
      "label":"t:sections.collection_carousel.settings.slider_enable.label",
      "default":true
    },
    {
      "type":"checkbox",
      "id":"slider_slide_shadow",
      "label":"t:sections.collection_carousel.settings.slider_slide_shadow.label",
      "default":false
    },
    {
      "type":"range",
      "id":"number_item",
      "min": 2,
      "max": 4,
      "step": 1,
      "default":2,
      "label": "t:sections.collection_carousel.settings.number_item.label"
    },
    {
      "type": "range",
      "id":"column_gap",
      "label":"t:sections.collection_carousel.settings.column_gap.label",
      "min":0,
      "max":50,
      "default":20,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "default": "square",
      "options": [
          {
            "value": "adapt",
            "label": "t:global.image_ratio.options.adapt.label"
          },
          {
            "value": "landscape",
            "label": "t:global.image_ratio.options.landscape.label"
          },
          {
            "value": "portrait",
            "label": "t:global.image_ratio.options.portrait.label"
          },
          {
            "value": "square",
            "label": "t:global.image_ratio.options.square.label"
          }
      ],
      "label": "t:global.image_ratio.label"
    },

    
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Our Collections",
      "label": "t:global.general_labels.heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
      "label": "t:global.heading_size.label",
      "options": [
       {
          "value": "h1",
          "label": "t:global.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.heading_size.options.h2.label"
        },
        {
          "value": "h3",
            "label": "t:global.heading_size.options.h3.label"
        },
        {
          "value": "h4",
         "label": "t:global.heading_size.options.h4.label"
        },
        {
          "value": "h5",
           "label": "t:global.heading_size.options.h5.label"
        },
       {
          "value": "h6",
          "label": "t:global.heading_size.options.h6.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:global.general_labels.button"
    },
    {
      "type": "text",
      "id": "btn_text",
      "default": "View All",
      "label": "t:global.general_labels.text"
    },
    {
      "type": "url",
      "id": "btn_link",
      "default": "/collections",
      "label": "t:global.general_labels.link"
    },
    {
      "type":"header",
      "content":"t:global.general_labels.block_content"
    },
    {
      "type":"checkbox",
      "id":"enable_background",
      "label": "t:sections.collection_carousel.settings.enable_background.label",
      "default":true
    },
    {
      "type": "select",
      "id":"content_style",
      "label": "t:sections.collection_carousel.settings.content_style.label",
      "default":"hover_description",
      "options":[
        {
          "value": "hover_content",
          "label":"t:sections.collection_carousel.settings.content_style.options.hover_content.label"
        },
        {
          "value": "hover_description",
          "label":"t:sections.collection_carousel.settings.content_style.options.hover_description.label"
        },
        {
          "value": "content_below",
          "label":"t:sections.collection_carousel.settings.content_style.options.content_below.label"
        }
      ]
    },


    {
      "type": "header",
      "content": "t:global.general_labels.mobile_content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.collection_carousel.settings.columns_mobile.options.columns1.label"
        },
        {
          "value": "2",
          "label": "t:sections.collection_carousel.settings.columns_mobile.options.columns2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.collection_carousel.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "t:sections.collection_carousel.settings.swipe_on_mobile.label"
    },
    {
      "type":"header",
      "content":"t:global.color_scheme.label"
    },
   {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "one",
         "label": "t:global.general_labels.color"
    },
    {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }
  ],
    "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_carousel.blocks.name",
      "settings": [
       {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
        "label": "t:global.color_scheme.label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:global.general_labels.collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:global.general_labels.image"
        },
        {
          "type":"text",
          "id":"subheading",
           "default": "Subheading",
          "label":"t:global.general_labels.subheading"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Collection name",
         "label":"t:global.general_labels.heading"
        },
        {
          "type":"textarea",
          "id":"description",
           "label":"t:global.general_labels.description",
          "default":"Add short description here."
        },
        {
          "type":"header",
          "content": "t:global.general_labels.colors"
        },
      {
        "type": "color",
        "id": "overlay_color",
        "label": "t:global.general_labels.overlay",
        "default": "#000000"
      },
    
      {
        "type": "range",
        "id": "overlay_opacity",
        "label": "t:global.general_labels.overlay_opacity",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 0
      }
      ]
    }
  ],
  "presets": [
      {
        "name": "t:sections.collection_carousel.presets.name",
        "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
      }
    ]
}
{% endschema %}
