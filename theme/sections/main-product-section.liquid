<script>
(() => {
  const root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root) return;
  /* ======= Flèches galerie + compat multi-sliders ======= */
  const gallery = root.querySelector('.media-gallery-card');
  if (gallery) {
    function bindArrows(scope = gallery){
      const prev = scope.querySelector('.mp-media-prev');
      const next = scope.querySelector('.mp-media-next');
      if (!prev || !next) return;
      const tryNavigate = (dir) => {
        const swEl = gallery.querySelector('.swiper, [class*="swiper-container"]');
        const sw = swEl && swEl.swiper;
        if (sw && (sw.initialized || sw.params)) { dir < 0 ? sw.slidePrev() : sw.slideNext(); return true; }
        const spEl = gallery.querySelector('.splide');
        const sp = spEl && spEl.splide;
        if (sp && sp.go) { sp.go(dir < 0 ? '<' : '>'); return true; }
        const flEl = gallery.querySelector('.flickity-enabled');
        const fl = flEl && (flEl.flickity || (flEl._flickity));
        if (fl && (fl.next || fl.previous)) { dir < 0 ? fl.previous() : fl.next(); return true; }
        const selPrev = '.swiper-button-prev, .splide__arrow--prev, .flickity-button.previous, .glider-prev, .slider-button--prev, [aria-label="Previous"]';
        const selNext = '.swiper-button-next, .splide__arrow--next, .flickity-button.next, .glider-next, .slider-button--next, [aria-label="Next"]';
        const btn = gallery.querySelector(dir < 0 ? selPrev : selNext);
        if (btn){ btn.dispatchEvent(new MouseEvent('click', {bubbles:true})); return true; }
        const scroller =
          gallery.querySelector('[data-slider], .splide__track, .flickity-viewport, .glider, .product-media, .gallery-popup-images, .product__media-list, .media, .swiper-wrapper') ||
          gallery;
        scroller.scrollBy({ left: dir * (scroller.clientWidth * 0.9), behavior: 'smooth' });
        return true;
      };
      const tick = (dir) => { tryNavigate(dir) || setTimeout(() => tryNavigate(dir), 120); };
      const onPrev = (e) => { e.preventDefault(); e.stopPropagation(); tick(-1); };
      const onNext = (e) => { e.preventDefault(); e.stopPropagation(); tick(1); };
      if (!prev._mpBound){ prev.addEventListener('click', onPrev, {passive:false}); prev._mpBound = true; }
      if (!next._mpBound){ next.addEventListener('click', onNext, {passive:false}); next._mpBound = true; }
    }
    bindArrows();
    const mo = new MutationObserver(() => { bindArrows(); measureThumbs(); });
    mo.observe(gallery, {subtree:true, childList:true});
    function measureThumbs(){
      const thumbs = gallery.querySelector(
        '.product__media-thumbnails, .thumbnail-slider, .thumbnail-list, .product-thumbnails, [class*="thumb"][class*="list"], [class*="thumb"][class*="wrap"]'
      );
      const w = thumbs ? Math.ceil(thumbs.getBoundingClientRect().width) : 0;
      gallery.style.setProperty('--thumbs-w', w + 'px');
    }
    window.addEventListener('load', measureThumbs);
    window.addEventListener('resize', () => { clearTimeout(window.__thumbsTO); window.__thumbsTO = setTimeout(measureThumbs, 80); }, {passive:true});
    measureThumbs();
  }
  /* ======= Hauteur swatches (égalisée) ======= */
  function measureSwatches(){
    const labels = root.querySelectorAll(
      '.swatches-list .swatch-label, .product-form__input input[type="radio"] + label.swatch-label'
    );
    if (!labels.length) return;
    let maxH = 0;
    labels.forEach(el => { el.style.minHeight = 'auto'; el.style.height = 'auto'; });
    labels.forEach(el => {
      const h = Math.ceil(el.getBoundingClientRect().height);
      if (h > maxH) maxH = h;
    });
    root.style.setProperty('--swatch-h', (maxH || 44) + 'px');
    labels.forEach(el => { el.style.height = ''; el.style.minHeight = ''; });
  }
  const debounced = (() => { let t; return () => { clearTimeout(t); t = setTimeout(measureSwatches, 80); }; })();
  window.addEventListener('load', measureSwatches);
  window.addEventListener('resize', debounced, { passive: true });
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(measureSwatches);
  ['variant:change','variant:changed','product:variant-change','theme:variant:change','desert:variant-change']
    .forEach(evt => document.addEventListener(evt, measureSwatches));
  const info = root.querySelector('.product-info-wrapper');
  if (info){
    const mo2 = new MutationObserver(debounced);
    mo2.observe(info, {subtree:true, childList:true, attributes:true});
  }
  /* ======= Injection contenu (senteur + pictos) ======= */
  const maps = {};
  root.querySelectorAll('script[id^="vmap-{{ section.id }}-"][data-ns][data-key]').forEach(s => {
    try {
      const ns  = s.getAttribute('data-ns');
      const key = s.getAttribute('data-key');
      const k   = ns + '.' + key;
      maps[k]   = JSON.parse(s.textContent || '{}');
    } catch(e){}
  });
  function currentVariantId() {
    const infoCol = root.querySelector('.product-info-wrapper');
    if (!infoCol) return null;
    const form = infoCol.querySelector('form[action*="/cart/add"]');
    const el = form && form.querySelector('[name="id"]');
    return el && el.value ? String(el.value) : null;
  }
  /* NEW: masquage/affichage accordéons selon contenu réel */
  function renderAll(variantId){
    root.querySelectorAll('.vdesc-target[data-vdesc]').forEach(node => {
      const pair   = node.getAttribute('data-vdesc');
      const map    = maps[pair] || {};
      const html   = map[variantId];
      const wrap   = node.closest('.mp-accordion'); // <details> à masquer si vide
      if (typeof html === 'string' && html.trim() !== '') {
        node.innerHTML = html;
        node.hidden = false;
        if (wrap){
          wrap.removeAttribute('data-empty');
          wrap.style.display = '';
          wrap.hidden = false;
        }
      } else {
        // Aucun contenu => masquer le conteneur + l’accordéon
        node.innerHTML = '';
        node.hidden = true;
        if (wrap){
          wrap.setAttribute('data-empty','1');
          wrap.hidden = false;           // on utilise display:none via CSS
        }
      }
    });
  }
  let last = currentVariantId();
  if (last) renderAll(last);
  ['variant:change','variant:changed','product:variant-change','theme:variant:change','desert:variant-change'].forEach(evt => {
    document.addEventListener(evt, () => {
      const now = currentVariantId();
      if (now && now !== last) { last = now; renderAll(now); }
    });
  });
  // ===== Correction robuste : détecter TOUT changement de variante =====
  function maybeRender() {
    const now = currentVariantId();
    if (now && now !== last) {
      last = now;
      renderAll(now);
    }
  }
  // 1) Écouteurs sur le formulaire (si les contrôles sont dedans)
  const variantForm = root.querySelector('form[action*="/cart/add"]');
  if (variantForm) {
    const optionControls = variantForm.querySelectorAll(
      '.product-form__input select, .product-form__input input[type="radio"]'
    );
    optionControls.forEach(el => {
      el.addEventListener('change', maybeRender, { passive: true });
      el.addEventListener('click', () => setTimeout(maybeRender, 0), { passive: true });
    });
    const variantInput = variantForm.querySelector('[name="id"]');
    if (variantInput) {
      variantInput.addEventListener('change', maybeRender);
    }
    const moVariant = new MutationObserver(() => {
      // quand le thème remonte/replace les éléments…
      maybeRender();
      const freshControls = variantForm.querySelectorAll(
        '.product-form__input select, .product-form__input input[type="radio"]'
      );
      freshControls.forEach(el => {
        if (!el._mpBound) {
          el.addEventListener('change', maybeRender, { passive: true });
          el.addEventListener('click', () => setTimeout(maybeRender, 0), { passive: true });
          el._mpBound = true;
        }
      });
    });
    moVariant.observe(variantForm, { subtree: true, childList: true, attributes: true });
  }
  // 2) NEW — capter TOUT clic/changement dans la section (puces hors formulaire, etc.)
  function kick() {
    // on laisse le thème mettre à jour l'ID, puis on relit
    setTimeout(maybeRender, 0);
    setTimeout(maybeRender, 120);
    setTimeout(maybeRender, 400);
    startShortPoll(); // mini-poll pour 2–3 secondes
  }
  root.addEventListener('change', kick, true);
  root.addEventListener('click',  kick, true);
  // 3) NEW — détecter les changements de l’URL ?variant=…
  function checkUrlVariant() {
    const v = new URLSearchParams(location.search).get('variant');
    if (v && v !== last) { last = v; renderAll(v); }
  }
  window.addEventListener('popstate', checkUrlVariant);
  ['pushState','replaceState'].forEach((m) => {
    const orig = history[m];
    history[m] = function() {
      const ret = orig.apply(this, arguments);
      setTimeout(checkUrlVariant, 0);
      return ret;
    };
  });
  // 4) NEW — petit polling sur [name="id"] juste après une interaction
  let __pollTO = null, __pollCount = 0;
  function startShortPoll() {
    clearInterval(__pollTO); __pollCount = 0;
    __pollTO = setInterval(() => {
      const now = currentVariantId();
      if (now && now !== last) { last = now; renderAll(now); }
      if (++__pollCount > 20) clearInterval(__pollTO); // ~2.4s (toutes les 120ms)
    }, 120);
  }
  // 5) déjà en place : première peinture + événements “variant:change” du thème
  // (laisse ton code plus haut qui fait: if (last) renderAll(last); et écoute les events custom)
})();
</script>  <!-- ← FIN de ton script variante -->
