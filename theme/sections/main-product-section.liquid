
{{ 'featured-product.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'featured-product.css' | asset_url | stylesheet_tag }}
{{ 'photoswipe.css' | asset_url | stylesheet_tag }}
{%- assign unique_3d_model = product.media | where: 'media_type', 'model' | first -%}
{%- if unique_3d_model -%}
  <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css">
{%- endif -%}
{% assign current_variant = product.selected_or_first_available_variant %}
<div class="section-space color-scheme-{{ section.settings.color_scheme }}">
  <product-recently-viewed data-product-id="{{ product.id }}" class="hidden"></product-recently-viewed>
  <div class="main-product-container{% if section.settings.enable_fullwidth and section.settings.media_layout != 'slider' %} container-fullwidth{% else %} container{% endif %}">
    <div class="product-box">
      {%- comment -%} ======= MEDIA / GALERIE ======= {%- endcomment -%}
      <div
        class="media-gallery-card mp-media-config pos-d-{{ section.settings.media_align_desktop }} pos-m-{{ section.settings.media_align_mobile }}"
        data-thumbs="{{ section.settings.thumbnail_position }}"
        style="
          --mp-media-height-d: {{ section.settings.media_height_desktop }}px;
          --mp-media-height-m: {{ section.settings.media_height_mobile }}px;
          --mp-media-br: {{ section.settings.media_border_radius }}px;
          --mp-media-fit: {{ section.settings.media_object_fit }};
        "
      >
        {% render 'media-gallery', section: section, current_variant: current_variant %}
        {% if section.settings.enable_gallery_arrows %}
          <button class="mp-media-arrow mp-media-prev" type="button" aria-label="Image précédente">‹</button>
          <button class="mp-media-arrow mp-media-next" type="button" aria-label="Image suivante">›</button>
        {% endif %}
      </div>
      {%- comment -%} ======= COLONNE INFORMATIONS ======= {%- endcomment -%}
      <div class="product-info-wrapper">
        {% render 'product-info', product: product, section: section, current_variant: current_variant %}
        {%- comment -%} ===== Anti-doublon (titres déjà affichés par le bloc accordéon natif) ===== {%- endcomment -%}
        {%- assign _sep = '||' -%}
        {%- capture _cc_titles -%}{%- endcapture -%}
        {%- for b in section.blocks -%}
          {%- if b.type == 'collapsible_content' -%}
            {%- assign _heads = '' -%}
            {%- if b.settings.description_heading != blank -%}{%- assign _heads = _heads | append: b.settings.description_heading | append: _sep -%}{%- endif -%}
            {%- if b.settings.heading_1 != blank -%}{%- assign _heads = _heads | append: b.settings.heading_1 | append: _sep -%}{%- endif -%}
            {%- if b.settings.heading_2 != blank -%}{%- assign _heads = _heads | append: b.settings.heading_2 | append: _sep -%}{%- endif -%}
            {%- if b.settings.heading_3 != blank -%}{%- assign _heads = _heads | append: b.settings.heading_3 | append: _sep -%}{%- endif -%}
            {%- assign _list = _heads | split: _sep -%}
            {%- for h in _list -%}
              {%- unless h == '' -%}
                {%- assign fh = h | strip | downcase
                  | replace: ' ', '-' | replace: ',', '' | replace: '.', ''
                  | replace: '"', ''  | replace: "'", '' | replace: "’", ''
                  | replace: '&', 'et'
                  | replace: 'é', 'e' | replace: 'è', 'e' | replace: 'ê', 'e' | replace: 'ë', 'e'
                  | replace: 'à', 'a' | replace: 'â', 'a' | replace: 'ä', 'a'
                  | replace: 'î', 'i' | replace: 'ï', 'i'
                  | replace: 'ô', 'o' | replace: 'ö', 'o'
                  | replace: 'û', 'u' | replace: 'ü', 'u'
                  | replace: 'ç', 'c'
                -%}
                {%- capture _cc_titles -%}{{ _cc_titles }}{{ _sep }}{{ fh }}{{ _sep }}{%- endcapture -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        {%- comment -%} ====== ACCORDÉONS CUSTOM (senteur + pictogrammes) ====== {%- endcomment -%}
        <div class="mp-extra-accordions">
          {%- for b in section.blocks -%}
            {%- if b.type == 'v_scent' -%}
              {%- assign _heading = b.settings.heading | default: 'Détails de la senteur' -%}
              {%- assign _norm = _heading | strip | downcase
                | replace: ' ', '-' | replace: ',', '' | replace: '.', ''
                | replace: '"', ''  | replace: "'", '' | replace: "’", ''
                | replace: '&', 'et'
                | replace: 'é', 'e' | replace: 'è', 'e' | replace: 'ê', 'e' | replace: 'ë', 'e'
                | replace: 'à', 'a' | replace: 'â', 'a' | replace: 'ä', 'a'
                | replace: 'î', 'i' | replace: 'ï', 'i'
                | replace: 'ô', 'o' | replace: 'ö', 'o'
                | replace: 'û', 'u' | replace: 'ü', 'u'
                | replace: 'ç', 'c'
              -%}
              <details class="mp-accordion" {% if b.settings.open_by_default %}open{% endif %} id="acc-{{ section.id }}-{{ b.id }}">
  <summary class="mp-accordion__summary" style="color: {{ b.settings.heading_color }};">{{ _heading }}</summary>
  <div class="mp-accordion__content">
    <div class="mp-accordion__inner" style="color: {{ b.settings.text_color }};">
      <div class="vdesc-target" data-vdesc="{{ b.settings.v_ns }}.{{ b.settings.v_key }}"></div>
    </div>
  </div>
</details>
             
            {%- endif -%}

            


            {%- if b.type == 'variant_accordion_item' -%}
  {%- assign _heading = b.settings.heading | default: 'Description de la variante' -%}

  <details class="mp-accordion" {% if b.settings.open_by_default %}open{% endif %} id="acc-{{ section.id }}-{{ b.id }}">
    <summary class="mp-accordion__summary" style="color: {{ b.settings.heading_color }};">{{ _heading }}</summary>
    <div class="mp-accordion__content">
      <div class="mp-accordion__inner" style="color: {{ b.settings.text_color }};">
        <div class="vdesc-target" data-vdesc="{{ b.settings.v_ns }}.{{ b.settings.v_key }}"></div>
      </div>
    </div>
  </details>
{%- endif -%}


{%- if b.type == 'p_desc' -%}
  {%- assign _heading = b.settings.heading | default: 'Description' -%}
  <details class="mp-accordion" {% if b.settings.open_by_default %}open{% endif %}>
    <summary class="mp-accordion__summary" style="color: {{ b.settings.heading_color }};">{{ _heading }}</summary>
    <div class="mp-accordion__content">
      <div class="mp-accordion__inner" style="color: {{ b.settings.text_color }};">
        {{ product.description }}
      </div>
    </div>
  </details>
{%- endif -%}




            {%- if b.type == 'v_pictos' -%}
              {%- assign _heading = b.settings.heading | default: 'Pictogrammes' -%}
              {%- assign _norm = _heading | strip | downcase
                | replace: ' ', '-' | replace: ',', '' | replace: '.', ''
                | replace: '"', ''  | replace: "'", '' | replace: "’", ''
                | replace: '&', 'et'
                | replace: 'é', 'e' | replace: 'è', 'e' | replace: 'ê', 'e' | replace: 'ë', 'e'
                | replace: 'à', 'a' | replace: 'â', 'a' | replace: 'ä', 'a'
                | replace: 'î', 'i' | replace: 'ï', 'i'
                | replace: 'ô', 'o' | replace: 'ö', 'o'
                | replace: 'û', 'u' | replace: 'ü', 'u'
                | replace: 'ç', 'c'
              -%}
              {%- assign _needle = _sep | append: _norm | append: _sep -%}
              {%- unless _cc_titles contains _needle -%}
                <details class="mp-accordion" {% if b.settings.open_by_default %}open{% endif %} id="acc-{{ section.id }}-{{ b.id }}">
                  <summary class="mp-accordion__summary" style="color: {{ b.settings.heading_color }};">{{ _heading }}</summary>
                  <div class="mp-accordion__content">
                    <div class="mp-accordion__inner" style="color: {{ b.settings.text_color }}; --picto-scale: {{ b.settings.picto_scale | default: 1 }};">
                      <div class="vdesc-target" data-vdesc="{{ b.settings.v_ns }}.{{ b.settings.v_key }}"></div>
                    </div>
                  </div>
                </details>
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

{%- comment -%} ====== MAP HTML VARIANTE — ACCORDEON VARIANTE (description) ====== {%- endcomment -%}
{%- for b in section.blocks -%}
  {%- if b.type == 'variant_accordion_item' -%}
    <script
      type="application/json"
      id="vmap-{{ section.id }}-va{{ forloop.index0 }}"
      data-ns="{{ b.settings.v_ns }}"
      data-key="{{ b.settings.v_key }}"
    >{
      {%- for v in product.variants -%}
        {%- assign mref = v.metafields[b.settings.v_ns][b.settings.v_key] -%}
        {%- capture __html -%}
          {%- if mref != blank -%}
            <div class="variant-acc">
              {{ mref | metafield_tag }}
            </div>
          {%- endif -%}
        {%- endcapture -%}
        "{{ v.id }}": {{ __html | strip | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }</script>
  {%- endif -%}
{%- endfor -%}












{%- comment -%} ====== MAP HTML VARIANTE — SENTEUR ====== {%- endcomment -%}
{%- assign __seen_pairs = '' -%}
{%- for b in section.blocks -%}
  {%- if b.type == 'v_scent' -%}
    {%- assign pair = b.settings.v_ns | append: '.' | append: b.settings.v_key -%}
    {%- unless __seen_pairs contains pair -%}
      <script
        type="application/json"
        id="vmap-{{ section.id }}-{{ forloop.index0 }}"
        data-ns="{{ b.settings.v_ns }}"
        data-key="{{ b.settings.v_key }}"
      >{
        {%- assign _order = b.settings.order_handles | default: 'nom, description, caracteristiques_techniques, univers_ambiance, bienfaits, mots_cles, fiche_technique' -%}
        {%- assign _fields = _order | split: ',' -%}
        {%- assign _exclude = b.settings.exclude_handles | default: 'pictogramme' | downcase | split: ',' -%}
        {%- for v in product.variants -%}
          {%- assign mref = v.metafields[b.settings.v_ns][b.settings.v_key] -%}
          {%- capture __html -%}
            {%- if mref and mref.value -%}
              <div class="scent-details">
                {%- assign any_printed = 0 -%}
                {%- for raw in _fields -%}
                  {%- assign h = raw | strip -%}
                  {%- if h != '' -%}
                    {%- assign key = h | downcase -%}
                    {%- unless _exclude contains key -%}
                      {%- capture vals -%}
                        {%- if mref.type contains 'list.' -%}
                          {%- assign sep = '' -%}
                          {%- for entry in mref.value -%}
                            {%- assign val = blank -%}
                            {%- case key -%}
                              {%- when 'nom' -%}{%- assign val = entry.nom -%}
                              {%- when 'description' -%}{%- assign val = entry.description | metafield_tag -%}
                              {%- when 'caracteristiques_techniques' -%}{%- assign val = entry.caracteristiques_techniques | metafield_tag -%}
                              {%- when 'univers_ambiance' -%}{%- assign val = entry.univers_ambiance | metafield_tag -%}
                              {%- when 'bienfaits' -%}{%- assign val = entry.bienfaits | metafield_tag -%}
                              {%- when 'mots_cles' -%}{%- assign val = entry.mots_cles -%}
                              {%- when 'fiche_technique' -%}
                                {%- assign f = entry.fiche_technique -%}
                                {%- assign url = '' -%}
                                {%- if f and f.url -%}{%- assign url = f.url -%}{%- elsif f -%}{%- assign url = f -%}{%- endif -%}
                                {%- if url != '' -%}{%- assign val = '<a href="' | append: url | append: '" target="_blank" rel="noopener">Cliquez ici pour voir la fiche technique</a>' -%}{%- endif -%}
                              {%- else -%}{%- assign val = blank -%}
                            {%- endcase -%}
                            {%- if val != blank -%}{{ sep }}{{ val }}{%- assign sep = '<br>' -%}{%- endif -%}
                          {%- endfor -%}
                        {%- else -%}
                          {%- assign entry = mref.value -%}
                          {%- assign val = blank -%}
                          {%- case key -%}
                            {%- when 'nom' -%}{%- assign val = entry.nom -%}
                            {%- when 'description' -%}{%- assign val = entry.description | metafield_tag -%}
                            {%- when 'caracteristiques_techniques' -%}{%- assign val = entry.caracteristiques_techniques | metafield_tag -%}
                            {%- when 'univers_ambiance' -%}{%- assign val = entry.univers_ambiance | metafield_tag -%}
                            {%- when 'bienfaits' -%}{%- assign val = entry.bienfaits | metafield_tag -%}
                            {%- when 'mots_cles' -%}{%- assign val = entry.mots_cles -%}
                            {%- when 'fiche_technique' -%}
                              {%- assign f = entry.fiche_technique -%}
                              {%- assign url = '' -%}
                              {%- if f and f.url -%}{%- assign url = f.url -%}{%- elsif f -%}{%- assign url = f -%}{%- endif -%}
                              {%- if url != '' -%}{%- assign val = '<a href="' | append: url | append: '" target="_blank" rel="noopener">Cliquer ici pour voir la fiche technique</a>' -%}{%- endif -%}
                            {%- else -%}{%- assign val = blank -%}
                          {%- endcase -%}
                          {{ val }}
                        {%- endif -%}
                      {%- endcapture -%}
                      {%- assign vals_str = vals | strip -%}
                      {%- if vals_str != '' or b.settings.show_empty -%}
                        {%- comment -%} Remap du label affiché {%- endcomment -%}
                        {%- assign label_out = h | replace:'_',' ' | capitalize -%}
                        {%- if key == 'caracteristiques_techniques' -%}
                          {%- assign label_out = 'Pyramide olfactive' -%}
                        {%- endif -%}
                        <div class="scent-item
  {% if key == 'caracteristiques_techniques' %} scent-item--pyramide{% endif %}
  {% if key == 'nom' %} scent-item--name{% endif %}
">
  <div class="scent-label">{{ label_out }}</div>
  <div class="scent-value">{% if vals_str == '' %}<span class="muted">—</span>{% else %}{{ vals_str }}{% endif %}</div>
</div>
                        {%- assign any_printed = any_printed | plus: 1 -%}
                      {%- endif -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- comment -%}Si rien d’affichable, ne rien rendre (permet de masquer l’accordéon côté JS){%- endcomment -%}
                {%- if any_printed == 0 -%}{%- endif -%}
              </div>
            {%- endif -%}
          {%- endcapture -%}
          "{{ v.id }}": {{ __html | strip | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }</script>
      {%- assign __seen_pairs = __seen_pairs | append: pair | append: '|' -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
        {%- comment -%} ====== MAP HTML VARIANTE — PICTOGRAMMES ====== {%- endcomment -%}
        {%- for b in section.blocks -%}
          {%- if b.type == 'v_pictos' -%}
            {%- assign pair = b.settings.v_ns | append: '.' | append: b.settings.v_key -%}
            <script
              type="application/json"
              id="vmap-{{ section.id }}-p{{ forloop.index0 }}"
              data-ns="{{ b.settings.v_ns }}"
              data-key="{{ b.settings.v_key }}"
            >{
              {%- for v in product.variants -%}
                {%- assign mref = v.metafields[b.settings.v_ns][b.settings.v_key] -%}
                {%- capture __html -%}
                  {%- if mref and mref.value -%}
                    <div class="pictos">
                      {%- if mref.type contains 'list.' -%}
                        {%- for entry in mref.value -%}
                          {%- assign im = entry.pictogrammes -%}
                          {%- assign picto_url = '' -%}
                          {%- if im -%}
                            {%- assign picto_url = im | image_url: width: 2048 -%}
                            {%- if picto_url == '' and im.url -%}{%- assign picto_url = im.url -%}{%- endif -%}
                            {%- if picto_url == '' -%}{%- assign picto_url = im | file_url -%}{%- endif -%}
                          {%- endif -%}
                          {%- if picto_url != '' -%}
                            <img class="pictos__img" src="{{ picto_url }}" alt="{{ im.alt | escape }}" loading="lazy">
                          {%- endif -%}
                        {%- endfor -%}
                      {%- else -%}
                        {%- assign entry = mref.value -%}
                        {%- assign im = entry.pictogrammes -%}
                        {%- assign picto_url = '' -%}
                        {%- if im -%}
                          {%- assign picto_url = im | image_url: width: 2048 -%}
                          {%- if picto_url == '' and im.url -%}{%- assign picto_url = im.url -%}{%- endif -%}
                          {%- if picto_url == '' -%}{%- assign picto_url = im | file_url -%}{%- endif -%}
                        {%- endif -%}
                        {%- if picto_url != '' -%}
                          <img class="pictos__img" src="{{ picto_url }}" alt="{{ im.alt | escape }}" loading="lazy">
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endcapture -%}
                "{{ v.id }}": {{ __html | strip | json }}{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            }</script>
          {%- endif -%}
        {%- endfor -%}
<!-- Start of Judge.me code --><div style='clear:both'></div><div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}' data-auto-install='false'>{{ product.metafields.judgeme.widget }}</div><!-- End of Judge.me code -->
      </div> <!-- /product-info-wrapper -->
    </div>   <!-- /product-box -->
  </div>     <!-- /main-product-container -->
  {% if section.settings.enable_stickyProduct %}
    {% render 'sticky-product', product: product, section: section, current_variant: current_variant %}
  {% endif %}
</div>
<style>
  #shopify-section-{{ section.id }}{
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
    --mp-arrow-size: {{ section.settings.arrow_size | default: 42 }}px;
    --mp-arrow-radius: {{ section.settings.arrow_border_radius | default: 9999 }}px;
    --mp-arrow-bg: {{ section.settings.arrow_bg_color | default: '#333333' }};
    --mp-arrow-color: {{ section.settings.arrow_icon_color | default: '#ffffff' }};
    --mp-arrow-offset-desktop: {{ section.settings.arrow_offset_desktop | default: 12 }}px;
    --mp-arrow-offset-mobile: {{ section.settings.arrow_offset_mobile | default: 10 }}px;
    --swatch-gap: {{ section.settings.swatch_gap | default: 14 }}px;
    --swatch-minw: {{ section.settings.swatch_min_width | default: 140 }}px;
    --swatch-radius: {{ section.settings.swatch_radius | default: 12 }}px;
    --swatch-bg: {{ section.settings.swatch_bg | default: '#ffffff' }};
    --swatch-b: {{ section.settings.swatch_border | default: '#CFCFCF' }};
    --swatch-color: {{ section.settings.swatch_color | default: '#1b1b1b' }};
    --swatch-bg-active: {{ section.settings.swatch_bg_active | default: '#111111' }};
    --swatch-b-active: {{ section.settings.swatch_border_active | default: '#111111' }};
    --swatch-color-active: {{ section.settings.swatch_color_active | default: '#ffffff' }};
    --pi-heading-color: {{ section.settings.product_info_heading_color | default: '#111111' }};
    --swatch-h: 44px;
    --thumbs-w: 0px;
  }
  @media only screen and (max-width:767px){
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }
  }
  .mp-media-config img,
  .mp-media-config video,
  .mp-media-config model-viewer,
  .mp-media-config .media img,
  .mp-media-config .product__media,
  .mp-media-config .product-media,
  .mp-media-config .product__media-item,
  .mp-media-config .media{
    border-radius: var(--mp-media-br) !important;
    object-fit: var(--mp-media-fit);
    width: 100%;
  }
  .media-gallery-card.mp-media-config{ position: relative; overflow: visible; }
  @media (min-width: 750px){
    .mp-media-config .media img{ height: var(--mp-media-height-d) !important; }
    .mp-media-config.pos-d-left  img, .mp-media-config.pos-d-left  video{ object-position: left center; }
    .mp-media-config.pos-d-center img, .mp-media-config.pos-d-center video{ object-position: center center; }
    .mp-media-config.pos-d-right img, .mp-media-config.pos-d-right video{ object-position: right center; }
  }
  @media (max-width: 749px){
    .mp-media-config .media img{ height: var(--mp-media-height-m) !important; }
    .mp-media-config.pos-m-left  img, .mp-media-config.pos-m-left  video{ object-position: left center; }
    .mp-media-config.pos-m-center img, .mp-media-config.pos-m-center video{ object-position: center center; }
    .mp-media-config.pos-m-right img, .mp-media-config.pos-m-right  video{ object-position: right center; }
  }
  {% if section.settings.hide_native_gallery_arrows %}
    #shopify-section-{{ section.id }} .swiper-button-prev,
    #shopify-section-{{ section.id }} .swiper-button-next,
    #shopify-section-{{ section.id }} .splide__arrow,
    #shopify-section-{{ section.id }} .flickity-button,
    #shopify-section-{{ section.id }} .glider-prev,
    #shopify-section-{{ section.id }} .glider-next,
    #shopify-section-{{ section.id }} .slider-button--prev,
    #shopify-section-{{ section.id }} .slider-button--next{ display:none !important; }
  {% endif %}
  .mp-media-arrow{
    position:absolute; top:50%; transform:translateY(-50%);
    z-index:9999; width:var(--mp-arrow-size); height:var(--mp-arrow-size);
    border-radius:var(--mp-arrow-radius);
    border:0; background:var(--mp-arrow-bg); color:var(--mp-arrow-color);
    font-size:calc(var(--mp-arrow-size) * .55); line-height:1;
    display:flex; align-items:center; justify-content:center; cursor:pointer;
    box-shadow:0 6px 16px rgba(0,0,0,.15);
  }
  {%- if section.settings.arrow_position == 'edge' or section.settings.arrow_position == blank -%}
    .mp-media-prev{ left:var(--mp-arrow-offset-desktop); }
    .mp-media-next{ right:var(--mp-arrow-offset-desktop); }
    @media (max-width:749px){
      .mp-media-prev{ left:var(--mp-arrow-offset-mobile); }
      .mp-media-next{ right:var(--mp-arrow-offset-mobile); }
    }
  {%- elsif section.settings.arrow_position == 'inside' -%}
    .mp-media-prev{ left:calc(var(--mp-arrow-offset-desktop) + 8px); }
    .mp-media-next{ right:calc(var(--mp-arrow-offset-desktop) + 8px); }
    @media (max-width:749px){
      .mp-media-prev{ left:calc(var(--mp-arrow-offset-mobile) + 6px); }
      .mp-media-next{ right:calc(var(--mp-arrow-offset-mobile) + 6px); }
    }
  {%- elsif section.settings.arrow_position == 'outside' -%}
    .mp-media-prev{ left:calc(var(--mp-arrow-offset-desktop) * -1); }
    .mp-media-next{ right:calc(var(--mp-arrow-offset-desktop) * -1); }
    @media (max-width:749px){
      .mp-media-prev{ left:calc(var(--mp-arrow-offset-mobile) * -1); }
      .mp-media-next{ right:calc(var(--mp-arrow-offset-mobile) * -1); }
    }
  {%- endif %}
