<div class="customer reset-password section-space color-scheme-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="reset-password-card">
      <div class="section-header text-align-center">
        <h1 class="h4">
          {{ 'customer.reset_password.title' | t }}
        </h1>
        <p class="text-size-large">
          {{ 'customer.reset_password.subtext' | t }}
        </p>
      </div>
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <h2 class="form-message error" tabindex="-1" autofocus>
            <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
            <svg aria-hidden="true" focusable="false">
              <use href="#icon-error" />
            </svg>
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#{{ field }}">
                    {{ form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="form-fieldset">
          <div class="form-flex-item">
            <label for="password" class="hidden">
              {{ 'customer.reset_password.password' | t }}
            </label>
            <input
              type="password"
              class="form-control-input"
              name="customer[password]"
              id="password"
              autocomplete="new-password"
              {% if form.errors contains 'password' %}
                aria-invalid="true"
                aria-describedby="password-error"
              {% endif %}
              placeholder="{{ 'customer.reset_password.password' | t }}"
            >
            {%- if form.errors contains 'password' -%}
              <small id="password-error" class="form__message">
                <svg aria-hidden="true" focusable="false">
                  <use href="#icon-error" />
                </svg>
                {{ form.errors.translated_fields.password | capitalize }}
                {{ form.errors.messages.password }}
              </small>
            {%- endif -%}
          </div>
        </div>

        <div class="form-fieldset">
          <div class="form-flex-item">
            <label for="password_confirmation" class="hidden">
              {{ 'customer.reset_password.password_confirm' | t }}
            </label>
            <input
              type="password"
              class="form-control-input"
              name="customer[password_confirmation]"
              id="password_confirmation"
              autocomplete="new-password"
              {% if form.errors contains 'password_confirmation' %}
                aria-invalid="true"
                aria-describedby="password_confirmation-error"
              {% endif %}
              placeholder="{{ 'customer.reset_password.password_confirm' | t }}"
            >
            {%- if form.errors contains 'password_confirmation' -%}
              <small id="password_confirmation-error" class="form__message">
                <svg aria-hidden="true" focusable="false">
                  <use href="#icon-error" />
                </svg>
                {{ form.errors.translated_fields.password_confirmation | capitalize }}
                {{ form.errors.messages.password_confirmation }}
              </small>
            {%- endif -%}
          </div>
        </div>

        <button type="button" class="button button-medium button-full button-reset-password">
          {{ 'customer.reset_password.submit' | t }}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
 {
  "name": "t:sections.main_reset_password.name",
  "tag": "section",
  "class": "section",
  "settings":[
     {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
        "label": "t:global.color_scheme.label"
    }
  ]
}
{% endschema %}
