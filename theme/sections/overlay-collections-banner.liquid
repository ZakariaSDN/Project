{{ 'overlay-collections-banner.css' | asset_url | stylesheet_tag }}

<style>
  /* ==== Variables de section (desktop spacing) ==== */
  #shopify-section-{{ section.id }} {
    --section-top-space: {{ section.settings.top_space_desktop }}px;
    --section-bottom-space: {{ section.settings.bottom_space_desktop }}px;
    --grid-size: {{ section.blocks.size }};
    --column-per-row: {{ section.blocks.size }};
  }

  #shopify-section-{{ section.id }} .overlay-banner-item,
  #shopify-section-{{ section.id }} .overlay-banner-item .overlay-banner-card,
  #shopify-section-{{ section.id }} .overlay-banner-hover-content,
  #shopify-section-{{ section.id }} .overlay-banner-hover-content-inner,
  #shopify-section-{{ section.id }} .overlay-banner-collection-list,
  #shopify-section-{{ section.id }} .overlay-heading-wrapper {
    width: 100%;
    box-sizing: border-box;
  }

  /* 5) S’assurer que l’image couvre son bloc sans débordement */
  #shopify-section-{{ section.id }} .overlay-banner-item .media-wrapper img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
</style>

{%- comment -%}
  === Overlay appliqué UNIQUEMENT sur l’image ===
{%- endcomment -%}
<style>
  /* Variables overlay (section) + variables de bordure mobile */
  #shopify-section-{{ section.id }}{
    --overlay-color: {{ section.settings.overlay_color | default: '#000000' }};
    --overlay-opacity: {{ section.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};
    --m-card-border-width: {{ section.settings.mobile_card_border_width | default: 0 }}px;
    --m-card-border-color: {{ section.settings.mobile_card_border_color | default: '#000000' }};
  }

  /* Overlay sur chaque image */
  #shopify-section-{{ section.id }} .overlay-banner-bg .media-wrapper{
    position: relative;
  }
  #shopify-section-{{ section.id }} .overlay-banner-bg .media-wrapper::after{
    content:"";
    position:absolute;
    inset:0;
    background: var(--overlay-color);
    opacity: var(--overlay-opacity);
    pointer-events:none; /* ne bloque pas le hover/clic sur les cartes */
  }

  /* Styles par bloc (Heading h3 + lien “a”) via variables CSS posées sur .overlay-banner-item */
  #shopify-section-{{ section.id }} .overlay-banner-item .overlay-banner-title{
    color: var(--block-h-color, inherit) !important;
    font-weight: var(--block-h-fw, inherit) !important;
    font-size: var(--block-h-fs-d, inherit) !important;
    line-height: 1.15;
  }
  #shopify-section-{{ section.id }} .overlay-banner-item .button-underline{
    color: var(--block-a-color, inherit) !important;
    font-weight: var(--block-a-fw, inherit) !important;
    font-size: var(--block-a-fs-d, inherit) !important;
    --underline-color: var(--block-a-color, currentColor);
  }

  @media (max-width:749px){
    #shopify-section-{{ section.id }} .overlay-banner-item .overlay-banner-title{
      font-size: var(--block-h-fs-m, inherit) !important;
    }
    #shopify-section-{{ section.id }} .overlay-banner-item .button-underline{
      font-size: var(--block-a-fs-m, inherit) !important;
    }
  }

  /* ===== Bordure mobile optionnelle sur .overlay-banner-card ===== */
  {% if section.settings.mobile_card_border_enable %}
  @media (max-width: 749px){
    #shopify-section-{{ section.id }} .overlay-banner-card{
      border: var(--m-card-border-width) solid var(--m-card-border-color);
      box-sizing: border-box;
    }
  }
  {% endif %}
</style>

<div class="section-space color-scheme-{{ section.settings.color_scheme }} overflow-hidden">
  <overlay-collection-banner class="overlay-banner-container overlay-banner-height-{{ section.settings.banner_height }} area-scrollbar">
    <div class="overlay-banner-bg-image">
      {% for block in section.blocks %}
        <div
          class="overlay-banner-bg{% if forloop.first %} active{% endif %}"
          data-index="{{ forloop.index }}"
          data-banner-image
        >
          <div class="media-wrapper">
            {%- liquid
              assign desktop_img = block.settings.image
              assign mobile_img  = block.settings.image_mobile
            -%}
            {%- if desktop_img or mobile_img -%}
              {%- comment -%} Image responsive : mobile prioritaire < 750px {%- endcomment -%}
              <picture>
                {%- if mobile_img -%}
                  {%- liquid
                    assign m_sizes  = '100vw'
                    assign m_widths = '375, 550, 750, 1100, 1500, 1780'
                  -%}
                  <source media="(max-width: 749px)"
                          sizes="{{ m_sizes }}"
                          srcset=" 
                            {{ mobile_img | image_url: width: 375  }} 375w,
                            {{ mobile_img | image_url: width: 550  }} 550w,
                            {{ mobile_img | image_url: width: 750  }} 750w,
                            {{ mobile_img | image_url: width: 1100 }} 1100w,
                            {{ mobile_img | image_url: width: 1500 }} 1500w,
                            {{ mobile_img | image_url: width: 1780 }} 1780w
                          ">
                {%- endif -%}
                {%- if desktop_img -%}
                  {%- liquid
                    assign d_height = desktop_img.width | divided_by: desktop_img.aspect_ratio | round
                  -%}
                  <img
                    loading="lazy"
                    sizes="100vw"
                    src="{{ desktop_img | image_url: width: 1500 }}"
                    srcset="
                      {{ desktop_img | image_url: width: 375  }} 375w,
                      {{ desktop_img | image_url: width: 550  }} 550w,
                      {{ desktop_img | image_url: width: 750  }} 750w,
                      {{ desktop_img | image_url: width: 1100 }} 1100w,
                      {{ desktop_img | image_url: width: 1500 }} 1500w,
                      {{ desktop_img | image_url: width: 1780 }} 1780w,
                      {{ desktop_img | image_url: width: 2000 }} 2000w,
                      {{ desktop_img | image_url: width: 3000 }} 3000w,
                      {{ desktop_img | image_url: width: 3840 }} 3840w
                    "
                    width="{{ desktop_img.width }}"
                    height="{{ d_height }}"
                    alt="{{ desktop_img.alt | escape }}"
                  >
                {%- else -%}
                  {%- liquid
                    assign m_height = mobile_img.width | divided_by: mobile_img.aspect_ratio | round
                  -%}
                  <img
                    loading="lazy"
                    sizes="100vw"
                    src="{{ mobile_img | image_url: width: 1100 }}"
                    srcset="
                      {{ mobile_img | image_url: width: 375  }} 375w,
                      {{ mobile_img | image_url: width: 550  }} 550w,
                      {{ mobile_img | image_url: width: 750  }} 750w,
                      {{ mobile_img | image_url: width: 1100 }} 1100w,
                      {{ mobile_img | image_url: width: 1500 }} 1500w
                    "
                    width="{{ mobile_img.width }}"
                    height="{{ m_height }}"
                    alt="{{ mobile_img.alt | escape }}"
                  >
                {%- endif -%}
              </picture>
            {%- else -%}
              {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
              {%- if placeholder_slide == 1 -%}
                {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- else -%}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      {% else %}
        <div class="overlay-banner-bg active" data-index="1">
          <div class="media-wrapper">
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="overlay-banner-grid">
      {% for block in section.blocks %}
        <div
          class="overlay-banner-item color-scheme-{{ block.settings.color_scheme }}"
          data-index="{{ forloop.index }}"
          data-banner-item
          {{ block.shopify_attributes }}
          style="
            --block-h-color: {{ block.settings.heading_color | default: 'inherit' }}; 
            --block-h-fw: {% if block.settings.heading_bold %}700{% else %}400{% endif %}; 
            --block-h-fs-d: {{ block.settings.heading_size_d | default: 28 }}px; 
            --block-h-fs-m: {{ block.settings.heading_size_m | default: 22 }}px; 
            --block-a-color: {{ block.settings.link_color | default: 'inherit' }}; 
            --block-a-fw: {% if block.settings.link_bold %}700{% else %}400{% endif %}; 
            --block-a-fs-d: {{ block.settings.link_size_d | default: 14 }}px; 
            --block-a-fs-m: {{ block.settings.link_size_m | default: 14 }}px;
          "
        >
          <div class="overlay-banner-card">
            <div class="overlay-banner-background"></div>
            <div class="overlay-banner-background-2"></div>
            <div class="overlay-banner-hover-content">
              <div class="overlay-banner-hover-content-inner">
                <ul class="list-style-none overlay-collection-list">
                  {% for blockCollection in block.settings.collection_list %}
                    <li class="overlay-collection-list-item">
                      <a href="{{ blockCollection.url }}">{{ blockCollection.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
                <div class="overlay-heading-wrapper">
                  <h3 class="overlay-banner-title h4">{{ block.settings.heading }}</h3>
                  {% if block.settings.link_text != blank and block.settings.link_url != blank %}
                    <a href="{{ block.settings.link_url }}" class="button-underline">{{ block.settings.link_text }}</a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </overlay-collection-banner>
</div>

<script>
class OverlayCollectionBanner extends HTMLElement {
  constructor() {
    super();
    this.items = this.querySelectorAll('[data-banner-item]');
    this.activeImage = this.querySelector(`.active[data-banner-image]`);
    this.initEvents();
  }

  initEvents() {
    this.items.forEach(function(item){
      item.addEventListener('mouseover',function(){
        const index = item.dataset.index;
        const currentImage = this.querySelector(`[data-banner-image][data-index="${index}"]`);
        if(currentImage){
          if(this.activeImage){
            this.activeImage.classList.remove('active')
          }
          currentImage.classList.add('active');
          this.activeImage = currentImage;
        }
      }.bind(this))
    }.bind(this))
  }

}
customElements.define('overlay-collection-banner', OverlayCollectionBanner);
</script>

{% schema %}
{
  "name": "t:sections.overlay_collection_banner.name",
  "tag": "section",
  "max_blocks": 4,
  "class":"section-overlay-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
        "label": "t:global.color_scheme.label"
    },
    {
      "type": "select",
      "id": "banner_height",
      "options": [
        { "value": "small", "label": "t:sections.overlay_collection_banner.settings.banner_height.options.small.label" },
        { "value": "medium", "label": "t:sections.overlay_collection_banner.settings.banner_height.options.medium.label" },
        { "value": "large", "label": "t:sections.overlay_collection_banner.settings.banner_height.options.large.label" },
        { "value": "fullscreen", "label": "t:sections.overlay_collection_banner.settings.banner_height.options.fullscreen.label" }
      ],
      "default": "medium",
      "label": "t:sections.overlay_collection_banner.settings.banner_height.label"
    },
    { "type": "header", "content": "t:global.section_spacing.label" },
    { "type": "number", "id": "top_space_desktop", "label": "t:global.section_spacing.top_space_desktop.label", "default": 80 },
    { "type": "number", "id": "bottom_space_desktop", "label": "t:global.section_spacing.bottom_space_desktop.label", "default": 80 },
    { "type": "number", "id": "top_space_mobile", "label": "t:global.section_spacing.top_space_mobile.label", "default": 40 },
    { "type": "number", "id": "bottom_space_mobile", "label": "t:global.section_spacing.bottom_space_mobile.label", "default": 40 },

    /* ==== Réglages overlay (desktop) ==== */
    { "type": "header", "content": "Overlay sur l’image de fond (desktop)" },
    { "type": "color",  "id": "overlay_color",   "label": "Couleur de l’overlay", "default": "#000000" },
    { "type": "number", "id": "overlay_opacity", "label": "Opacité (0–100)", "default": 17 },

    /* ==== Bordure mobile sur la carte ==== */
    { "type": "header", "content": "Mobile — Bordure de la carte" },
    { "type": "checkbox", "id": "mobile_card_border_enable", "label": "Afficher une bordure sur mobile", "default": false },
    { "type": "color", "id": "mobile_card_border_color", "label": "Couleur de la bordure (mobile)", "default": "#E5E5E5" },
    { "type": "range", "id": "mobile_card_border_width", "label": "Épaisseur de la bordure (px, mobile)", "min": 1, "max": 12, "step": 1, "unit": "px", "default": 1 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.overlay_collection_banner.blocks.name",
      "settings": [
        { "type": "color_scheme", "id": "color_scheme", "default": "primary", "label": "t:global.color_scheme.label" },
        { "type": "text", "id": "heading", "label": "t:global.general_labels.heading", "default":"Category heading here" },

        /* Image mobile optionnelle */
        { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile – optionnelle)" },

        { "type": "image_picker", "id": "image", "label": "t:global.general_labels.image" },
        { "type": "text", "id": "link_text", "label": "t:global.general_labels.text", "default":"Shop now" },
        { "type": "url",  "id": "link_url",  "label": "t:global.general_labels.link", "default":"/collections/all" },
        { "type": "collection_list", "id": "collection_list", "label": "t:global.general_labels.collections", "limit": 6 },

        /* Styles du bloc */
        { "type": "header", "content": "Styles du titre (h3)" },
        { "type": "color",  "id": "heading_color",  "label": "Couleur du titre", "default": "#FFFFFF" },
        { "type": "checkbox","id": "heading_bold",  "label": "Titre en gras", "default": true },
        { "type": "range",  "id": "heading_size_d", "label": "Taille titre desktop", "min": 12, "max": 72, "step": 1, "unit":"px", "default": 32 },
        { "type": "range",  "id": "heading_size_m", "label": "Taille titre mobile",  "min": 12, "max": 60, "step": 1, "unit":"px", "default": 24 },

        { "type": "header", "content": "Styles du lien (texte a)" },
        { "type": "color",  "id": "link_color",  "label": "Couleur du lien", "default": "#FFFFFF" },
        { "type": "checkbox","id": "link_bold",  "label": "Lien en gras", "default": false },
        { "type": "range",  "id": "link_size_d", "label": "Taille lien desktop", "min": 10, "max": 36, "step": 1, "unit":"px", "default": 14 },
        { "type": "range",  "id": "link_size_m", "label": "Taille lien mobile",  "min": 10, "max": 30, "step": 1, "unit":"px", "default": 14 }
      ]
    }
  ],
  "presets": [
    { "name":"t:sections.overlay_collection_banner.presets.name" }
  ]
}
{% endschema %}
