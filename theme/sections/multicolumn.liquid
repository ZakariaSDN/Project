{{ 'multicolumn.css' | asset_url | stylesheet_tag }}
<div class="section-space color-scheme-{{ section.settings.color_scheme }}">
  <div class="container">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <section-heading class="section-header text-align-{{ section.settings.content_alignment }}">
        {% if section.settings.heading != blank %}
          <h2 class="heading-main {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="rte">
            {{ section.settings.description | replace: '<p></p>', '<br>' }}
          </div>
        {% endif %}
      </section-heading>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <div class="multicolumn-wrapper">
        <div class="multicolumn-card{% if section.settings.show_icon_left %} horizontal-icon{% else %} vertical-icon{% endif %} {% if section.settings.column_background %} card-enabled{% endif %}">
          {% for block in section.blocks %}
            <div
              id="block-{{ block.id }}"
              class="multicolumn-card-item text-align-{{ section.settings.text_alignment }}  color-scheme-{{ block.settings.color_scheme }} p-relative"
              {{ block.shopify_attributes -}}
              {% if block.settings.background_image != blank %}
                style="--opacity-color:{{ block.settings.overlay_color.rgb }};--opacity:{{ block.settings.overlay_opacity }}%;"
              {% endif %}
            >
              {% if section.settings.column_background and block.settings.background_image != blank %}
                <div class="column-background-image">
                  {%- liquid
                    assign height = block.settings.background_image.width | divided_by: block.settings.background_image.aspect_ratio | round
                    assign sizes = '100vw'
                    assign widths = '150,200,375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                  -%}
                  {{
                    block.settings.background_image
                    | image_url: width: 3840
                    | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
                  }}
                </div>
              {% endif %}
              {% if block.settings.icon != blank %}
                <div class="multicolumn-card-icon multicolumn-icon-{{ section.settings.icon_size }} {% if section.settings.column_icon_background %} icon-background-enabled{% endif %}">
                  {{ block.settings.icon }}
                </div>
              {% endif %}
              {% capture content %}
                {% if block.settings.heading != blank  %}
                  <h4 class="multicolumn-heading {{ block.settings.heading_size }}">{{ block.settings.heading }}</h4>
                {%endif %}
                {% if block.settings.description != blank  %}
                <div class="multicolumn-text rte {{ block.settings.description_size }}">
                {{block.settings.description | replace:"<p></p>","<br>" }}
                </div>
              {% endif %}
              {% if block.settings.link_url and block.settings.link_label != blank %}
                <a href="{{ block.settings.link_url }}" class="multicolumn-text-button button button-{{ block.settings.btn_size }}">
                  <span class="button-text">{{ block.settings.link_label }}</span>
                </a>
              {% endif %}
             {% endcapture %}
              {% if content != blank %}
                <div class="multicolumn-card__info">
                  {{ content }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
    --multicolumn-per-row:{{ section.settings.column_range }};
    --gapcolumn: {{ section.settings.column_gap }}px;
    --gaprow: {{ section.settings.row_gap }}px;
  }

  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }

  }
</style>
