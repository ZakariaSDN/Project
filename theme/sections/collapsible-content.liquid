{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
    --grid-size:{{ section.blocks.size }};
  }

  {% if section.settings.background_image != blank %}
    #shopify-section-{{ section.id }} .section-background-image {
      position: absolute;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      z-index: 0;
    }

    #shopify-section-{{ section.id }} .section-background-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
     #shopify-section-{{ section.id }} .section-background-image:before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: rgb({{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity }}%);
    }
  {% endif %}
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }
  }
</style>
<div class="section-space color-scheme-{{ section.settings.color_scheme }} p-relative">
  {% if section.settings.background_image != blank %}
    <div class="section-background-image">
      {%- liquid
        assign height = section.settings.background_image.width | divided_by: section.settings.background_image.aspect_ratio | round
        assign sizes = '100vw'
        assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
      -%}
      {{
        section.settings.background_image
        | image_url: width: 3840
        | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
      }}
    </div>
  {% endif %}
  <div class="container">
    <div class="collapsiable-card separator media-position-{{ section.settings.image_position }}">
      {% capture image %}
      {% if section.settings.image != blank %}
        {% liquid
          assign media_aspect_ratio = section.settings.image_ratio
                if media_aspect_ratio == 'landscape'
                  assign imageratio = 75
                elsif media_aspect_ratio == 'square'
                  assign imageratio = 100
                elsif media_aspect_ratio == 'portrait'
                  assign imageratio = 125
                else
                  if section.settings.image != blank
                    assign imageratio = 1 | divided_by: section.settings.image.aspect_ratio | times: 100
                  else
                    assign imageratio = 100
                  endif
                endif
        %}
        <div class="collapsiable-item">
          <div class="collapsiable-item-img">
          <div class="media-wrapper" style="--media-ratio:{{ imageratio }}%">
            {%- assign widths = '100,165, 360, 535, 750, 1070, 1500' -%}
            {%- capture sizes -%}
              (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
            {%- endcapture -%}
            {{ section.settings.image | image_url: width: 1500 | image_tag: sizes: sizes, widths: widths }}
          </div>
          </div>
        </div>
      {% endif %}
      {% endcapture %}
      {% liquid
        if section.settings.image_position == 'left'
          echo image
        endif
      %}
      <div class="collapsiable-item">
        <div class="collapsiable-content-wrapper">
          {% if section.settings.heading != blank %}
            <h2 class="collapsiable-heading {{ section.settings.heading_size }} text-align-{{ section.settings.heading_alignment }}">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
          {% if section.blocks.size > 0 %}
            <collapsiable-text class="collapsiable-text">
              {% for block in section.blocks %}
                {% if block.settings.heading != blank %}
                  <accordion-element
                    class="collapsiable-details {% if section.settings.open_first and forloop.first %}active{% endif %}"
                    aria-expanded="false"
                  >
                    <div class="collapsiable-summary" detail-summary>
                      <span class="{{ section.settings.collapse_title }}">
                        {{ block.settings.heading -}}
                      </span>
                      <svg
                        class="icon-xsmall"
                        width="20"
                        height="12"
                        viewBox="0 0 20 12"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M1.05849 1.05752C1.57919 0.536817 2.42341 0.536817 2.94411 1.05752L10.0013 8.11471L17.0585 1.05752C17.5792 0.536817 18.4234 0.536817 18.9441 1.05752C19.4648 1.57822 19.4648 2.42244 18.9441 2.94314L10.9441 10.9431C10.4234 11.4638 9.57919 11.4638 9.05849 10.9431L1.05849 2.94314C0.537794 2.42244 0.537794 1.57822 1.05849 1.05752Z" fill="currentcolor"></path>
                      </svg>
                    </div>
                    <div
                      class="collapsiable-content rte {{ section.settings.description_size }}"
                      {% if section.settings.open_first and forloop.first %}
                        style="display:block"
                      {% else %}
                        style="display:none"
                      {% endif %}
                      detail-expand
                    >
                      {{ block.settings.description }}
                    </div>
                  </accordion-element>
                {% endif %}
              {% endfor %}
            </collapsiable-text>
          {% endif %}
        </div>
      </div>
      {% liquid
        if section.settings.image_position == 'right'
          echo image
        endif
      %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collapsible_content.name",
  "tag": "section",
  "max_blocks": 8,
  "class":"section-collapsiable-content",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
     {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
        "label": "t:global.color_scheme.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Heading here",
      "label": "t:global.general_labels.heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h4",
     "label": "t:global.heading_size.label",
      "options": [
        {
          "value": "h1",
          "label": "t:global.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.heading_size.options.h2.label"
        },
        {
          "value": "h3",
            "label": "t:global.heading_size.options.h3.label"
        },
        {
          "value": "h4",
         "label": "t:global.heading_size.options.h4.label"
        },
        {
          "value": "h5",
           "label": "t:global.heading_size.options.h5.label"
        },
       {
          "value": "h6",
          "label": "t:global.heading_size.options.h6.label"
        }
      ]
    },

    {
      "type": "select",
      "id": "heading_alignment",
      "default": "left",
       "label": "t:global.heading_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:global.heading_alignment.options.left.label"
        },
        {
          "value": "center",
          "label": "t:global.heading_alignment.options.center.label"
        },
        {
          "value": "right",
          "label": "t:global.heading_alignment.options.right.label"
        }
      ]
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "t:global.general_labels.image"
    },
     {
      "type": "select",
      "id": "image_ratio",
      "default": "square",
      "options": [
        {
          "value": "adapt",
          "label": "t:global.image_ratio.options.adapt.label"
        },
        {
          "value": "landscape",
          "label": "t:global.image_ratio.options.landscape.label"
        },
        {
          "value": "portrait",
          "label": "t:global.image_ratio.options.portrait.label"
        },
        {
          "value": "square",
          "label": "t:global.image_ratio.options.square.label"
        }
      ],
      "label": "t:global.image_ratio.label",
    },
    {
      "type": "select",
      "id": "image_position",
      "default": "left",
       "label": "t:global.image_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:global.image_position.options.left.label"
        },
        {
          "value": "right",
          "label": "t:global.image_position.options.right.label"
        }
      ]
    },
    {
      "type": "header",
       "content": "t:global.general_labels.content"
    },
    {
      "type":"checkbox",
      "id":"open_first",
      "label":"t:sections.collapsible_content.settings.open_first.label",
      "default":true
    },
    {
      "type": "select",
      "id": "collapse_title",
      "default": "h6",
      "label": "t:global.heading_size.label",
      "options": [
        {
          "value": "h4",
         "label": "t:global.heading_size.options.h4.label"
        },
        {
          "value": "h5",
           "label": "t:global.heading_size.options.h5.label"
        },
       {
          "value": "h6",
          "label": "t:global.heading_size.options.h6.label"
        }
      ]
    },

    {
        "type": "select",
        "id": "description_size",
        "default": "text-size-base",
        "label":"t:global.general_labels.description",
        "options": [
          {
            "value": "text-size-large",
            "label": "t:global.description_size.options.large.label"
          },
          {
            "value": "text-size-medium",
             "label": "t:global.description_size.options.medium.label"
          },
          {
            "value": "text-size-base",
           "label": "t:global.description_size.options.base.label"
          },
          {
            "value": "text-size-small",
            "label": "t:global.description_size.options.small.label"
          }
        ]
      },
     {
        "type": "image_picker",
        "id": "background_image",
        "label": "t:global.general_labels.background_image"
    },
    {
        "type": "color",
        "id": "overlay_color",
        "default": "#000000",
        "label": "t:global.general_labels.overlay"
    },
     {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:global.general_labels.overlay_opacity",
      "default": 50,
       "min": 0,
       "max": 100,
      "step": 1,
       "unit": "%"
    },
   {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "t:sections.collapsible_content.blocks.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:global.general_labels.heading",
          "default":"Heading here"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:global.general_labels.description",
          "default":"<p>Description here</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name":"t:sections.collapsible_content.presets.name",
      "blocks": [
        {
          "type": "content"
        },
        {
          "type": "content"
        },
        {
          "type": "content"
        },
        {
          "type": "content"
        },
        {
          "type": "content"
        }
      ]
    }
  ]
}
{% endschema %}
