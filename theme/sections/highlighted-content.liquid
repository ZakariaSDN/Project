{{ 'highlighted-content.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'highlighted-content.css' | asset_url | stylesheet_tag }}
<div class="section-space color-scheme-{{ section.settings.color_scheme }} overflow-visible">
  <div class="container">
    <div class="grid-wrapper-flex">
      <div class="grid-item-md-6">
        <div class="highlighted-heading-wrapper">
          {% if section.settings.heading != blank %}
            <h2 class="heading-main {{ section.settings.heading_size }}">
              {{- section.settings.heading -}}
            </h2>
          {% endif %}
          {% if section.settings.description != blank %}
            <p class="animated-description {{ section.settings.description_size }}">
              {{ section.settings.description | newline_to_br }}
            </p>
          {% endif %}
          {% if section.settings.btn_link != blank and section.settings.btn_text != blank %}
            <a
              href="{{ section.settings.btn_link }}"
              class="scrolling-content-button button button-{{ section.settings.btn_size }}"
            >
              <span class="button-text">{{ section.settings.btn_text }}</span>
            </a>
          {% endif %}
        </div>
      </div>
      {% if section.blocks.size > 0 %}
        <div class="grid-item-md-6">
          <div class="highlighted-content-card">
            {% for block in section.blocks %}
              <div
                class="highlighted-content-item {%if block.settings.enlarged_image %} image-large{% else %} image-rounded{% endif %} color-scheme-{{ block.settings.color_scheme }} image-alignment-{{ block.settings.image_alignment }}"
                {{ block.shopify_attributes }}
              >
                <div class="highlighted-img">
                  {% if block.settings.media_image != blank %}
                    {% assign image_url = block.settings.media_image %}
                    <img
                      srcset="
                        {%- if image_url.width >= 165 -%}{{ image_url | image_url: width: 165 }} 165w,{%- endif -%}
                        {%- if image_url.width >= 330 -%}{{ image_url | image_url: width: 330 }} 330w,{%- endif -%}
                        {%- if image_url.width >= 535 -%}{{ image_url | image_url: width: 535 }} 535w,{%- endif -%}
                        {%- if image_url.width >= 750 -%}{{ image_url | image_url: width: 750 }} 750w,{%- endif -%}
                        {%- if image_url.width >= 1000 -%}{{ image_url | image_url: width: 1000 }} 1000w,{%- endif -%}
                        {%- if image_url.width >= 1500 -%}{{ image_url | image_url: width: 1500 }} 1500w,{%- endif -%}
                        {%- if image_url.width >= 3000 -%}{{ image_url | image_url: width: 3000 }} 3000w,{%- endif -%}
                        {{ image_url | image_url }} {{ image_url.width }}w
                      "
                      src="{{ image_url | image_url: width: 1500 }}"
                      sizes="calc(100vw - 3rem)"
                      alt="{{ image_url.alt | escape }}"
                      height="{{ image_url.height }}"
                      width="{{ image_url.width }}"
                      loading="lazy"
                    >

                  {% else %}
                    {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
                    {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
                    {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
                <div class="highlighted-content">
                  {% if block.settings.heading != blank %}
                    <h6 class="highlighted-content-title">{{ block.settings.heading }}</h6>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="highlighted-content-desc">
                      {{ block.settings.description }}
                    </p>
                  {% endif %}
                  {% if section.settings.btn_link != blank and block.settings.btn_text != blank %}
                    <a href="{{ section.settings.btn_link }}" class="button ">
                      <span class="button-text">{{ block.settings.btn_text }}</span>
                    </a>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;

  }
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }

  }
</style>

