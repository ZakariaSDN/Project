{{ 'customer.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'customer.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
  }

  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }
  }
</style>

<div class="section-space color-scheme-{{ section.settings.color_scheme }} p-relative">
  {% if section.settings.bg_image != blank %}
    <div class="customer-background">
      {%- liquid
        assign height = section.settings.bg_image.width | divided_by: section.settings.bg_image.aspect_ratio | round
        assign sizes = '100vw'
        assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
      %}
      {{
        section.settings.bg_image
        | image_url: width: 3840
        | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
      }}
    </div>
  {% endif %}
  {% liquid
    assign columnWidth = 6
    if section.settings.content_position == 'top'
      assign columnWidth = 12
    endif
  %}
  <div class="container-full-width customer-container container content-position-{{ section.settings.content_position }}">
    <div class="grid-wrapper-flex items-align-center">
      <div class="grid-item-md-{{ columnWidth }} grid-item-l-{{ columnWidth }}">
        <div class="customer-account-box">
          <div class="customer-content-box text-align-center">
            {% if section.settings.subheading != blank %}
              <span class="text-size-large font-heading customer-subtitle">{{ section.settings.subheading }}</span>
            {% endif %}
            {% if section.settings.heading != blank %}
              <h3 class="customer-title {{ section.settings.heading_size }} font-body">
                {{ section.settings.heading }}
              </h3>
            {% endif %}
            <a href="{{ routes.account_register_url }}" class="button button-secondary">
              <span class="button-icon">
                <svg
                  class="icon icon-small"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path opacity="0.4" d="M13.6992 19.8984H20.0762" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12.8547 4.95561C13.5917 4.01661 14.7827 4.06561 15.7227 4.80261L17.1127 5.89261C18.0527 6.62961 18.3857 7.77261 17.6487 8.71361L9.35972 19.2886C9.08272 19.6426 8.65972 19.8516 8.20972 19.8566L5.01272 19.8976L4.28872 16.7826C4.18672 16.3456 4.28872 15.8856 4.56572 15.5306L12.8547 4.95561Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path opacity="0.4" d="M11.3022 6.93555L16.0962 10.6935" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="button-text">{{ 'customer.login_page.create_account' | t }}</span>
            </a>
          </div>
        </div>
      </div>
      <div class="grid-item-md-{{ columnWidth }} grid-item-l-{{ columnWidth }}">
        <div class="customer-form">
          <div class="customer-form-wrapper">
            <div class="customer-form-inner">
              <div class="customer-form-grid" id="reset-password">
                <h1 class="customer-heading h3 text-align-center">{{ 'customer.reset_password.submit' | t }}</h1>
                <div class="customer-form-grid">
                  {%- form 'recover_customer_password', class: 'account-form' -%}
                    {%- if form.errors -%}
                      <div id="recoverEmail-email-error" class="form-message error">
                        {{ form.errors.messages.form }}
                      </div>
                    {%- endif -%}
                    {% assign recover_success = form.posted_successfully? %}
                    <div class="form-fieldset">
                      <div class="form-flex-item">
                        <label for="RecoverEmail" class="hidden">{{ 'customer.login_page.email' | t }}</label>
                        <input
                          class="form-control-input"
                          type="email"
                          name="email"
                          id="RecoverEmail"
                          autocomplete="email"
                          autocapitalize="off"
                          {% if form.errors %}
                            aria-invalid="true"
                            aria-describedby="RecoverEmail-email-error"
                          {% endif %}
                          placeholder="{{ 'customer.login_page.email' | t }}"
                          pattern="^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)*[a-zA-Z]{2,}))$"
                          required
                        >
                      </div>
                    </div>
                    <button type="submit" class="button button-large button-full">
                      <span>{{ 'customer.login_page.submit' | t }}</span>
                    </button>
                    <div class="account-info-text customer-switch-box text-align-center">
                      <a href="#login" class="button-underline cancel" data-target-login>
                        {{- 'customer.login_page.cancel' | t -}}
                      </a>
                    </div>
                  {% endform %}
                </div>
              </div>
              <div class="customer-form-grid" id="login">
                <h1 class="customer-heading h3 text-align-center">{{ 'customer.log_in' | t }}</h1>

                <div class="customer-form-grid">
                  {%- form 'customer_login', novalidate: 'novalidate', class: 'account-form' -%}
                    {%- if recover_success == true -%}
                      <div id="success-message" class="form-message success">
                        {{ 'customer.recover_password.success' | t }}
                      </div>
                    {% endif %}
                    {%- if form.errors -%}
                      <div id="error-message" class="form-message error">
                        <div class="error_heading">
                          {{ form.errors | default_errors }}
                        </div>
                      </div>
                    {% endif %}
                    <div class="form-fieldset">
                      <div class="form-flex-item">
                        <label for="customeremail" class="hidden">{{ 'customer.login_page.email' | t }}</label>
                        <input
                          class="form-control-input"
                          type="email"
                          name="customer[email]"
                          id="customeremail"
                          autocomplete="email"
                          autocapitalize="off"
                          {% if form.errors contains 'form' %}
                            aria-invalid="true"
                          {% endif %}
                          placeholder="{{ 'customer.login_page.email' | t }}"
                          pattern="^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)*[a-zA-Z]{2,}))$"
                          required
                        >
                      </div>
                      <div class="form-flex-item">
                        <label for="customerpassword" class="hidden">{{ 'customer.login_page.password' | t }}</label>
                        <input
                          class="form-control-input"
                          type="password"
                          name="customer[password]"
                          id="customerpassword"
                          autocomplete="current-password"
                          autocapitalize="off"
                          {% if form.errors contains 'password' %}
                            aria-invalid="true"
                          {% endif %}
                          placeholder="{{ 'customer.login_page.password' | t }}"
                          required
                        >
                      </div>
                    </div>
                    <p>
                      <a href="#reset-password" class="button-underline" data-target-forgot>
                        {{- 'customer.login_page.forgot_password' | t -}}
                      </a>
                    </p>
                    <button type="submit" class="button button-large button-full">
                      <span>{{ 'customer.login_page.submit' | t }}</span>
                    </button>
                  {% endform %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  var url = window.location.href;
  let forgetPasswordElement = document.querySelector('[data-target-forgot]');
  let loginElement = document.querySelector('[data-target-login]');
  let loginSection = document.getElementById('login');
  var resetSection = document.getElementById('reset-password');
  if (url.indexOf('#reset-password') > -1) {
    loginSection.style.display = 'none';
    resetSection.style.display = 'block';
  } else {
    resetSection.style.display = 'none';
    loginSection.style.display = 'block';
  }
  forgetPasswordElement.addEventListener('click', function (event) {
    event.preventDefault();
    loginSection.style.display = 'none';
    resetSection.style.display = 'block';
    var url = window.location.pathname + '#recover';
    history.pushState({}, null, url);
  });
  loginElement.addEventListener('click', function (event) {
    event.preventDefault();
    resetSection.style.display = 'none';
    loginSection.style.display = 'block';
    var url = window.location.pathname;
    history.pushState({}, null, url);
  });
</script>
{% schema %}
{
  "name": "t:sections.main_login.name",
  "class":"section-customers customer-login",
  "tag": "section",
  "settings": [
      {
        "type":"image_picker",
        "id":"bg_image",
        "label":"t:global.general_labels.background_image"
      },
      {
        "type":"text",
        "id":"subheading",
        "label":"t:global.general_labels.subheading",
        "default":"Create Account"
      },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Register account",
       "label":"t:global.general_labels.heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
      "label": "t:global.heading_size.label",
      "options": [
          {
          "value": "h1",
          "label": "t:global.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.heading_size.options.h2.label"
        },
        {
          "value": "h3",
            "label": "t:global.heading_size.options.h3.label"
        },
        {
          "value": "h4",
         "label": "t:global.heading_size.options.h4.label"
        },
        {
          "value": "h5",
           "label": "t:global.heading_size.options.h5.label"
        },
       {
          "value": "h6",
          "label": "t:global.heading_size.options.h6.label"
        }
      ]
    },
    {
      "type":"select",
      "id":"content_position",
      "label":"t:global.content_position.label",
      "options":[
        {
          "value":"left",
          "label":"t:global.content_position.options.left.label"
        },
        {
          "value":"top",
          "label":"t:global.content_position.options.top.label"
        }
      ]
    },
     {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
        "label": "t:global.color_scheme.label"
    },
   {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }

  ]
}
{% endschema %}
