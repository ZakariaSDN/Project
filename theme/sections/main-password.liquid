<div class="password-section color-scheme-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="password-header">
      {%- if section.settings.logo != blank -%}
        {%- assign image_2x_size = section.settings.logo_width | times: 2 | at_most: 2560 -%}
        <img
          class="logo-img"
          srcset="{{ section.settings.logo | image_url: width: section.settings.logo_width }} 1x, {{ section.settings.logo | image_url: width: image_2x_size }} 2x"
          src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
          loading="lazy"
          width="{{ section.settings.logo_width }}"
          height="{{ section.settings.logo_width | divided_by : section.settings.logo.aspect_ratio | round }}"
          alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
        >

      {% else %}
        <span class="h4">{{ shop.name }}</span>
      {% endif %}
      <a href="#PasswordModal" class="button-underline">{{ 'general.password_page.login_password_button' | t }}</a>
    </div>
    <div class="password-body">
      <div class="password-content">
        {% if section.settings.subheading != blank %}
          <p class="password-text text-size-large rte">{{ section.settings.subheading | newline_to_br }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h3 class="password-title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h3>
        {% endif %}
        <div class="newsletter-password-form">
          {% form 'customer', id: 'password_form', class: 'newsletter-form pos-relative' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter--form">
              <div class="form-group">
                <label class="hidden" for="NewsletterForm--{{ section.id }}">{{ 'newsletter.label' | t }}</label>
                <input
                  id="NewsletterForm--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="form-control-input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="Newsletter-error--{{ section.id }}"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="Newsletter-success--{{ section.id }}"
                  {% endif %}
                  placeholder="{{ block.settings.placeholder_text | default: 'Enter your email' }}"
                  required
                >
              </div>
              {%- if form.errors -%}
                <div
                  id="Newsletter-error--{{ section.id }}"
                  class="form-message__wrapper form-message error"
                  tabindex="-1"
                >
                  <div class="error_text">
                    {{- form.errors.translated_fields.email | capitalize -}}
                    {{- form.errors.messages.email -}}
                  </div>
                </div>
              {%- endif -%}
              {%- if form.posted_successfully? -%}
                <div class="form-message__wrapper form-message success">
                  <div id="Newsletter-success--{{ section.id }}" class="form-message-inner" tabindex="-1">
                    {{- 'newsletter.success' | t -}}
                  </div>
                </div>
              {%- endif -%}
              <button
                type="submit"
                class="button button-medium button-full"
                name="commit"
                id="Subscribe"
                aria-label="{{ 'newsletter.button_label' | t }}"
              >
                {{ 'newsletter.button_label' | t }}
              </button>
            </div>
          {% endform %}
        </div>

        {%- if shop.password_message != blank -%}
          {{ shop.password_message }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<password-modal id="PasswordModal" class="password-modal">
  <Password-modal-overlay class="modal-overlay"></Password-modal-overlay>
  <div class="password-modal-inner">
    <a href="#" class="close-modal" aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M17.998 0.999967C18.2742 0.723825 18.7219 0.723825 18.998 0.999967C19.2742 1.27611 19.2742 1.72382 18.998 1.99997L1.99802 19C1.72188 19.2761 1.27417 19.2761 0.998024 19C0.721882 18.7238 0.721882 18.2761 0.998024 18L17.998 0.999967Z" fill="currentColor"/>
        <path d="M0.5 1.5C0.223858 1.22386 0.223858 0.776142 0.5 0.5C0.776142 0.223858 1.22386 0.223858 1.5 0.5L19.5 18.5C19.7761 18.7761 19.7761 19.2239 19.5 19.5C19.2239 19.7761 18.7761 19.7761 18.5 19.5L0.5 1.5Z" fill="currentColor"/>
      </svg>
    </a>

    {% if section.settings.popup_heading != blank %}
      <h4>{{ section.settings.popup_heading }}</h4>
    {% endif %}
    {% if section.settings.popup_subheading != blank %}
      <p>{{ section.settings.popup_subheading | newline_to_br }}</p>
    {% endif %}
    {%- form 'storefront_password', class: 'password-form' -%}
      <div class="form-group">
        <label class="hidden" for="{{ 'general.password_page.login_form_password_label' | t }}">
          {{- 'general.password_page.login_form_password_label' | t -}}
        </label>
        <input
          type="password"
          name="password"
          id="Password"
          class="form-control-input"
          autocomplete="current-password"
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="PasswordLoginForm-password-error"
          {%- endif -%}
          placeholder="{{- 'general.password_page.login_form_password_placeholder' | t -}}"
        >
      </div>

      {%- if form.errors -%}
        <div id="Newsletter-error--{{ section.id }}" class="form-message__wrapper error" tabindex="-1">
          <div class="error_text">
            {{ 'general.password_page.login_form_error' | t -}}
          </div>
        </div>
      {%- endif -%}
      <button name="commit" class="button medium-button button-full">
        {{ 'general.password_page.login_form_submit' | t }}
      </button>
    {%- endform -%}
    <div class="text-size-small">
      <span>{{ 'general.password_page.admin_link_html' | t -}}</span>
    </div>
  </div>
</password-modal>

{% schema %}
 {
  "name": "t:sections.main_password.name",
  "tag": "section",
  "class": "section",
  "disabled_on":{
    "groups":["header","footer"]
  },
  "settings":[
     {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
       "label": "t:global.color_scheme.label"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.main_password.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 100,
      "unit": "px",
       "label": "t:sections.main_password.settings.logo_width.label"
    },
     {
        "type": "header",
        "content": "t:global.general_labels.content"
    },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "t:global.general_labels.subheading",
          "default": "Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store."
        },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:global.general_labels.heading",
      "default": "Talk about your brand"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:global.heading_size.label",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "t:global.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.heading_size.options.h2.label"
        },
        {
          "value": "h3",
            "label": "t:global.heading_size.options.h3.label"
        },
        {
          "value": "h4",
         "label": "t:global.heading_size.options.h4.label"
        },
        {
          "value": "h5",
           "label": "t:global.heading_size.options.h5.label"
        },
       {
          "value": "h6",
          "label": "t:global.heading_size.options.h6.label"
        }
      ]
    },
     {
        "type": "header",
        "content": "t:sections.main_password.settings.password_popup.label"
    },
    {
      "type": "text",
      "id": "popup_heading",
     "label": "t:global.general_labels.heading",
      "default": "Enter Password"
    },
    {
      "type": "textarea",
      "id": "popup_subheading",
      "label": "t:global.general_labels.subheading"
    }
  ]
}
{% endschema %}
