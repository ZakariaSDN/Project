              "step": 1,
               "unit": "%"
            }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.media_grid.presets.name",
       "blocks": [
        {
          "type": "grid"
        },
         {
          "type": "grid"
        },
         {
          "type": "grid"
        },
        {
          "type": "grid"
        }
      ]
    }
  ]
}
