{{ 'product-bundle.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'product-bundle.css' | asset_url | stylesheet_tag }}
<div class="section-space color-scheme-{{ section.settings.color_scheme }}">
  <div class="product-bundle-container">
    {% if section.settings.heading != blank %}
      <div class="container">
        <section-heading class="section-header">
          <h2 class="heading-main {{  section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        </section-heading>
      </div>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <bundle-product-wrapper class="grid-wrapper-flex">
        <div class="grid-item-md-6">
          <div class="product-bundle-offers-img">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'collection' %}
                  {% liquid
                    assign collection = block.settings.collection
                    assign image_url = ''
                    if block.settings.image != blank
                      assign image_url = block.settings.image
                    elsif collection.featured_image
                      assign image_url = collection.featured_image
                    endif
                  %}
                  <div
                    data-id="block-{{ block.id }}"
                    class="media-wrapper bundle-image-wrapper {% if forloop.first %} active{% endif %}"
                  >
                    {% if image_url != blank %}
                      <img
                        srcset="
                          {%- if image_url.width >= 165 -%}{{ image_url | image_url: width: 165 }} 165w,{%- endif -%}
                          {%- if image_url.width >= 330 -%}{{ image_url | image_url: width: 330 }} 330w,{%- endif -%}
                          {%- if image_url.width >= 535 -%}{{ image_url | image_url: width: 535 }} 535w,{%- endif -%}
                          {%- if image_url.width >= 750 -%}{{ image_url | image_url: width: 750 }} 750w,{%- endif -%}
                          {%- if image_url.width >= 1000 -%}{{ image_url | image_url: width: 1000 }} 1000w,{%- endif -%}
                          {%- if image_url.width >= 1500 -%}{{ image_url | image_url: width: 1500 }} 1500w,{%- endif -%}
                          {%- if image_url.width >= 3000 -%}{{ image_url | image_url: width: 3000 }} 3000w,{%- endif -%}
                          {{ image_url | image_url }} {{ image_url.width }}w
                        "
                        src="{{ image_url | image_url: width: 1500 }}"
                        sizes="calc(100vw - 3rem)"
                        alt="{{ image_url.alt | escape }}"
                        height="{{ image_url.height }}"
                        width="{{ image_url.width }}"
                        loading="lazy"
                      >

                    {% else %}
                      {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
                      {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
                      {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </div>
                {% when 'products' %}
                  {% assign image_url = block.settings.image %}
                  <div
                    data-id="block-{{ block.id }}"
                    class="media-wrapperr bundle-image-wrapper {% if forloop.first %} active{% endif %}"
                  >
                    {% if image_url != blank %}
                      <img
                        srcset="
                          {%- if image_url.width >= 165 -%}{{ image_url | image_url: width: 165 }} 165w,{%- endif -%}
                          {%- if image_url.width >= 330 -%}{{ image_url | image_url: width: 330 }} 330w,{%- endif -%}
                          {%- if image_url.width >= 535 -%}{{ image_url | image_url: width: 535 }} 535w,{%- endif -%}
                          {%- if image_url.width >= 750 -%}{{ image_url | image_url: width: 750 }} 750w,{%- endif -%}
                          {%- if image_url.width >= 1000 -%}{{ image_url | image_url: width: 1000 }} 1000w,{%- endif -%}
                          {%- if image_url.width >= 1500 -%}{{ image_url | image_url: width: 1500 }} 1500w,{%- endif -%}
                          {%- if image_url.width >= 3000 -%}{{ image_url | image_url: width: 3000 }} 3000w,{%- endif -%}
                          {{ image_url | image_url }} {{ image_url.width }}w
                        "
                        src="{{ image_url | image_url: width: 1500 }}"
                        sizes="calc(100vw - 3rem)"
                        alt="{{ image_url.alt | escape }}"
                        height="{{ image_url.height }}"
                        width="{{ image_url.width }}"
                        loading="lazy"
                      >

                    {% else %}
                      {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
                      {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
                      {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </div>
              {% endcase %}
            {% endfor %}
            <div class="product-bundle-offers-list-wrapper">
              <ul class="list-style-none product-bundle-offers-list">
                {% for block in section.blocks %}
                  {% case block.type %}
                    {% when 'collection' %}
                      {% assign collection = block.settings.collection %}
                      <li
                        data-id="block-{{ block.id }}"
                        class="{% if forloop.first %} active{% endif %}"
                        data-content-head
                      >
                        <a href="" class="h3">
                          {% if block.settings.heading != blank -%}
                            {{- block.settings.heading -}}
                          {%- elsif collection != blank -%}
                            {{- collection.title -}}
                          {% else %}
                            {{ 'onboarding.collection_title' | t }}
                          {%- endif %}
                          <span>
                            <svg
                              class="icon-xsmall"
                              width="9"
                              height="14"
                              viewBox="0 0 9 14"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path d="M1 13L7 6.99999L1 1" stroke="currentcolor" stroke-width="2"></path>
                            </svg>
                          </span>
                        </a>
                      </li>
                    {% when 'products' %}
                      <li
                        data-id="block-{{ block.id }}"
                        class="{% if forloop.first %} active{% endif %}"
                        data-content-head
                      >
                        <a href="#" class="h3">
                          {% if block.settings.heading != blank -%}
                            {{- block.settings.heading -}}
                          {% else %}
                            Product list
                          {%- endif %}
                          <span>
                            <svg
                              class="icon-xsmall"
                              width="9"
                              height="14"
                              viewBox="0 0 9 14"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path d="M1 13L7 6.99999L1 1" stroke="currentcolor" stroke-width="2"></path>
                            </svg>
                          </span>
                        </a>
                      </li>
                  {% endcase %}
                {% endfor %}
              </ul>
            </div>
          </div>
        </div>

        <div class="grid-item-md-6">
          <div class="product-bundle-offers round-enabled text-align-center">
            {% for block in section.blocks %}
              {% assign check_avialible_item = false %}
              {% case block.type %}
                {% when 'collection' %}
                  <bundle-product
                    id="block-{{ block.id }}"
                    class="product-bundle-offers-inner {% if forloop.first %} active{% endif %}"
                    {{ block.shopify_attributes -}}
                    data-content-body
                  >
                    {% if block.settings.bundle_subheading != blank %}
                      <span class="text-size-xlarge product-bundle-subtitle">
                        {{- block.settings.bundle_subheading -}}
                      </span>
                    {% endif %}
                    {% if block.settings.bundle_heading != blank %}
                      <h3 class="product-bundle-title">{{ block.settings.bundle_heading }}</h3>
                    {% endif %}
                    <div class="product-bundle-grid">
                      <div class="grid-wrapper-flex">
                        {% if block.settings.collection != blank %}
                          {% assign current_price_total = 0.00 %}
                          {% for product in block.settings.collection.products limit: 3 %}
                            {% assign current_variant = product.selected_or_first_available_variant %}
                            {% if current_variant.available %}
                              {% assign check_avialible_item = true %}
                            {% endif %}
                            {% assign current_price = current_variant.price %}
                            {% assign current_price_total = current_price_total | plus: current_price %}
                            {% assign product_form_id = 'product-form-'
                              | append: section.id
                              | append: forloop.index
                              | append: '-'
                              | append: collection.handle
                            %}
                            {%- capture current -%}{% cycle section.id: 1, 2, 3, 4 %}{%- endcapture -%}
                            {%- assign placeholder_image = 'product-apparel-' | append: current -%}
                            {% render 'product-card-grid',
                              card_product: product,
                              class: 'product-bundle-item',
                              section: section,
                              product_form_id: product_form_id,
                              media_aspect_ratio: block.settings.image_size,
                              placeholder_image: placeholder_image
                            %}
                          {% endfor %}
                        {% else %}
                          {% assign limit = 3 %}
                          {% assign current_price_total = 0.00 %}
                          {%- for i in (1..limit) -%}
                            {% assign current_price = 1899 %}
                            {% assign current_price_total = current_price_total | plus: current_price %}
                            {%- capture current -%}{% cycle section.id: 1, 2, 3, 4 %}{%- endcapture -%}
                            {%- assign placeholder_image = 'product-apparel-' | append: current -%}
                            {% render 'product-card-grid',
                              class: 'product-bundle-item',
                              placeholder_image: placeholder_image
                            %}
                          {%- endfor -%}
                        {% endif %}
                      </div>
                    </div>
                    <div class="text-align-center">
                      <div class="product-form__error-message-wrapper" role="alert" hidden="">
                        <span class="product-form__error-message form-message error"></span>
                      </div>
                      <button
                        type="button"
                        class="button"
                        {% if block.settings.collection == blank or check_avialible_item == false %}
                          disabled
                        {% endif %}
                      >
                        <span class="button-text" data-addtocart-text>
                          {% if block.settings.collection == blank or check_avialible_item == false %}
                            Out of stock
                          {% else %}
                            ADD TO CART | {{ current_price_total | money -}}
                          {% endif %}
                        </span>
                        <span class="spinner-loading-btn btn-loader hidden">
                          <svg class="btn-loader-icon" viewBox="0 0 24 24">
                            <circle cx="4" cy="12" r="3" fill="currentColor">
                              <animate id="svg3DotsScale0" attributeName="r" begin="0;svg3DotsScale1.end-0.375s" dur="1.125s" values="3;.2;3"></animate>
                            </circle>
                            <circle cx="12" cy="12" r="3" fill="currentColor">
                              <animate attributeName="r" begin="svg3DotsScale0.end-0.9s" dur="1.125s" values="3;.2;3"></animate>
                            </circle>
                            <circle cx="20" cy="12" r="3" fill="currentColor">
                              <animate id="svg3DotsScale1" attributeName="r" begin="svg3DotsScale0.end-0.675s" dur="1.125s" values="3;.2;3"></animate>
                            </circle>
                          </svg>
                        </span>
                      </button>
                    </div>
                  </bundle-product>
                {% when 'products' %}
                  <bundle-product
                    id="block-{{ block.id }}"
                    class="product-bundle-offers-inner {% if forloop.first %} active{% endif %}"
                    {{ block.shopify_attributes }}
                    data-content-body
                  >
                    {% if block.settings.bundle_subheading != blank %}
                      <span class="text-size-xlarge product-bundle-subtitle">
                        {{- block.settings.bundle_subheading -}}
                      </span>
                    {% endif %}
                    {% if block.settings.bundle_heading != blank %}
                      <h3 class="product-bundle-title">{{ block.settings.bundle_heading }}</h3>
                    {% endif %}
                    <div class="product-bundle-grid">
                      <div class="grid-wrapper-flex">
                        {% if block.settings.product_list != blank %}
                          {% assign current_price_total = 0.00 %}
                          {% for product in block.settings.product_list %}
                            {% assign current_variant = product.selected_or_first_available_variant %}
                            {% if current_variant.available %}
                              {% assign check_avialible_item = true %}
                            {% endif %}
                            {% assign current_price = current_variant.price %}
                            {% assign current_price_total = current_price_total | plus: current_price %}
                            {% assign product_form_id = 'product-form-'
                              | append: section.id
                              | append: forloop.index
                              | append: '-'
                              | append: collection.handle
                            %}
                            {%- capture current -%}{% cycle section.id: 1, 2, 3, 4 %}{%- endcapture -%}
                            {%- assign placeholder_image = 'product-apparel-' | append: current -%}
                            {% render 'product-card-grid',
                              card_product: product,
                              class: 'product-bundle-item',
                              section: section,
                              product_form_id: product_form_id,
                              media_aspect_ratio: block.settings.image_size,
                              placeholder_image: placeholder_image
                            %}
                          {% endfor %}

                        {% else %}
                          {% assign limit = 3 %}
                          {% assign current_price_total = 0.00 %}
                          {%- for i in (1..limit) -%}
                            {% assign current_price = 1899 %}
                            {% assign current_price_total = current_price_total | plus: current_price %}
                            {%- capture current -%}{% cycle section.id: 1, 2, 3, 4 %}{%- endcapture -%}
                            {%- assign placeholder_image = 'product-apparel-' | append: current -%}
                            {% render 'product-card-grid',
                              section: section,
                              class: 'product-bundle-item',
                              placeholder_image: placeholder_image
                            %}
                          {%- endfor -%}
                        {% endif %}
                      </div>
                    </div>
                    <div class="text-align-center">
                      <div class="product-form__error-message-wrapper" role="alert" hidden="">
                        <span class="product-form__error-message form-message error"></span>
                      </div>
                      <button
                        type="button"
                        class="button"
                        {% if block.settings.product_list == blank or check_avialible_item == false %}
                          disabled
                        {% endif %}
                      >
                        <span class="button-text" data-addtocart-text
                          >ADD TO CART | {{ current_price_total | money -}}
                        </span>
                        <span class="spinner-loading-btn btn-loader hidden">
                          <svg class="btn-loader-icon" viewBox="0 0 24 24">
                            <circle cx="4" cy="12" r="3" fill="currentColor">
                              <animate id="svg3DotsScale0" attributeName="r" begin="0;svg3DotsScale1.end-0.375s" dur="1.125s" values="3;.2;3"></animate>
                            </circle>
                            <circle cx="12" cy="12" r="3" fill="currentColor">
                              <animate attributeName="r" begin="svg3DotsScale0.end-0.9s" dur="1.125s" values="3;.2;3"></animate>
                            </circle>
                            <circle cx="20" cy="12" r="3" fill="currentColor">
                              <animate id="svg3DotsScale1" attributeName="r" begin="svg3DotsScale0.end-0.675s" dur="1.125s" values="3;.2;3"></animate>
                            </circle>
                          </svg>
                        </span>
                      </button>
                    </div>
                  </bundle-product>
              {% endcase %}
            {% endfor %}
          </div>
        </div>
      </bundle-product-wrapper>
    {% endif %}
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
  }
  #shopify-section-{{ section.id }} .product-bundle-offers {
     --space-column: {{ section.settings.column_gap }}px;
  }
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }

  }
</style>
{% schema %}
{
  "name": "t:sections.product_bundle.name",
  "class": "section-product-bundle-offers",
  "tag": "section",
   "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
   {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Bundle products",
        "label":"t:global.general_labels.heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
       "label": "t:global.heading_size.label",
      "options": [
          {
            "value": "h1",
            "label": "t:global.heading_size.options.h1.label"
          },
          {
            "value": "h2",
            "label": "t:global.heading_size.options.h2.label"
          },
          {
            "value": "h3",
              "label": "t:global.heading_size.options.h3.label"
          },
          {
            "value": "h4",
           "label": "t:global.heading_size.options.h4.label"
          },
          {
            "value": "h5",
             "label": "t:global.heading_size.options.h5.label"
          },
         {
            "value": "h6",
            "label": "t:global.heading_size.options.h6.label"
          }
      ]
    },
       {
          "type": "range",
          "id":"column_gap",
          "label":"t:sections.product_bundle.settings.column_gap.label",
          "min":0,
          "max":50,
          "default":20,
          "step": 1,
          "unit": "px"
        },
    {
      "type":"header",
      "content": "t:global.general_labels.color"
    },
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
       "label": "t:global.color_scheme.label"
    },
     {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }

  ],
  "blocks": [
    {
      "type": "collection",
      "name":"t:sections.product_bundle.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id":"collection",
          "label":"t:global.general_labels.collection"
        },
        {
          "type": "select",
          "id": "image_size",
          "default": "square",
         "label": "t:global.grid_image_size.label",
          "options": [
            {
              "value": "adapt",
              "label": "t:global.grid_image_size.options.auto.label"
            },
            {
              "value": "landscape",
              "label": "t:global.grid_image_size.options.landscape.label"
            },
            {
              "value": "portrait",
              "label": "t:global.grid_image_size.options.portrait.label"
            },
            {
              "value": "square",
              "label": "t:global.grid_image_size.options.square.label"
            }
          ]

        },
        {
          "type": "text",
          "id":"heading",
         "label":"t:global.general_labels.heading"
        },
        {
          "type": "image_picker",
          "id":"image",
         "label":"t:global.general_labels.image"
        },
        {
          "type": "text",
          "id":"bundle_heading",
          "label":"t:sections.product_bundle.blocks.collection.settings.bundle_heading.label"
        },
        {
          "type": "text",
          "id":"bundle_subheading",
          "label":"t:sections.product_bundle.blocks.collection.settings.bundle_subheading.label"
        }
      ]
    },
    {
      "type": "products",
      "name":"t:sections.product_bundle.blocks.products.name",
      "settings": [

        {
          "type": "text",
          "id":"heading",
         "label":"t:global.general_labels.heading"
        },
        {
          "type": "image_picker",
          "id":"image",
          "label":"t:global.general_labels.image"
        },
        {
          "type": "product_list",
          "id":"product_list",
          "limit": 3,
          "label":"t:sections.product_bundle.blocks.products.settings.product_list.label"
        },
        {
          "type": "select",
          "id": "image_size",
          "default": "square",
         "label": "t:global.grid_image_size.label",
          "options": [
            {
              "value": "adapt",
              "label": "t:global.grid_image_size.options.auto.label"
            },
            {
              "value": "landscape",
              "label": "t:global.grid_image_size.options.landscape.label"
            },
            {
              "value": "portrait",
              "label": "t:global.grid_image_size.options.portrait.label"
            },
            {
              "value": "square",
              "label": "t:global.grid_image_size.options.square.label"
            }
          ]

        },
        {
          "type": "text",
          "id":"bundle_heading",
         "label":"t:sections.product_bundle.blocks.products.settings.bundle_heading.label"
        },
        {
          "type": "text",
          "id":"bundle_subheading",
        "label":"t:sections.product_bundle.blocks.products.settings.bundle_heading.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name":"t:sections.product_bundle.presets.name",
      "blocks": [
        {
          "type":"collection"
        },
        {
          "type":"products"
        }
      ]
    }
  ]
}
{% endschema %}
