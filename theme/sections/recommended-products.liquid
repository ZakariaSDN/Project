<div class="section-space color-scheme-{{ section.settings.color_scheme }}">
  {%- if request.page_type == 'product' -%}
    {%- assign product_id = product.id -%}
  {%- elsif request.page_type == 'cart' -%}
    {%- if cart.item_count > 0 -%}
      {%- assign product_id = cart.items[0].product_id -%}
    {%- else -%}
      {%- assign product_id = '' -%}
    {%- endif -%}
  {%- endif -%}
  <div class="container">
    <product-recommendations
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product_id }}&limit={{ section.settings.products_count }}&intent=related"
      product-recommendations
    >
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {% if section.settings.heading != blank %}
          <section-heading class="section-header">
            <h2 class="heading-main {{ section.settings.heading_size }}">
              {{- section.settings.heading -}}
            </h2>
          </section-heading>
        {% endif %}
        <div class="related-products-wrapper">
          <slider-main-component
            id="related-products-{{ section.id }}"
            class="related-viewed-slider product_card  swiper-container  swiper swiper-slider"
            data-settings='
                {
                "loop": true,
                "slidesPerView":2,
                "spaceBetween":"{{ section.settings.column_gap }}px",
                "navigation": {
                  "nextEl": ".swiper-button-next-{{ section.id }}",
                  "prevEl": ".swiper-button-prev-{{ section.id }}"
                },
                "breakpoints": {
                  "600": {
                    "slidesPerView":4
                  }
                },
                "scrollbar": {
                  "el": ".swiper-progressbar-{{ section.id }}",
                  "dragSize":"auto"
                }
              }
            '
          >
            <div class="swiper-wrapper">
              {%- for product in recommendations.products limit: section.settings.products_count -%}
                {% assign product_form_id = 'product-form-'
                  | append: section.id
                  | append: forloop.index
                  | append: '-'
                  | append: collection.handle
                %}
                {%- capture current -%}{% cycle section.id: 1, 2, 3, 4 %}{%- endcapture -%}
                {%- assign placeholder_image = 'product-apparel-' | append: current -%}
                {% render 'product-card',
                  card_product: product,
                  section: section,
                  slider: true,
                  product_form_id: product_form_id,
                  media_aspect_ratio: section.settings.image_size,
                  placeholder_image: placeholder_image
                %}
              {% endfor %}
            </div>
            <div class="swiper-pagination swiper-progressbar"></div>
            <div class="swiper-button-wrapper swiper-button-topright">
              <div class="swiper-button swiper-button-prev swiper-button-prev-{{ section.id }}"></div>
              <div class="swiper-button swiper-button-next swiper-button-next-{{ section.id }}"></div>
            </div>
          </slider-main-component>
        </div>
      {% endif %}
    </product-recommendations>
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
  }
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    --card-grid-gap: {{ section.settings.column_gap_mobile }}px;
    }

  }
</style>
{% schema %}
{
  "name": "t:sections.related_products.name",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
  {
    "type": "text",
    "id": "heading",
    "default": "Related products",
    "label":"t:global.general_labels.heading"
  },
  {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
      "label": "t:global.heading_size.label",
      "options": [
         {
          "value": "h1",
          "label": "t:global.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.heading_size.options.h2.label"
        },
        {
          "value": "h3",
            "label": "t:global.heading_size.options.h3.label"
        },
        {
          "value": "h4",
         "label": "t:global.heading_size.options.h4.label"
        },
        {
          "value": "h5",
           "label": "t:global.heading_size.options.h5.label"
        },
       {
          "value": "h6",
          "label": "t:global.heading_size.options.h6.label"
        }
      ]
    },
     {
      "type": "select",
      "id": "image_size",
      "default": "square",
      "label": "t:global.grid_image_size.label",
          "options": [
            {
              "value": "adapt",
              "label": "t:global.grid_image_size.options.auto.label"
            },
            {
              "value": "landscape",
              "label": "t:global.grid_image_size.options.landscape.label"
            },
            {
              "value": "portrait",
              "label": "t:global.grid_image_size.options.portrait.label"
            },
            {
              "value": "square",
              "label": "t:global.grid_image_size.options.square.label"
            }
          ]

    },
    {
      "type": "range",
      "id": "products_count",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "t:sections.related_products.settings.products_count.label",
      "default": 8
    },
    {
      "type": "range",
      "id":"column_gap",
       "label": "t:sections.related_products.settings.column_gap.label",
      "min":0,
      "max":50,
      "default":20,
      "step": 1,
      "unit": "px"
    },
      {
        "type": "range",
        "id":"column_gap_mobile",
        "label":"t:sections.related_products.settings.column_gap_mobile.label",
        "min":0,
        "max":50,
        "default":20,
        "step": 1,
        "unit": "px"
      },
     {
      "type": "header",
     "content": "t:global.general_labels.color"
    },
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
         "label": "t:global.color_scheme.label"
    },
     {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }
  ]
}
{% endschema %}
