{{ 'wide-media-content.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
    --grid-size:{{ section.blocks.size }};

  }
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }
</style>
<div class="section-space color-scheme-{{ section.settings.color_scheme }}">
  <div class="wide-media-wapper">
    {% if section.settings.heading != blank %}
      <div class="container">
        <section-heading class="section-header">
          <h2 class="heading-main {{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </h2>
        </section-heading>
      </div>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <wide-media-content class="wide-media-card media-height-{{ section.settings.media_height }}">
        {% for block in section.blocks %}
          <div
            class="wide-media-item{% if forloop.first %} active{% endif %}" tabindex="0"
            data-media-item
            {{ block.shopify_attributes }}
          >
            <div class="wide-media-image">
              <div class="media-wrapper">
                {%- if block.settings.image -%}
                  {%- liquid
                    assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
                    assign sizes = '100vw'
                    assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                  -%}
                  {{
                    block.settings.image
                    | image_url: width: 3840
                    | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
                  }}
                {% else %}
                  {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
                  {%- if placeholder_slide == 1 -%}
                    {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- else -%}
                    {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
            <div class="wide-media-content-overlay text-bottom-left">
              {% if block.settings.heading != blank %}
                <h2 class="wide-media-title h4">{{ block.settings.heading }}</h2>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="wide-media-desc">{{ block.settings.description | newline_to_br }}</p>
              {% endif %}
              {% if block.settings.button_text != blank and block.settings.button_url != blank %}
                <a href="{{ block.settings.button_url }}" class="button"
                  ><span class="button-text">{{ block.settings.button_text }}</span></a
                >
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </wide-media-content>
    {% endif %}
  </div>
</div>
