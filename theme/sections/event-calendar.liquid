{{ 'event-calendar.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'event-calendar.css' | asset_url | stylesheet_tag }}
<div class="section-space color-scheme-{{ section.settings.color_scheme }} overflow-visible">
  <div class="container">
    <div class="grid-wrapper-flex event-calendar-grid">
      {% capture content %}
          {% if section.settings.heading != blank or section.settings.description != blank %}
            <div class="event-calendar-heading-wrapper {% if section.settings.layout == 'right' %}sticky-content-right{% endif %}">
            {% if section.settings.heading != blank %}
              <h2 class="event-calendar-heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.description != blank %}
              <p class="event-calendar-desc {{ section.settings.description_size }}">
                {{ section.settings.description | newline_to_br }}
              </p>
            {% endif %}
            {% if section.settings.btn_link != blank and section.settings.btn_text != blank %}
              <a href="{{ section.settings.btn_link }}" class="button button-{{ section.settings.btn_size }}">
                <span class="button-text">{{ section.settings.btn_text }}</span>
              </a>
            {% endif %}
          </div>
          {% endif %}
      {% endcapture %}
      {% if content != blank and section.settings.layout == 'right' %}
        <div class="grid-item-md-5">
          {{ content }}
        </div>
      {% endif %}
      {% if section.settings.layout == 'right' %}
        {% assign countnum = 7 %}
      {% else %}
        {% assign countnum = 12 %}
      {% endif %}
      {% if section.blocks.size > 0 %}
        <div class="grid-item-md-{{ countnum }}">
          {% if content != blank and section.settings.layout != 'right' %}
            {{ content }}
          {% endif %}
          <div class="event-calendar-list">
            {% for block in section.blocks %}
              <div class="event-calendar-item">
                {% if block.settings.image != blank %}
                  {% liquid
                    if section.settings.image_size == 'landscape'
                      assign image_ratio = 75
                    elsif section.settings.image_size == 'square'
                      assign image_ratio = 100
                    elsif section.settings.image_size == 'portrait'
                      assign image_ratio = 125
                    else
                      assign image_ratio = 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | plus: 1
                    endif
                  %}
                  <event-calendar-image>
                    <div class="media-wrapper" style="--media-ratio:{{ image_ratio }}%">
                      {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                      {%- capture sizes -%}
                        (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                      {%- endcapture -%}
                      {{ block.settings.image | image_url: width: 1500 | image_tag: sizes: sizes, widths: widths }}
                    </div>
                  </event-calendar-image>
                {% endif %}
                <div class="event-calendar-content">
                  <div class="publish-action">
                    {% if block.settings.time != null %}
                      <span class="publish-item publish-time">
                        <svg
                          class="icon icon-xxsmall"
                          width="10"
                          height="10"
                          viewBox="0 0 10 10"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path d="M5.1197 9.69057C6.30607 9.69057 7.44385 9.21929 8.28274 8.3804C9.12163 7.54151 9.59291 6.40373 9.59291 5.21736C9.59291 4.03099 9.12163 2.89321 8.28274 2.05431C7.44385 1.21542 6.30607 0.744141 5.1197 0.744141C3.93333 0.744141 2.79555 1.21542 1.95666 2.05431C1.11777 2.89321 0.646484 4.03099 0.646484 5.21736C0.646484 6.40373 1.11777 7.54151 1.95666 8.3804C2.79555 9.21929 3.93333 9.69057 5.1197 9.69057ZM5.85331 5.98526C5.84326 6.02646 5.82555 6.06541 5.80112 6.10007L5.78173 6.1284C5.72855 6.20412 5.64911 6.25735 5.55885 6.27775C5.4686 6.29814 5.37398 6.28424 5.29341 6.23874L3.29314 5.11074C3.25209 5.08755 3.21634 5.05603 3.18818 5.01822C3.16002 4.9804 3.14007 4.93712 3.12962 4.89114C3.11916 4.84517 3.11842 4.79752 3.12745 4.75124C3.13648 4.70497 3.15508 4.66109 3.18205 4.62242C3.24056 4.53883 3.32809 4.48 3.42759 4.4574C3.52709 4.4348 3.63145 4.45004 3.72033 4.50015L5.1197 5.28967V2.90619C5.1197 2.80733 5.15897 2.71252 5.22888 2.64261C5.29879 2.5727 5.3936 2.53343 5.49247 2.53343C5.59133 2.53343 5.68615 2.5727 5.75605 2.64261C5.82596 2.71252 5.86523 2.80733 5.86523 2.90619V5.88834C5.86528 5.92106 5.86102 5.95365 5.85256 5.98526H5.85331Z" fill="currentcolor"></path>
                        </svg>
                        {{ block.settings.time }}
                      </span>
                    {% endif %}
                    {% if block.settings.date != null %}
                      <span class="publish-item publish-date">
                        <svg
                          class="icon icon-xxsmall"
                          width="9"
                          height="10"
                          viewBox="0 0 9 10"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path d="M4.47377 9.69057C1.9889 7.58369 0.746094 5.84361 0.746094 4.47182C0.746094 3.48318 1.13883 2.53503 1.83791 1.83595C2.53698 1.13688 3.48513 0.744141 4.47377 0.744141C5.46241 0.744141 6.41056 1.13688 7.10964 1.83595C7.80871 2.53503 8.20145 3.48318 8.20145 4.47182C8.20145 5.84361 6.95864 7.58369 4.47377 9.69057ZM4.47377 5.21736C4.6715 5.21736 4.86113 5.13881 5.00095 4.99899C5.14076 4.85918 5.21931 4.66955 5.21931 4.47182C5.21931 4.27409 5.14076 4.08446 5.00095 3.94465C4.86113 3.80483 4.6715 3.72628 4.47377 3.72628C4.27604 3.72628 4.08641 3.80483 3.9466 3.94465C3.80678 4.08446 3.72824 4.27409 3.72824 4.47182C3.72824 4.66955 3.80678 4.85918 3.9466 4.99899C4.08641 5.13881 4.27604 5.21736 4.47377 5.21736Z" fill="currentcolor"></path>
                        </svg>
                        {{ block.settings.date }}
                      </span>
                    {% endif %}
                  </div>
                  {% if block.settings.heading != blank %}
                    <h2 class="event-calendar-title h5">{{ block.settings.heading }}</h2>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <div class="event-cale-desc rte {{ block.settings.description_size }}">
                      {{ block.settings.description | replace: '<p></p>', '<br>' }}
                    </div>
                  {% endif %}
                  {% if block.settings.link_url != blank and block.settings.link_text != blank %}
                    <a href="{{ block.settings.link_url }}" class="button button-small">
                      <span class="button-text">{{ block.settings.link_text }}</span>
                    </a>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;

  }
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }

  }
</style>
{% schema %}
{
  "name": "t:sections.event_calendar.name",
  "class": "section-event-calendar",
  "tag": "section",
  "max_blocks": 4,
   "disabled_on": {
    "groups": ["header", "footer"]
    },
  "settings": [
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
        "label": "t:global.color_scheme.label"
    },
    {
      "type":"select",
      "id":"layout",
      "label": "t:sections.event_calendar.settings.layout.label",
      "options": [
        {
          "value": "right",
          "label":"t:sections.event_calendar.settings.layout.options.right.label"
        },
        {
          "value": "below",
          "label":"t:sections.event_calendar.settings.layout.options.below.label"
        }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Heading",
      "label":"t:global.general_labels.heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
      "label": "t:global.heading_size.label",
      "options": [
        {
          "value": "h1",
          "label": "t:global.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.heading_size.options.h2.label"
        },
        {
          "value": "h3",
            "label": "t:global.heading_size.options.h3.label"
        },
        {
          "value": "h4",
         "label": "t:global.heading_size.options.h4.label"
        },
        {
          "value": "h5",
           "label": "t:global.heading_size.options.h5.label"
        },
       {
          "value": "h6",
          "label": "t:global.heading_size.options.h6.label"
        }
      ]
    },
    {
          "type": "textarea",
          "id": "description",
          "label": "t:global.general_labels.description",
          "default": "Add short description here."
    },
    {
      "type": "select",
      "id": "description_size",
      "default": "text-size-large",
       "label":"t:global.description_size.label",
      "options": [
          {
          "value": "text-size-xlarge",
          "label": "t:global.description_size.options.xlarge.label"
        },
        {
          "value": "text-size-large",
          "label": "t:global.description_size.options.large.label"
        },
        {
          "value": "text-size-medium",
           "label": "t:global.description_size.options.medium.label"
        },
        {
          "value": "text-size-base",
         "label": "t:global.description_size.options.base.label"
        },
        {
          "value": "text-size-small",
          "label": "t:global.description_size.options.small.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:global.general_labels.button"
    },
    {
      "type": "text",
      "id": "btn_text",
      "default": "View All",
      "label": "t:global.general_labels.text"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "t:global.general_labels.link"
    },
    {
          "type": "select",
          "id": "btn_size",
          "label": "t:global.btn_size.label",
          "default": "medium",
          "options": [
          {
             "value": "xsmall",
             "label": "t:global.btn_size.options.xsmall.label"
           },
           {
             "value": "small",
             "label": "t:global.btn_size.options.small.label"
           },
           {
             "value": "medium",
              "label": "t:global.btn_size.options.medium.label"
           },
           {
             "value": "large",
               "label": "t:global.btn_size.options.large.label"
           }
          ]
        },
    {
        "type": "select",
        "id": "image_size",
        "label": "t:sections.event_calendar.settings.image_size.label",
        "default": "square",
        "options": [
            {
              "value": "adapt",
              "label": "t:global.image_ratio.options.adapt.label"
            },
            {
              "value": "landscape",
              "label": "t:global.image_ratio.options.landscape.label"
            },
            {
              "value": "portrait",
              "label": "t:global.image_ratio.options.portrait.label"
            },
            {
              "value": "square",
              "label": "t:global.image_ratio.options.square.label"
            }

      ]
    },
    {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }
  ],
  "blocks": [
      {
      "type": "event",
       "name": "t:sections.event_calendar.blocks.name",
      "settings": [
        {
          "id": "image",
          "type": "image_picker",
         "label": "t:global.general_labels.image"
        },
        {
          "id": "date",
          "type": "text",
          "label": "t:sections.event_calendar.blocks.settings.date.label",
          "default": "2024-10-11"
        },
        {
          "id": "time",
          "type": "text",
          "label": "t:sections.event_calendar.blocks.settings.time.label",
          "default": "45 min / Session"
        },
        {
          "type": "text",
          "id": "heading",
           "label": "t:global.general_labels.heading",
          "default": "Event heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:global.general_labels.description",
          "default": "<p>Share information and details about this event.</p>"
        },
            {
      "type": "select",
      "id": "description_size",
      "default": "text-size-large",
      "label":"t:global.description_size.label",
      "options": [
       {
          "value": "text-size-xlarge",
          "label": "t:global.description_size.options.xlarge.label"
        },
        {
          "value": "text-size-large",
          "label": "t:global.description_size.options.large.label"
        },
        {
          "value": "text-size-medium",
           "label": "t:global.description_size.options.medium.label"
        },
        {
          "value": "text-size-base",
         "label": "t:global.description_size.options.base.label"
        },
        {
          "value": "text-size-small",
          "label": "t:global.description_size.options.small.label"
        }
      ]
    },
    {
      "type": "header",
      "content":"t:global.general_labels.button"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "t:global.general_labels.text",
      "default": "Book now"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:global.general_labels.link"
    }

      ]
    }
  ],
  "presets": [
    {
     "name": "t:sections.event_calendar.presets.name",
       "blocks": [
        {
          "type": "event"
        },
        {
          "type": "event"
        },
        {
          "type": "event"
        }
      ]
    }
  ]
}
{% endschema %}
