{{ 'featured-collections-list.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
    --space-column: {{ section.settings.column_gap }}px;
  }
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }

  }
</style>
<div class="section-space color-scheme-{{ section.settings.color_scheme }} {% if section.settings.collection_list_position == 'below' %}featured-overlay-showcase{% else %}featured-list-right{% endif %}">
  {% if section.settings.background_image != blank %}
    <div class="featured-collection-background">
      {%- liquid
        assign height = section.settings.background_image.width | divided_by: section.settings.background_image.aspect_ratio | round
        assign sizes = '100vw'
        assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
      %}
      {{
        section.settings.background_image
        | image_url: width: 3840
        | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
      }}
    </div>
  {% endif %}
  <div class="featured-collection-outer">
    <div class="container">
      <div class="grid-wrapper-flex">
        <div class="grid-item-md-12 featured-collection-box">
          {% if section.settings.heading != blank or section.settings.description != blank %}
            <section-heading class="section-header {% if section.settings.collection_list_position == 'below' %}section-header-with-button{% endif %}">
              <div>
                {% if section.settings.heading != blank %}
                  <h2 class="heading-main {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
                {% endif %}
                {% if section.settings.description != blank %}
                  <p class="featured-collection-desc {{ section.settings.description_size }}">
                    {{ section.settings.description | newline_to_br }}
                  </p>
                {% endif %}
              </div>
              <div class="swiper-button-wrapper">
                <div class="swiper-button swiper-button-prev swiper-button-prev-{{ section.id }}"></div>
                <div class="swiper-button swiper-button-next swiper-button-next-{{ section.id }}"></div>
              </div>
            </section-heading>
          {% endif %}

          <slider-main-component
            class="featured-collection-slider swiper-container swiper swiper-slider"
            data-settings='
                {
                "loop": false,
                "slidesPerView": 1.4,
                "spaceBetween": "{{ section.settings.column_gap }}px",
                "navigation": {
                  "nextEl": ".swiper-button-next-{{ section.id }}",
                  "prevEl": ".swiper-button-prev-{{ section.id }}"
                },
                "breakpoints": {
                  "600": {
                    "slidesPerView": 3
                  },
                  "990": {
                    "slidesPerView":{% if section.settings.collection_list_position == 'below' %}3.5{% else %}3{% endif %}
                  }
                },
                "scrollbar": {
                  "el": ".swiper-progressbar-{{ section.id }}",
                  "dragSize":"auto"
                }
              }
            '
          >
            <featured-collection-list class="featured-collection-list swiper-wrapper">
              {% if section.settings.collection_list != blank %}
                {% for card_collection in section.settings.collection_list %}
                  {% liquid
                    assign media_aspect_ratio = section.settings.image_size
                    if media_aspect_ratio == 'landscape'
                      assign imageratio = 75
                    elsif media_aspect_ratio == 'square'
                      assign imageratio = 100
                    elsif media_aspect_ratio == 'portrait'
                      assign imageratio = 125
                    else
                      if card_collection.featured_image != blank
                        assign imageratio = 1 | divided_by: card_collection.featured_image.aspect_ratio | times: 100
                      else
                        assign imageratio = 100
                      endif
                    endif
                  %}
                  <collection-card class="featured-collection-card swiper-slide">
                    <div class="featured-collection-item text-align-{{ section.settings.content_alignment }} {% if section.settings.content_style == 'hover_content' %} collection-overlay-content{% endif %}{% if section.settings.content_style == 'content_below' %}content-below-image{% endif %}">
                      <div class="featured-image">
                        <div class="media-wrapper" style="--media-ratio:{{ imageratio }}%">
                          {%- if card_collection.featured_image -%}
                            <img
                              srcset="
                                {%- if card_collection.featured_image.width >= 165 -%}{{ card_collection.featured_image | image_url: width: 165 }} 165w,{%- endif -%}
                                {%- if card_collection.featured_image.width >= 330 -%}{{ card_collection.featured_image | image_url: width: 330 }} 330w,{%- endif -%}
                                {%- if card_collection.featured_image.width >= 535 -%}{{ card_collection.featured_image | image_url: width: 535 }} 535w,{%- endif -%}
                                {%- if card_collection.featured_image.width >= 750 -%}{{ card_collection.featured_image | image_url: width: 750 }} 750w,{%- endif -%}
                                {%- if card_collection.featured_image.width >= 1000 -%}{{ card_collection.featured_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                                {%- if card_collection.featured_image.width >= 1500 -%}{{ card_collection.featured_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                                {%- if card_collection.featured_image.width >= 3000 -%}{{ card_collection.featured_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                                {{ card_collection.featured_image | image_url }} {{ card_collection.featured_image.width }}w
                              "
                              src="{{ card_collection.featured_image | image_url: width: 1500 }}"
                              sizes="(min-width: 750px) calc(100vw - 10rem),calc(100vw - 3rem)"
                              alt="{{ card_collection.featured_image.alt | escape }}"
                              height="{{ card_collection.featured_image.height }}"
                              width="{{ card_collection.featured_image.width }}"
                              loading="lazy"
                            >
                          {% else %}
                            {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          {% endif %}
                        </div>
                      </div>
                      <div class="collection-content-wrapper">
                        <a href="{{ card_collection.url }}" class="collection-title h6">
                          {{- card_collection.title -}}
                        </a>
                      </div>
                    </div>
                  </collection-card>
                {% endfor %}
              {% else %}
                {% for i in (1..10) %}
                  {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
                  {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
                  <collection-card class="featured-collection-card swiper-slide">
                    <div class="featured-collection-item">
                      <div class="featured-image">
                        <div class="media-wrapper">
                          {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      </div>
                      <div class="collection-content-wrapper">
                        <span class="collection-title">{{ 'onboarding.collection_title' | t }}</span>
                      </div>
                    </div>
                  </collection-card>
                {% endfor %}
              {% endif %}
            </featured-collection-list>
          </slider-main-component>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_collection_list.name",
  "class": "section-featured-collection",
  "tag": "section",
   "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type":"image_picker",
      "id":"background_image",
     "label":"t:global.general_labels.background_image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Heading",
     "label":"t:global.general_labels.heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
    "label": "t:global.heading_size.label",
      "options": [
       {
          "value": "h1",
          "label": "t:global.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.heading_size.options.h2.label"
        },
        {
          "value": "h3",
            "label": "t:global.heading_size.options.h3.label"
        },
        {
          "value": "h4",
         "label": "t:global.heading_size.options.h4.label"
        },
        {
          "value": "h5",
           "label": "t:global.heading_size.options.h5.label"
        },
       {
          "value": "h6",
          "label": "t:global.heading_size.options.h6.label"
        }
      ]
    },
    {
          "type": "textarea",
          "id": "description",
          "label":"t:global.general_labels.description" ,
          "default": "Add short description here."
    },
     {
      "type": "select",
      "id": "description_size",
      "default": "text-size-large",
       "label":"t:global.description_size.label",
      "options": [
         {
          "value": "text-size-xlarge",
          "label": "t:global.description_size.options.xlarge.label"
        },
        {
          "value": "text-size-large",
          "label": "t:global.description_size.options.large.label"
        },
        {
          "value": "text-size-medium",
           "label": "t:global.description_size.options.medium.label"
        },
        {
          "value": "text-size-base",
         "label": "t:global.description_size.options.base.label"
        },
        {
          "value": "text-size-small",
          "label": "t:global.description_size.options.small.label"
        }
      ]
    },
    {
      "type": "collection_list",
      "id":"collection_list",
      "limit": 20,
      "label":"Collections list"
    },
    {
      "type": "range",
      "id":"column_gap",
      "label":"Gap between columns",
      "min":0,
      "max":50,
      "default":20,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id":"collection_list_position",
      "label":"Collection list position",
      "options":[
        {
          "value":"below",
          "label":"Below content"
        },
        {
          "value":"right",
          "label":"Right to content"
        }
      ]
    },
    {
        "type": "select",
        "id": "image_size",
       "label": "t:global.image_ratio.label",
        "default": "square",
        "options": [
          {
            "value": "adapt",
            "label": "t:global.image_ratio.options.adapt.label"
          },
          {
            "value": "landscape",
            "label": "t:global.image_ratio.options.landscape.label"
          },
          {
            "value": "portrait",
            "label": "t:global.image_ratio.options.portrait.label"
          },
          {
            "value": "square",
            "label": "t:global.image_ratio.options.square.label"
          }

      ]
    },
     {
      "type": "select",
      "id": "content_alignment",
      "label": "Collection tittle alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
        {
      "type": "select",
      "id":"content_style",
      "label":"t:sections.featured_collection_list.settings.content_style.label",
      "default":"content_below",
      "options":[
        {
          "value": "hover_content",
          "label":"t:sections.featured_collection_list.settings.content_style.options.hover_content.label"
        },
        {
          "value": "content_below",
         "label":"t:sections.featured_collection_list.settings.content_style.options.content_below.label"
        }
      ]
    },

    {
      "type":"header",
      "content": "t:global.general_labels.color"
    },
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
          "label": "t:global.color_scheme.label"
    },

    {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }
  ],
  "presets": [
    {
      "name":"t:sections.featured_collection_list.presets.name"
    }
  ]
}
{% endschema %}
