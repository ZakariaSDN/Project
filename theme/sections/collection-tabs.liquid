
{{ 'collection-tabs.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'collection-tabs.css' | asset_url | stylesheet_tag }}
<div class="section-space color-scheme-{{ section.settings.color_scheme }}">
  <div class="container">
    {% if section.settings.heading_text != blank %}
  <section-heading class="section-header">
    <{{ section.settings.heading_size }} class="heading-main">
      {{ section.settings.heading_text | escape }}
    </{{ section.settings.heading_size }}>
  </section-heading>
{% endif %}
    <collection-tabs-wrapper class="collection-tabs-wrapper p-relative">
      <tabs-wrapper>
        <ul class="list-style-none tab-nav-wrapper {% if section.settings.tab_style == 'style1' %}border-enabled{% endif %} {% if section.settings.center_tabs_desktop %}center-desktop{% endif %}">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <li class="tab-nav-item">
                <a
                  class="tab-nav-link {% if forloop.first %}active{% endif %}"
                  href="#product-{{ block.id }}"
                  data-url="#tab-{{ block.id }}"
                  data-tab-head
                >
                  {% if block.settings.collection_heading != blank or block.settings.collection != blank %}
                    {{ block.settings.collection_heading | default: block.settings.collection.title -}}
                  {% else %}
                    {{- 'sections.collection_tab.title' | t: count: forloop.index }}
                  {% endif %}
                </a>
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </tabs-wrapper>
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign collection = block.settings.collection %}
          <tab-collections
            id="tab-{{ block.id }}"
            class="tab-collections-content {% if forloop.first %}active{% endif %}"
            {{ block.shopify_attributes }}
            data-tab-content
          >
            <slider-main-component
              class="swiper swiper-slider swiper-container p-relative"
              data-settings='
                  {
                  "loop": true,
                  "slidesPerView": 1.7,
                  "centeredSlides":false,
                  "spaceBetween":"{{ section.settings.column_gap_mobile }}px",
                  "navigation": {
                    "nextEl": ".swiper-button-next-{{ block.id }}",
                    "prevEl": ".swiper-button-prev-{{ block.id }}"
                  },
                "breakpoints": {
                  "600": {
                    "slidesPerView": 4,
                  "spaceBetween":"{{ section.settings.column_gap }}px"
                  }
                }
                }
              '
            >
              <product-card-grid class="product-card-grid swiper-wrapper round-enabled">
                {%- if block.settings.collection != blank and block.settings.collection.all_products_count > 0 -%}
                  {% for product in block.settings.collection.products limit: section.settings.products_count %}
                    {% assign product_form_id = 'product-form-'
                      | append: block.id
                      | append: forloop.index
                      | append: '-'
                      | append: block.settings.collection.handle
                    %}
                    {%- capture current -%}{% cycle section.id: 1, 2, 3, 4 %}{%- endcapture -%}
                    {%- assign placeholder_image = 'product-apparel-' | append: current -%}
                    {% render 'product-card',
                      card_product: product,
                      section: section,
                      slider: true,
                      product_form_id: product_form_id,
                      placeholder_image: placeholder_image,
                      media_aspect_ratio: section.settings.grid_image_size
                    %}
                  {% endfor %}
                {% else %}
                  {% assign limit = section.settings.products_count %}
                  {%- for i in (1..limit) -%}
                    {%- capture current -%}{% cycle section.id: 1, 2, 3, 4 %}{%- endcapture -%}
                    {%- assign placeholder_image = 'product-apparel-' | append: current -%}
                    {% render 'product-card',
                      section: section,
                      slider: true,
                      placeholder_image: placeholder_image,
                      media_aspect_ratio: section.settings.grid_image_size
                    %}
                  {% endfor %}
                {% endif %}
              </product-card-grid>
            </slider-main-component>
            <div class="swiper-button-wrapper">
              <div class="swiper-button swiper-button-prev swiper-button-prev-{{ block.id }}"></div>
              <div class="swiper-button swiper-button-next swiper-button-next-{{ block.id }}"></div>
            </div>
            {%- if collection != blank and block.settings.btn_text != blank %}
              <div class="section-button-wrapper text-align-center">
                <a href="{{ collection.url }}" class="rich-text-button button button-{{ block.settings.btn_size }}">
                  <span class="button-text">{{ block.settings.btn_text }}</span>
                </a>
              </div>
            {% endif %}
          </tab-collections>
        {% endfor %}
      {% endif %}
    </collection-tabs-wrapper>
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} {
    /* Spacing vars */
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
    --space-column: {{ section.settings.column_gap }}px;
    /* Tabs typography/colors */
    --tab-fs-desktop: {{ section.settings.tab_fs_desktop }}px;
    --tab-fs-mobile:  {{ section.settings.tab_fs_mobile }}px;
    --tab-fw: {% if section.settings.tab_bold %}700{% else %}400{% endif %};
    --tab-color: {{ section.settings.tab_text_color }};
    --tab-color-active: {{ section.settings.tab_text_color_active }};
    /* Card text & price styles */
    --ct-text-color: {{ section.settings.card_text_color }};
    --ct-text-fw: {% if section.settings.card_text_bold %}700{% else %}400{% endif %};
    --ct-price-color: {{ section.settings.card_price_color }};
    --ct-price-fw: {% if section.settings.card_price_bold %}700{% else %}600{% endif %};
    /* Add-to-Cart button & Quick-Add icon */
    --cta-bg: {{ section.settings.cta_bg_color }};
    --cta-text: {{ section.settings.cta_text_color }};
    --cta-icon: {{ section.settings.cta_icon_color }};
    --cta-bg-hover: {{ section.settings.cta_bg_color_hover }};
    --cta-text-hover: {{ section.settings.cta_text_color_hover }};
    --cta-icon-hover: {{ section.settings.cta_icon_color_hover }};
    --qadd-bg: {{ section.settings.quick_add_bg_color }};
    --qadd-icon: {{ section.settings.quick_add_icon_color }};
    --qadd-bg-hover: {{ section.settings.quick_add_bg_color_hover }};
    --qadd-icon-hover: {{ section.settings.quick_add_icon_color_hover }};
    /* === NOUVEAU : Taille du bouton “Voir tout” === */
    --viewall-fs-d: {{ section.settings.viewall_font_size_desktop }}px;
    --viewall-fs-m: {{ section.settings.viewall_font_size_mobile }}px;
    --viewall-pv-d: {{ section.settings.viewall_padding_v_desktop }}px;
    --viewall-ph-d: {{ section.settings.viewall_padding_h_desktop }}px;
    --viewall-pv-m: {{ section.settings.viewall_padding_v_mobile }}px;
    --viewall-ph-m: {{ section.settings.viewall_padding_h_mobile }}px;
    /* Fallbacks pour thèmes basés variables */
    --color-button: var(--cta-bg);
    --color-button-text: var(--cta-text);
    --alpha-button-background: 1;
    --button-background: var(--cta-bg);
    --button-label-color: var(--cta-text);
    --button-border-color: var(--cta-bg);
    --button-background-hover: var(--cta-bg-hover);
    --button-label-color-hover: var(--cta-text-hover);
  }
  /* Tabs */
  #shopify-section-{{ section.id }} .tab-nav-wrapper .tab-nav-link{
    font-size: var(--tab-fs-desktop);
    font-weight: var(--tab-fw);
    color: var(--tab-color);
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .tab-nav-wrapper .tab-nav-link.active{
    color: var(--tab-color-active);
  }
  /* Centrage desktop uniquement quand activé */
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .tab-nav-wrapper.center-desktop{
      display: flex;
      justify-content: center;
      text-align: center;
    }
  }
  /* -----------------------------
     TEXTE DES CARTES (découplé)
     ----------------------------- */
  #shopify-section-{{ section.id }} .product-card-grid
  :is(
    .product-card-title,
    .product-card-title a,
    .card-title,
    .card-title a,
    .product-vendor,
    .rating-count,
    .badge,
    .badge span,
    .product-card__title,
    .product-title,
    .product-meta,
    .card__content,
    .card__information
  ){
    color: var(--ct-text-color);
    font-weight: var(--ct-text-fw);
  }
  /* Price */
  #shopify-section-{{ section.id }} .product-card-grid
  :is(.price, .price-item, .price__regular, .price__sale, .money){
    color: var(--ct-price-color) !important;
    font-weight: var(--ct-price-fw);
  }
  /* =========================
     ADD TO CART – Fond/texte
     ========================= */
  #shopify-section-{{ section.id }} :is(.product-card-grid, .card, .collection, .product-grid)
  :is(
    button[name="add"],
    [name="add"],
    .product-form__submit,
    .button--add-to-cart,
    .add-to-cart,
    [data-add-to-cart],
    form[action*="/cart/add"] button,
    form[action*="/cart/add"] .button,
    .quick-add__submit .button,
    .quick-add__submit button,
    .button--primary
  ){
    background: var(--cta-bg) !important;
    color: var(--cta-text) !important;
    border-color: var(--cta-bg) !important;
    --icon-color: var(--cta-icon);
  }
  /* Icône panier dans le bouton */
  #shopify-section-{{ section.id }} :is(.product-card-grid, .card, .collection, .product-grid)
  :is(
    button[name="add"],
    [name="add"],
    .product-form__submit,
    .button--add-to-cart,
    .add-to-cart,
    [data-add-to-cart],
    form[action*="/cart/add"] button,
    form[action*="/cart/add"] .button,
    .quick-add__submit .button,
    .quick-add__submit button,
    .button--primary
  ) :is(svg, use, path, .icon, .icon-cart, .icon--cart){
    color: var(--icon-color) !important;
    fill: var(--icon-color) !important;
    stroke: var(--icon-color) !important;
  }
  /* Hover */
  #shopify-section-{{ section.id }} :is(.product-card-grid, .card, .collection, .product-grid)
  :is(
    button[name="add"]:hover,
    [name="add"]:hover,
    .product-form__submit:hover,
    .button--add-to-cart:hover,
    .add-to-cart:hover,
    [data-add-to-cart]:hover,
    form[action*="/cart/add"] button:hover,
    form[action*="/cart/add"] .button:hover,
    .quick-add__submit .button:hover,
    .quick-add__submit button:hover,
    .button--primary:hover
  ){
    background: var(--cta-bg-hover) !important;
    color: var(--cta-text-hover) !important;
    border-color: var(--cta-bg-hover) !important;
    --icon-color: var(--cta-icon-hover);
  }
  #shopify-section-{{ section.id }} :is(.product-card-grid, .card, .collection, .product-grid)
  :is(
    button[name="add"]:hover,
    [name="add"]:hover,
    .product-form__submit:hover,
    .button--add-to-cart:hover,
    .add-to-cart:hover,
    [data-add-to-cart]:hover,
    form[action*="/cart/add"] button:hover,
    form[action*="/cart/add"] .button:hover,
    .quick-add__submit .button:hover,
    .quick-add__submit button:hover,
    .button--primary:hover
  ) :is(svg, use, path, .icon, .icon-cart, .icon--cart){
    color: var(--icon-color) !important;
    fill: var(--icon-color) !important;
    stroke: var(--icon-color) !important;
  }
  /* =========================
     QUICK ADD – Icône
     ========================= */
  #shopify-section-{{ section.id }} .product-card-grid
  :is(.quick-add, .quick-add-btn, .card-quick-add, [data-quick-add]){
    background: var(--qadd-bg) !important;
    color: var(--qadd-icon) !important;
    --icon-color: var(--qadd-icon);
  }
  #shopify-section-{{ section.id }} .product-card-grid
  :is(.quick-add, .quick-add-btn, .card-quick-add, [data-quick-add])
  :is(svg, use, path, .icon, .icon-cart, .icon--cart){
    color: var(--icon-color) !important;
    fill: var(--icon-color) !important;
    stroke: var(--icon-color) !important;
  }
  #shopify-section-{{ section.id }} .product-card-grid
  :is(.quick-add, .quick-add-btn, .card-quick-add, [data-quick-add]):hover{
    background: var(--qadd-bg-hover) !important;
    color: var(--qadd-icon-hover) !important;
    --icon-color: var(--qadd-icon-hover);
  }
  #shopify-section-{{ section.id }} .product-card-grid
  :is(.quick-add, .quick-add-btn, .card-quick-add, [data-quick-add]):hover
  :is(svg, use, path, .icon, .icon-cart, .icon--cart){
    color: var(--icon-color) !important;
    fill: var(--icon-color) !important;
    stroke: var(--icon-color) !important;
  }
  /* ======= NOUVEAU : Taille du bouton “Voir tout” ======= */
  @media (min-width:768px){
    #shopify-section-{{ section.id }} .section-button-wrapper .button{
      font-size: var(--viewall-fs-d) !important;
      padding: var(--viewall-pv-d) var(--viewall-ph-d) !important;
      line-height: 1.2;
    }
  }
  @media (max-width:767px){
    #shopify-section-{{ section.id }} .section-button-wrapper .button{
      font-size: var(--viewall-fs-m) !important;
      padding: var(--viewall-pv-m) var(--viewall-ph-m) !important;
      line-height: 1.25;
    }
  }
  /* Mobile */
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
      --space-column: {{ section.settings.column_gap_mobile }}px;
    }
    #shopify-section-{{ section.id }} .tab-nav-wrapper .tab-nav-link{
      font-size: var(--tab-fs-mobile);
      font-weight: var(--tab-fw);
    }
  }
</style>
{% schema %}
{
  "name": "t:sections.collection_tab.name",
  "class":"section-collection-tabs",
  "tag": "section",
  "max_blocks": 4,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type":"select",
      "id":"tab_style",
      "label":"t:sections.collection_tab.settings.tab_style.label",
      "options": [
        { "value": "style1", "label": "t:sections.collection_tab.settings.tab_style.options.style1.label" },
        { "value": "style2", "label": "t:sections.collection_tab.settings.tab_style.options.style2.label" }
      ],
      "default": "style1"
    },
    { "type": "text", "id": "heading_text", "default": "Collection tab", "label": "t:global.general_labels.heading" },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
      "label": "t:global.heading_size.label",
      "options": [
        { "value": "h1", "label": "t:global.heading_size.options.h1.label" },
        { "value": "h2", "label": "t:global.heading_size.options.h2.label" },
        { "value": "h3", "label": "t:global.heading_size.options.h3.label" },
        { "value": "h4", "label": "t:global.heading_size.options.h4.label" },
        { "value": "h5", "label": "t:global.heading_size.options.h5.label" },
        { "value": "h6", "label": "t:global.heading_size.options.h6.label" }
      ]
    },
    { "type": "range", "id": "products_count", "min": 4, "max": 12, "step": 2, "label":"t:sections.collection_tab.settings.products_count.label", "default": 4 },
    { "type": "range", "id":"column_gap", "label":"t:sections.collection_tab.settings.column_gap.label", "min":0, "max":50, "default":10, "step": 1, "unit": "px" },
    { "type": "range", "id":"column_gap_mobile", "label":"t:sections.collection_tab.settings.column_gap_mobile.label", "min":0, "max":50, "default":10, "step": 1, "unit": "px" },
    {
      "type": "select",
      "id": "grid_image_size",
      "label": "t:global.grid_image_size.label",
      "default": "adapt",
      "options": [
        { "value": "adapt", "label": "t:global.grid_image_size.options.auto.label" },
        { "value": "landscape", "label": "t:global.grid_image_size.options.landscape.label" },
        { "value": "portrait", "label": "t:global.grid_image_size.options.portrait.label" },
        { "value": "square", "label": "t:global.grid_image_size.options.square.label" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "default": "primary", "label": "t:global.color_scheme.label" },
    /* Tabs typography & colors */
    { "type": "range", "id": "tab_fs_desktop", "label": "Taille des onglets (Desktop)", "min": 10, "max": 40, "step": 1, "default": 16, "unit": "px" },
    { "type": "range", "id": "tab_fs_mobile",  "label": "Taille des onglets (Mobile)",  "min": 10, "max": 32, "step": 1, "default": 14, "unit": "px" },
    { "type": "checkbox", "id": "tab_bold", "label": "Onglets en gras", "default": false },
    { "type": "color", "id": "tab_text_color", "label": "Couleur des onglets", "default": "#222222" },
    { "type": "color", "id": "tab_text_color_active", "label": "Couleur onglet actif", "default": "#111111" },
    /* Centrage onglets (desktop uniquement) */
    { "type": "checkbox", "id": "center_tabs_desktop", "label": "Centrer les onglets (desktop uniquement)", "default": false },
    /* Cards text & price */
    { "type": "color", "id": "card_text_color", "label": "Couleur du texte (cartes)", "default": "#222222" },
    { "type": "checkbox", "id": "card_text_bold", "label": "Texte des cartes en gras", "default": false },
    { "type": "color", "id": "card_price_color", "label": "Couleur du prix", "default": "#111111" },
    { "type": "checkbox", "id": "card_price_bold", "label": "Prix en gras", "default": true },
    /* Add to cart */
    { "type": "header", "content": "Boutons / Icônes Add to cart" },
    { "type": "color", "id": "cta_bg_color", "label": "Fond bouton Add to cart", "default": "#111111" },
    { "type": "color", "id": "cta_text_color", "label": "Texte bouton Add to cart", "default": "#FFFFFF" },
    { "type": "color", "id": "cta_icon_color", "label": "Icône panier (dans le bouton)", "default": "#FFFFFF" },
    { "type": "color", "id": "cta_bg_color_hover", "label": "Fond bouton (hover)", "default": "#222222" },
    { "type": "color", "id": "cta_text_color_hover", "label": "Texte bouton (hover)", "default": "#FFFFFF" },
    { "type": "color", "id": "cta_icon_color_hover", "label": "Icône panier (hover)", "default": "#FFFFFF" },
    /* Quick Add */
    { "type": "header", "content": "Quick Add (icône superposée)" },
    { "type": "color", "id": "quick_add_bg_color", "label": "Fond Quick Add", "default": "#111111" },
    { "type": "color", "id": "quick_add_icon_color", "label": "Icône Quick Add", "default": "#FFFFFF" },
    { "type": "color", "id": "quick_add_bg_color_hover", "label": "Fond Quick Add (hover)", "default": "#222222" },
    { "type": "color", "id": "quick_add_icon_color_hover", "label": "Icône Quick Add (hover)", "default": "#FFFFFF" },
    /* ======= NOUVEAU : Taille bouton “Voir tout” ======= */
    { "type": "header", "content": "Bouton « Voir tout »" },
    { "type": "range", "id": "viewall_font_size_desktop", "label": "Taille du texte (desktop)", "min": 10, "max": 28, "step": 1, "default": 14, "unit": "px" },
    { "type": "range", "id": "viewall_font_size_mobile",  "label": "Taille du texte (mobile)",  "min": 10, "max": 24, "step": 1, "default": 13, "unit": "px" },
    { "type": "range", "id": "viewall_padding_v_desktop", "label": "Padding vertical (desktop)", "min": 4, "max": 24, "step": 1, "default": 10, "unit": "px" },
    { "type": "range", "id": "viewall_padding_h_desktop", "label": "Padding horizontal (desktop)", "min": 8, "max": 40, "step": 1, "default": 18, "unit": "px" },
    { "type": "range", "id": "viewall_padding_v_mobile",  "label": "Padding vertical (mobile)",  "min": 4, "max": 22, "step": 1, "default": 8,  "unit": "px" },
    { "type": "range", "id": "viewall_padding_h_mobile",  "label": "Padding horizontal (mobile)", "min": 8, "max": 36, "step": 1, "default": 16, "unit": "px" },
    /* Spacings */
    { "type": "header", "content": "t:global.section_spacing.label" },
    { "type": "number", "id": "top_space_desktop", "label": "t:global.section_spacing.top_space_desktop.label", "default": 80 },
    { "type": "number", "id": "bottom_space_desktop", "label": "t:global.section_spacing.bottom_space_desktop.label", "default": 80 },
    { "type": "number", "id": "top_space_mobile", "label": "t:global.section_spacing.top_space_mobile.label", "default": 40 },
    { "type": "number", "id": "bottom_space_mobile", "label": "t:global.section_spacing.bottom_space_mobile.label", "default": 40 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_tab.blocks.name",
      "settings": [
        { "type": "text", "id": "collection_heading", "label": "t:global.general_labels.heading" },
        { "type": "collection", "id": "collection", "label": "t:global.general_labels.collection" },
        { "type": "header", "content": "t:global.general_labels.button" },
        { "type": "text", "id": "btn_text", "default": "View All", "label": "t:global.general_labels.text" },
        {
          "type": "select",
          "id": "btn_size",
          "label": "t:global.btn_size.label",
          "default": "small",
          "options": [
            { "value": "xsmall", "label": "t:global.btn_size.options.xsmall.label" },
            { "value": "small",  "label": "t:global.btn_size.options.small.label" },
            { "value": "medium", "label": "t:global.btn_size.options.medium.label" },
            { "value": "large",  "label": "t:global.btn_size.options.large.label" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name":"t:sections.collection_tab.presets.name",
      "blocks":[
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}

