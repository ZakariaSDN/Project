{{ 'collection-list.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'collection-list.css' | asset_url | stylesheet_tag }}
<div class="section-space color-scheme-{{ section.settings.color_scheme }}">
  <div class="container">
    {% if section.settings.heading != blank %}
      <section-heading class="section-header">
        <h2 class="heading-main {{  section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      </section-heading>
    {% endif %}
    <collection-list class="collection-list-wrapper">
      <div class="collection-list-grid text-align-center card-enabled">
        {% if section.settings.collection != blank %}
          {% for collection in section.settings.collection %}
            {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
            {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
            <div class="collection-list-item">
              {% render 'collection-grid',
                card_collection: collection,
                section: section,
                placeholder_image: placeholder_image,
                media_aspect_ratio: section.settings.image_ratio
              %}
            </div>
          {% endfor %}
        {% else %}
          {% assign limit = 4 %}
          {% for i in (1..limit) %}
            {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
            {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
            <div class="collection-list-item">
              {% render 'collection-grid', section: section, placeholder_image: placeholder_image %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </collection-list>
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
    --card-grid-row-items:{{ section.settings.number_item}};
    --card-items-gap: {{ section.settings.column_gap }}px;
    --block-radius: {% if section.settings.collection_style == 'Square' %}0em{% elsif section.settings.collection_style == 'curved' %}0.5em{% elsif section.settings.collection_style == 'rounded' %}50em{% endif %};
  }

  @media only screen and (max-width:991px) {
      #shopify-section-{{ section.id }}.shopify-section {
        --card-grid-row-items: 3;
      }
  }

  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
      --card-grid-row-items: 2;
      --card-items-gap: 6px;
    }

  }
</style>
{% schema %}
{
  "name": "t:sections.collection_list.name",
  "class": "section-collection-list",
  "tag": "section",
   "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
     {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Collection list",
      "label": "t:global.general_labels.heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
      "label": "t:global.heading_size.label",
      "options": [
        {
          "value": "h1",
          "label": "t:global.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.heading_size.options.h2.label"
        },
        {
          "value": "h3",
            "label": "t:global.heading_size.options.h3.label"
        },
        {
          "value": "h4",
         "label": "t:global.heading_size.options.h4.label"
        },
        {
          "value": "h5",
           "label": "t:global.heading_size.options.h5.label"
        },
       {
          "value": "h6",
          "label": "t:global.heading_size.options.h6.label"
        }
      ]
    },
   {
      "type": "collection_list",
      "id": "collection",
      "limit":12,
      "label": "t:sections.collection_list.settings.collection.label"
    },

    {
      "type":"range",
      "id":"number_item",
      "min": 2,
      "max": 6,
      "step": 1,
      "default":4,
      "label": "t:sections.collection_list.settings.number_item.label"
    },
     {
      "type": "range",
      "id":"column_gap",
      "label":"t:sections.collection_list.settings.column_gap.label",
      "min":0,
      "max":50,
      "default":20,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "default": "square",
     "label": "t:global.image_ratio.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:global.image_ratio.options.adapt.label"
        },
        {
          "value": "landscape",
          "label": "t:global.image_ratio.options.landscape.label"
        },
        {
          "value": "portrait",
          "label": "t:global.image_ratio.options.portrait.label"
        },
        {
          "value": "square",
          "label": "t:global.image_ratio.options.square.label"
        }
      ],


    },
    {
        "type": "header",
        "content": "t:global.general_labels.layout"
      },
      {
        "type": "select",
        "id": "collection_style",
        "default": "curved",
        "label": "t:sections.collection_list.settings.collection_style.label",
        "options": [
          {
            "value": "square",
              "label": "t:sections.collection_list.settings.collection_style.options.square.label"
          },
          {
            "value": "curved",
            "label": "t:sections.collection_list.settings.collection_style.options.curved.label"
          },
          {
            "value": "rounded",
            "label": "t:sections.collection_list.settings.collection_style.options.rounded.label"
          }
        ],
      },
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
         "label": "t:global.color_scheme.label"
    },
    {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.presets.name"
    }
  ]
}
{% endschema %}
