                    </g>
                    <defs>
                    <clipPath id="clip0_149_53">
                    <rect width="85" height="87" fill="white"/>
                    </clipPath>
                    </defs>
                  </svg>
                </div>
              {% endif %}
              {% if block.settings.number != blank %}
                <number-counter class="animated-number h2" data-target="{{ block.settings.number -}}">
                  <span class="animat-counter">0</span>
                  {{- block.settings.number_label -}}
                </number-counter>
              {% endif %}
              {% if block.settings.heading != blank %}
                <div class="animated-number-label">{{ block.settings.heading }}</div>
              {% endif %}
              {% if block.settings.description != blank %}
                <div class="animated-number-description">
                  {{ block.settings.description | newline_to_br }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
  --space-column:{{ section.settings.grid_gap }}px;
  }
  {% if section.settings.background_image != blank %}
    #shopify-section-{{ section.id }} .section-background-image {
      position: absolute;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      z-index: 0;
    }

    #shopify-section-{{ section.id }} .section-background-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #shopify-section-{{ section.id }}  .section-background-image:before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: rgb({{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity }}%);
    }
  {% endif %}
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }

  }
</style>
{% schema %}
{
  "name": "t:sections.animated_number.name",
  "class": "section-animated-number",
  "tag": "section",
   "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
        {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
        "label": "t:global.color_scheme.label"
    },
     {
        "type": "image_picker",
        "id": "background_image",
        "label": "t:global.general_labels.background_image"
    },
     {
        "type": "checkbox",
        "id": "show_bg_in_container",
        "default": false,
        "label": "t:sections.animated_number.settings.show_bg_in_container.label"
    },
    {
        "type": "checkbox",
        "id": "show_in_columns",
        "default":false,
        "label": "t:sections.animated_number.settings.show_in_columns.label"
    },
    {
      "type": "range",
      "id": "grid_gap",
     "label": "t:sections.animated_number.settings.grid_gap.label",
      "default": 12,
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px"
    },
{
      "type": "select",
      "id": "content_alignment",
      "label": "t:global.content_alignment.label",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:global.content_alignment.options.left.label"
        },
        {
          "value": "center",
          "label": "t:global.content_alignment.options.center.label"
        },
        {
          "value": "right",
          "label": "t:global.content_alignment.options.right.label"
        }
      ]
    },

   {
     "type":"header",
     "content": "t:global.general_labels.content"
   },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Animated number",
      "label": "t:global.general_labels.heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
       "label": "t:global.heading_size.label",
      "options": [
        {
          "value": "h1",
          "label": "t:global.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.heading_size.options.h2.label"
        },
        {
          "value": "h3",
            "label": "t:global.heading_size.options.h3.label"
        },
        {
          "value": "h4",
         "label": "t:global.heading_size.options.h4.label"
        },
        {
          "value": "h5",
           "label": "t:global.heading_size.options.h5.label"
        },
       {
          "value": "h6",
          "label": "t:global.heading_size.options.h6.label"
        }
      ]
    },
    {
      "type":"textarea",
      "id":"description",
      "label":"t:global.general_labels.description"
    },
     {
      "type": "select",
      "id": "description_size",
      "default": "text-size-large",
       "label": "t:global.description_size.label",
      "options": [
        {
          "value": "text-size-xlarge",
          "label": "t:global.description_size.options.xlarge.label"
        },
        {
          "value": "text-size-large",
          "label": "t:global.description_size.options.large.label"
        },
        {
          "value": "text-size-medium",
           "label": "t:global.description_size.options.medium.label"
        },
        {
          "value": "text-size-base",
         "label": "t:global.description_size.options.base.label"
        },
        {
          "value": "text-size-small",
          "label": "t:global.description_size.options.small.label"
        }
      ]
    },
    {
        "type": "color",
        "id": "overlay_color",
        "default": "#000000",
        "label": "t:global.general_labels.overlay"
    },
     {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:global.general_labels.overlay_opacity",
      "default": 50,
       "min": 0,
       "max": 100,
      "step": 1,
       "unit": "%"
    },
    {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }
  ],
  "blocks":[
    {
      "type":"content",
      "name":"t:sections.animated_number.blocks.name",
      "limit":4,
       "settings": [
         {
              "type": "color_scheme",
              "id": "color_scheme",
              "default": "primary",
              "label": "t:global.color_scheme.label"
          },
         {
           "type":"html",
           "id":"custom_icon",
           "label":"t:sections.animated_number.blocks.settings.custom_icon.label"
         },
         {
           "type":"number",
           "id":"number",
           "label":"t:sections.animated_number.blocks.settings.number.label"
         },
         {
           "type":"text",
           "id":"number_label",
           "label":"t:sections.animated_number.blocks.settings.number_label.label"
         },
         {
           "type": "text",
           "id":"heading",
           "label":"t:global.general_labels.heading",
           "default":"Heading"
         },
         {
           "type": "textarea",
           "id":"description",
           "label":"t:global.general_labels.description",
           "default":"Add short description here."
         }
       ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.animated_number.presets.name",
      "blocks":[
        {
          "type":"content"
        },
        {
          "type":"content"
        },
        {
          "type":"content"
        },
        {
          "type":"content"
        }
      ]
    }
  ]
}
{% endschema %}
