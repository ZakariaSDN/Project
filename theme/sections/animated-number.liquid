{{ 'animated-number.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'animated-number.css' | asset_url | stylesheet_tag }}
<div class="section-space color-scheme-{{ section.settings.color_scheme }} p-relative">
  <div class="container{% if section.settings.show_bg_in_container %} p-relative animated-number-card-enabled{% endif %}">
    {% if section.settings.background_image != blank %}
      <div class="section-background-image">
        {%- liquid
          assign height = section.settings.background_image.width | divided_by: section.settings.background_image.aspect_ratio | round
          assign sizes = '100vw'
          assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
        -%}
        {{
          section.settings.background_image
          | image_url: width: 3840
          | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
        }}
      </div>
    {% endif %}
    <div class="animated-number-wrapper{% if section.settings.show_in_columns %} heading-left{% endif %} p-relative">
      {% if section.settings.heading != blank or section.settings.description != blank %}
        <section-heading class="section-header">
          {% if section.settings.heading != blank %}
            <h2 class="heading-main {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.description != blank %}
            <p class="animated-description {{ section.settings.description_size }}">
              {{ section.settings.description | newline_to_br }}
            </p>
          {% endif %}
        </section-heading>
      {% endif %}
      {% if section.blocks.size > 0 %}
        <div class="animated-number-grid text-align-{{ section.settings.content_alignment }}">
          {% for block in section.blocks %}
            <div
              class="animated-number-grid-item color-scheme-{{ block.settings.color_scheme }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.custom_icon != blank %}
                <div class="animated-number-icon h4">
                  <svg
                    class="icon"
                    width="85"
                    height="87"
                    viewBox="0 0 85 87"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
