{{ 'announcement.css' | asset_url | stylesheet_tag }}
{% liquid
  assign contactInfoStatus = false
  if section.settings.show_contact_info and section.settings.contact_text != blank
    assign contactInfoStatus = true
  endif

  assign current_locale = localization.language.iso_code | downcase
  assign flag_emoji = '🌐'
  case current_locale
    when 'fr'
    when 'en'
    when 'us'
    when 'es'
    when 'it'
    when 'de'
    when 'ar'
    when 'he'
    when 'tr'
  endcase
%}

{% liquid
  assign flag_cc = 'xx'
  case current_locale
    when 'fr'
    when 'en'
    when 'us'
    when 'es'
    when 'it'
    when 'de'
    when 'ar'
    when 'he'
    when 'tr'
  endcase
%}

{% if section.blocks.size > 0 %}
  {% if section.settings.home_page_only == false or template.name == 'index' %}
    <div class="announcementbar-wrapper">
      <div class="container">
        <div class="topbar-wrapper">
          <div class="social-icons-box">
            {% render 'social-media-icons' %}
            {% if contactInfoStatus %}
              <div class="contact-number">
                <div class="call-number">
                  {{- section.settings.contact_text -}}
                </div>
              </div>
            {% endif %}
          </div>

          <announcementbar-box class="announcementbar p-relative">
            <slider-main-component
              class="announcementbar-slider swiper-container"
              {% if section.blocks.size > 1 %}
                data-settings='{
                  "slidesPerView": {{ section.settings.no_of_slides }},
                  "loop": true,
                  "centeredSlides": true,
                  "disableOnInteraction": false,
                  "autoplay": {% if section.settings.auto_rotate == true %}{"delay": {{ section.settings.change_slides_speed | times: 1000 }}}{% else %}false{% endif %},
                  "navigation": { "nextEl": ".swiper-button-next-{{ section.id }}", "prevEl": ".swiper-button-prev-{{ section.id }}" },
                  "breakpoints": {
                    "320": { "slidesPerView": 1, "spaceBetween": 30 },
                    "480": { "slidesPerView": 1, "spaceBetween": 30 },
                    "640": { "slidesPerView": {{ section.settings.no_of_slides }}, "spaceBetween": 30 }
                  }
                }'
              {% endif %}
            >
              <div class="swiper-wrapper" id="swiper-wrapper-{{ section.id }}">
                {% for block in section.blocks %}
                  <div class="swiper-slide" {{ block.shopify_attributes }}>
                    <div class="announcementbar-item">
                      <div class="announcementbar-content">
                        <p class="announcementbar-text">{{ block.settings.announcement_text }}</p>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>

              {% if section.blocks.size > 1 %}
                <div class="swiper-button swiper-button-prev swiper-button-prev-{{ section.id }}"></div>
                <div class="swiper-button swiper-button-next swiper-button-next-{{ section.id }}"></div>
              {% endif %}
            </slider-main-component>
          </announcementbar-box>

          {% if section.settings.contact_email != blank
            or section.settings.enable_currency_selector == true
            or section.settings.enable_language_selector == true
          %}
            <div class="localization-main-wrapper desktop-only text-align-right" data-flag-cc="{{ flag_cc }}">
              {% if section.settings.show_language_flag %}
                <span class="localization-flag-badge" aria-hidden="true">{{ flag_emoji }}</span>
              {% endif %}
              {% if section.settings.contact_email != blank %}
                <div class="email-wrapper">
                  <div class="email-text">
                    {{- section.settings.contact_email -}}
                  </div>
                </div>
              {% endif %}
              {% render 'localization-form', section: section, position: 'header-desktop' %}
            </div>
          {% endif %}
        </div>

        {% if section.settings.enable_currency_selector == true
          or section.settings.enable_language_selector == true
          or section.settings.contact_email != blank
        %}
          <div class="localization-mobile-wrapper mobile-only" data-flag-cc="{{ flag_cc }}">
            {% if section.settings.show_language_flag %}
              <span class="localization-flag-badge" aria-hidden="true">{{ flag_emoji }}</span>
            {% endif %}
            {% render 'localization-form', section: section, position: 'header-mobile' %}
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}
{% endif %}

<style>
  #shopify-section-{{ section.id }}{
    --color-background-foreground: {{ section.settings.background.rgba }};
    --color-text: {{ section.settings.fontcolor.rgba }};
    --link-color: {{ section.settings.link_color.rgba }};
    --link-hover-color: {{ section.settings.link_hover_color.rgba }};
    --swiper-navigation-color: {{ section.settings.fontcolor.rgba }};
    --swiper-theme-color: {{ section.settings.fontcolor.rgba }};
    --annc-height: 42px;
    --annc-gap: 40px;
    --annc-pps: 60;

    /* Réglages mobile pour l’espacement autour du sélecteur */
    --loc-mobile-mt: {{ section.settings.mobile_selector_margin_top | default: 8 }}px;
    --loc-mobile-mb: {{ section.settings.mobile_selector_margin_bottom | default: 8 }}px;
  }

  {% if section.settings.bg_style == 'gradient' and section.settings.background_gradient != blank %}
  #shopify-section-{{ section.id }} .announcementbar-wrapper{
    background: {{ section.settings.background_gradient }};
  }
  {% endif %}

  {% if section.blocks.size == 0 %}
    #shopify-section-{{ section.id }}{ display:none; }
  {% endif %}

  /* ---- Mise en ligne + centrage ---- */
  #shopify-section-{{ section.id }} .announcementbar-item{
    display:flex; align-items:center; justify-content:center;
    min-height: var(--annc-height); width:100%;
  }
  #shopify-section-{{ section.id }} .announcementbar-content{
    position:relative; width:100%; max-width:100%;
    display:flex; align-items:center; justify-content:center;
    overflow:hidden;
  }
  #shopify-section-{{ section.id }} .announcementbar-text{
    margin:0; line-height:1.3;
    white-space: nowrap;
    display:inline-block; text-align:center;
  }

  /* ---- Défilement si texte long ---- */
  #shopify-section-{{ section.id }} .announcementbar-track{
    display:flex; align-items:center;
    gap: var(--annc-gap);
    width: max-content;
    will-change: transform;
    animation: annc-scroll var(--annc-duration, 18s) linear infinite;
  }
  @keyframes annc-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(var(--annc-shift, -100%)); }
  }

  /* Slides Swiper centrées */
  #shopify-section-{{ section.id }} .announcementbar-slider .swiper-slide{
    display:flex; align-items:center; justify-content:center;
  }

  /* ===== Localisation Desktop / Mobile ===== */
  #shopify-section-{{ section.id }} .desktop-only{ display:flex; align-items:center; gap:.6rem; }
  #shopify-section-{{ section.id }} .mobile-only{
    display:none;
    align-items:center;
    justify-content:center;
    gap:.6rem;
  }

  /* Badge drapeau rond (fallback emoji) */
  #shopify-section-{{ section.id }} .localization-flag-badge{
    width: 22px; height: 22px;
    display:inline-flex; align-items:center; justify-content:center;
    border-radius: 9999px;
    font-size: 14px; line-height: 1; overflow:hidden;
    box-shadow: 0 0 0 1px rgba(0,0,0,.08) inset;
  }

  /* On masque le badge emoji placé à l'extérieur du bouton (pour éviter le double) */
  #shopify-section-{{ section.id }} .localization-main-wrapper > .localization-flag-badge,
  #shopify-section-{{ section.id }} .localization-mobile-wrapper > .localization-flag-badge{
    display:none;
  }

  /* Image de drapeau injectée dans le bouton */
  #shopify-section-{{ section.id }} .lf-flag-img{
    width:22px; height:22px; border-radius:9999px; object-fit:cover;
    margin-right:.45rem; flex:0 0 22px; box-shadow:0 0 0 1px rgba(0,0,0,.08) inset;
  }

  /* Sur mobile : montrer la version mobile, gérer les marges configurables */
  @media (max-width: 749px){
    #shopify-section-{{ section.id }} .desktop-only{ display:none !important; }
    #shopify-section-{{ section.id }} .mobile-only{
      display:flex !important;
      margin-top: var(--loc-mobile-mt);
      margin-bottom: var(--loc-mobile-mb);
    }
  }
</style>

<script>
  (function(){
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if(!root) return;

    /* ------ Défilement auto si texte long ------ */
    root.querySelectorAll('.announcementbar-content').forEach(function(box){
      var p = box.querySelector('.announcementbar-text');
      if(!p) return;
      requestAnimationFrame(function(){
        var boxW = box.clientWidth;
        var textW = p.scrollWidth;
        if (textW > boxW){
          var track = document.createElement('div');
          track.className = 'announcementbar-track';
          var clone1 = p.cloneNode(true);
          var clone2 = p.cloneNode(true);
          box.innerHTML = '';
          track.appendChild(clone1);
          track.appendChild(clone2);
          box.appendChild(track);
          var singleW = clone1.scrollWidth;
          var gap = parseInt(getComputedStyle(track).gap) || 0;
          var pps = parseFloat(getComputedStyle(root).getPropertyValue('--annc-pps')) || 60;
          var duration = (singleW + gap) / pps;
          track.style.setProperty('--annc-duration', duration + 's');
          track.style.setProperty('--annc-shift', -(singleW + gap) + 'px');
        }
      });
    });

    /* ------ DRAPEAU : injection robuste ------ */
    function findLocaleButton(wrapper){
      return wrapper && (
        wrapper.querySelector('localization-form button') ||
        wrapper.querySelector('localization-form summary') ||
        wrapper.querySelector('.shopify-localization-form button') ||
        wrapper.querySelector('.disclosure [role="button"], .disclosure button') ||
        wrapper.querySelector('button[aria-controls*="Language"], button[data-disclosure-toggle]') ||
        wrapper.querySelector('button, summary, [role="button"]')
      );
    }

    function injectFlag(wrapper){
      if(!wrapper) return;
      var cc = (wrapper.getAttribute('data-flag-cc') || '').toLowerCase();
      if(!cc || cc === 'xx') return;

      var doneOnce = false;

      var tryOnce = function(){
        if(doneOnce) return true;
        var btn = findLocaleButton(wrapper);
        if(!btn) return false;

        if(!btn.querySelector('.lf-flag-img')){
          // Masque l'icône globe (premier SVG), laisse la flèche
          var svgs = btn.querySelectorAll('svg');
          if(svgs.length >= 1){ svgs[0].style.display = 'none'; }

          var img = document.createElement('img');
          img.className = 'lf-flag-img';
          img.alt = cc.toUpperCase() + ' flag';
          img.width = 22; img.height = 22; img.loading = 'lazy';
          img.src = 'https://flagcdn.com/48x36/' + cc + '.png';
          img.srcset = 'https://flagcdn.com/96x72/' + cc + '.png 2x';
          btn.insertBefore(img, btn.firstChild);
        }
        doneOnce = true;
        return true;
      };

      if(tryOnce()) return;

      // Observe l'hydratation du composant et réinjections
      var obs = new MutationObserver(function(){
        if(tryOnce()){ obs.disconnect(); }
      });
      obs.observe(wrapper, {childList:true, subtree:true});

      // Fallbacks de timing
      setTimeout(tryOnce, 300);
      setTimeout(tryOnce, 1500);
    }

    function run(){
      injectFlag(root.querySelector('.localization-main-wrapper'));
      injectFlag(root.querySelector('.localization-mobile-wrapper'));
    }

    if(document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }

    document.addEventListener('shopify:section:load', function(e){
      if(e.target && e.target.id === 'shopify-section-{{ section.id }}'){ run(); }
    });
    document.addEventListener('shopify:section:select', function(e){
      if(e.target && e.target.id === 'shopify-section-{{ section.id }}'){ run(); }
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "announcement-bar announcement-section",
  "max_blocks": 3,
  "disabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "checkbox", "id": "home_page_only", "label": "t:sections.announcement_bar.settings.home_page.label", "default": true },
    { "type": "checkbox", "id": "auto_rotate", "label": "t:sections.announcement_bar.settings.auto_rotate.label", "default": false },
    { "type": "range", "id": "change_slides_speed", "min": 3, "max": 9, "step": 2, "unit": "s", "label": "t:sections.announcement_bar.settings.change_slides_speed.label", "default": 5 },
    { "type": "range", "id": "no_of_slides", "min": 1, "max": 3, "step": 1, "unit": "s", "label": "t:sections.announcement_bar.settings.no_of_slides.label", "default": 1 },

    { "type": "header", "content": "t:sections.announcement_bar.settings.contact_info.header.label" },
    { "type": "checkbox", "id": "show_contact_info", "default": true, "label": "t:sections.announcement_bar.settings.contact_info.show_contact_info.label", "info": "t:sections.announcement_bar.settings.contact_info.show_contact_info.info" },
    { "type": "inline_richtext", "id": "contact_text", "default": "Need help", "label": "t:sections.announcement_bar.settings.contact_info.contact_text.label" },
    { "type": "inline_richtext", "id": "contact_email", "default": "Email", "label": "t:sections.announcement_bar.settings.contact_info.contact_email.label" },

    { "type": "header", "content": "Sélecteur de langue & devise" },
    { "type": "checkbox", "id": "enable_language_selector", "default": true, "label": "Afficher le sélecteur de langue" },
    { "type": "checkbox", "id": "enable_currency_selector", "default": true, "label": "Afficher le sélecteur de devise" },
    { "type": "checkbox", "id": "show_language_flag", "default": true, "label": "Afficher un drapeau rond à gauche du sélecteur" },

    { "type": "header", "content": "Réglages mobile du sélecteur" },
    { "type": "range", "id": "mobile_selector_margin_top", "min": 0, "max": 40, "step": 1, "unit": "px", "label": "Marge supérieure (mobile)", "default": 8 },
    { "type": "range", "id": "mobile_selector_margin_bottom", "min": 0, "max": 40, "step": 1, "unit": "px", "label": "Marge inférieure (mobile)", "default": 8 },

    { "type": "header", "content": "t:global.general_labels.colors" },

    { "type": "header", "content": "t:sections.announcement_bar.settings.left_side.header.label" },
    { "type": "select", "id": "bg_style", "label": "t:sections.announcement_bar.settings.left_side.background_style.label", "default": "solid",
      "options": [
        { "label": "t:sections.announcement_bar.settings.left_side.background_style.options__1.label", "value": "solid" },
        { "label": "t:sections.announcement_bar.settings.left_side.background_style.options__2.label", "value": "gradient" }
      ]
    },
    { "type": "color", "id": "background", "label": "t:sections.announcement_bar.settings.left_side.background.label", "default": "#E7E7E7" },
    { "type": "color_background", "id": "background_gradient", "label": "t:sections.announcement_bar.settings.left_side.background_gradient.label", "default": "linear-gradient(left bottom, rgba(255, 255, 255, 1), rgba(0, 0, 0, 1) 100%)" },
    { "type": "color", "id": "fontcolor", "default": "#000000", "label": "t:sections.announcement_bar.settings.left_side.font_color.label" },

    { "type": "paragraph", "content": "t:global.general_labels.link" },
    { "type": "color", "id": "link_color", "default": "#ffffff", "label": "t:global.general_labels.text" },
    { "type": "color", "id": "link_hover_color", "default": "#A3A3A3", "label": "t:global.general_labels.hover" }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement_bar.blocks.announcement.name",
      "settings": [
        { "type": "inline_richtext", "id": "announcement_text", "label": "t:sections.announcement_bar.blocks.announcement.settings.text.label", "default": "Announcement text" }
      ]
    }
  ]
}
{% endschema %}
