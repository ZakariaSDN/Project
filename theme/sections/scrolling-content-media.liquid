{{ 'scrolling-content-media.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'scrolling-content-media.css' | asset_url | stylesheet_tag }}
<div class="section-space color-scheme-{{ section.settings.color_scheme }}">
  <div class="scrolling-content-container">
    <div class="scrolling-content-image-wrapper">
      <div class="media-wrapper">
        {% if section.settings.background_image != blank %}
          {%- liquid
            assign height = section.settings.background_image.width | divided_by: section.settings.background_image.aspect_ratio | round
            assign sizes = '100vw'
            assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
          -%}
          {{
            section.settings.background_image
            | image_url: width: 3840
            | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
          }}
        {% else %}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
    {% if section.blocks.size > 0 %}
      <div class="scrolling-content-card round-enabled">
        <div class="scrolling-content-contain container">
          {% for block in section.blocks %}
            <div class="scrolling-content-wrapper">
              <div class="scrolling-content-box media-content-sm scrolling-content-{{ block.settings.position }}">
                {% if block.settings.heading != blank %}
                  <h2 class="scrolling-content-title {{ block.settings.heading_size }}">
                    {{ block.settings.heading }}
                  </h2>
                {% endif %}
                {% if block.settings.description != blank %}
                  <div class="scrolling-content-desc rte">
                    {{ block.settings.description | replace: '<p></p>', '<br>' }}
                  </div>
                {% endif %}

                {% if block.settings.product_list != blank %}
                  <div class="scrolling-content-grid grid-wrapper-flex">
                    {% for product in block.settings.product_list %}
                      {% assign product_form_id = 'product-form-'
                        | append: section.id
                        | append: forloop.index
                        | append: '-'
                        | append: collection.handle
                      %}
                      <div class="grid-item-md-6">
                        {%- capture current -%}{% cycle section.id: 1, 2, 3, 4 %}{%- endcapture -%}
                        {%- assign placeholder_image = 'product-apparel-' | append: current -%}
                        {% render 'product-card',
                          card_product: product,
                          section: section,
                          product_form_id: product_form_id,
                          media_aspect_ratio: block.settings.image_size,
                          placeholder_image: placeholder_image
                        %}
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}

                {% if block.settings.text != blank and block.settings.link != blank %}
                  <a
                    href="{{ block.settings.link }}"
                    class="scrolling-content-button button button-{{ block.settings.btn_size }}"
                  >
                    <span class="button-text">{{ block.settings.text }}</span>
                  </a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;
    --space-column: {{ section.settings.column_gap }}px;

  }
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }

  }
</style>
{% schema %}
{
  "name": "t:sections.scrolling_content_media.name",
  "class":"section-scrolling-content",
   "disabled_on": {
    "groups": ["header", "footer"]
  },
  "tag": "section",
  "settings": [
     {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "primary",
        "label": "t:global.color_scheme.label"
    },
    {
      "type":"image_picker",
      "id":"background_image",
      "label":"t:global.general_labels.background_image"
    },
    {
            "type": "range",
            "id":"column_gap",
            "label":"t:sections.scrolling_content_media.settings.column_gap.label",
            "min":0,
            "max":50,
            "default":20,
            "step": 1,
            "unit": "px"
          },
    {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }
  ],
  "blocks":[
      {
        "type":"content",
        "name":"t:sections.scrolling_content_media.blocks.name",
        "settings":[
          {
            "type": "inline_richtext",
            "id": "heading",
            "default": "Scrolling content media",
            "label":"t:global.general_labels.heading"
          },
          {
            "type": "select",
            "id": "heading_size",
            "default": "h4",
             "label": "t:global.heading_size.label",
            "options": [
                   {
                "value": "h1",
                "label": "t:global.heading_size.options.h1.label"
              },
              {
                "value": "h2",
                "label": "t:global.heading_size.options.h2.label"
              },
              {
                "value": "h3",
                  "label": "t:global.heading_size.options.h3.label"
              },
              {
                "value": "h4",
               "label": "t:global.heading_size.options.h4.label"
              },
              {
                "value": "h5",
                 "label": "t:global.heading_size.options.h5.label"
              },
             {
                "value": "h6",
                "label": "t:global.heading_size.options.h6.label"
              }
            ]
          },
          {
            "type":"richtext",
            "id":"description",
            "label":"t:global.general_labels.description" ,
            "default":"<p>Add short description here.</p>"
          },
          {
            "type": "header",
            "content": "t:global.general_labels.button"
          },
          {
            "type":"text",
            "id":"text",
            "label":"t:global.general_labels.text",
            "default":"Shop now"
          },
          {
            "type":"url",
            "id":"link",
            "label":"t:global.general_labels.link"
          },
          {
          "type": "select",
          "id": "btn_size",
           "label": "t:global.btn_size.label",
          "default": "medium",
          "options": [
          {
            "value": "xsmall",
            "label": "t:global.btn_size.options.xsmall.label"
          },
          {
            "value": "small",
            "label": "t:global.btn_size.options.small.label"
          },
          {
            "value": "medium",
            "label": "t:global.btn_size.options.medium.label"
          },
          {
            "value": "large",
            "label": "t:global.btn_size.options.large.label"
          }
          ]
        },

          {
            "type":"product_list",
            "id":"product_list",
            "limit": 6,
            "label":"t:sections.scrolling_content_media.blocks.settings.product_list.label"
          },

           {
          "type": "select",
          "id": "image_size",
          "default": "square",
          "label": "t:global.grid_image_size.label",
        "options": [
           {
              "value": "adapt",
              "label": "t:global.grid_image_size.options.auto.label"
            },
            {
              "value": "landscape",
              "label": "t:global.grid_image_size.options.landscape.label"
            },
            {
              "value": "portrait",
              "label": "t:global.grid_image_size.options.portrait.label"
            },
            {
              "value": "square",
              "label": "t:global.grid_image_size.options.square.label"
            }
        ]

    },
    {
            "type":"select",
            "id":"position",
            "label":"t:global.position.label",
            "options": [
              {
                "value": "left",
                "label":"t:global.position.options.left.label"
              },
              {
                "value": "right",
                "label":"t:global.position.options.right.label"
              }
            ]
          }
        ]
      }
  ],
  "presets": [
    {
      "name": "t:sections.scrolling_content_media.presets.name",
      "blocks": [
        {
          "type": "content"
        },
        {
          "type": "content"
        }
      ]
    }
  ]
}
{% endschema %}
