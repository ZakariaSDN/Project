{{ 'testimonial.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'testimonial.css' | asset_url | stylesheet_tag }}
<div class="section-space color-scheme-{{ section.settings.color_scheme }}">
  <div class="container {% if section.settings.image == null %}compact-container{% endif %}">
    {% if section.settings.heading != blank %}
      <section-heading class="section-header">
        <h2 class="heading-main {{ section.settings.heading_size }} text-align-{{ section.settings.heading_alignment }}">
          {{- section.settings.heading -}}
        </h2>
      </section-heading>
    {% endif %}
    <div class="testimonial-main-wrapper">
      {% if section.settings.image != null %}
        {%- liquid
          if section.settings.image_size == 'landscape'
            assign imageratio = 75
          elsif section.settings.image_size == 'square'
            assign imageratio = 100
          elsif section.settings.image_size == 'portrait'
            assign imageratio = 125
          else
            assign imageratio = 1 | divided_by: section.settings.image.aspect_ratio | times: 100
          endif
        -%}
        <div class="testimonial-image">
          <div class="media-wrapper" style="--media-ratio:{{ imageratio }}%">
            {% assign image_url = section.settings.image %}
            <img
              srcset="
                {%- if image_url.width >= 165 -%}{{ image_url | image_url: width: 165 }} 165w,{%- endif -%}
                {%- if image_url.width >= 330 -%}{{ image_url | image_url: width: 330 }} 330w,{%- endif -%}
                {%- if image_url.width >= 535 -%}{{ image_url | image_url: width: 535 }} 535w,{%- endif -%}
                {%- if image_url.width >= 750 -%}{{ image_url | image_url: width: 750 }} 750w,{%- endif -%}
                {%- if image_url.width >= 1000 -%}{{ image_url | image_url: width: 1000 }} 1000w,{%- endif -%}
                {%- if image_url.width >= 1500 -%}{{ image_url | image_url: width: 1500 }} 1500w,{%- endif -%}
                {%- if image_url.width >= 3000 -%}{{ image_url | image_url: width: 3000 }} 3000w,{%- endif -%}
                {{ image_url | image_url }} {{ image_url.width }}w
              "
              src="{{ image_url | image_url: width: 1500 }}"
              sizes="calc(100vw - 3rem)"
              alt="{{ image_url.alt | escape }}"
              height="{{ image_url.height }}"
              width="{{ image_url.width }}"
              loading="lazy"
            >
          </div>
        </div>
      {% endif %}

      {% if section.blocks.size != 0 %}
        <custom-slider-element data-id="{{ section.id }}">
          <div class="testimonial-slider text-align-{{ section.settings.content_alignment }}">
            <div class="swiper" data-main-slider-{{ section.id }}>
              <div class="swiper-wrapper">
                {% for block in section.blocks %}
                  <div class="swiper-slide">
                    <div class="testimonial-item">
                      {% capture content %}
                       {% if block.settings.heading != blank %}
                         <h5 class="testimonial-title">{{ block.settings.heading  }}</h5>
                       {% endif %}
                     {% if block.settings.rating != blank %}
                        <div class="star-ratings">
                          <ul class="list-style-none ratings-box">
                            {%- for i in (1..block.settings.rating) -%}
                            <li>
                              <svg class="icon icon-xsmall" width="18" height="17" viewBox="0 0 18 17" fill="none">
                                <path fill-rule="evenodd" clip-rule="evenodd"
                                  d="M9.33751 0.483858L11.0438 5.76653L16.5949 5.75288C17.2956 5.75288 17.5595 6.62195 16.9453 7.06786L12.5089 10.2757L14.2334 15.5493C14.4564 16.2227 13.6465 16.755 13.1141 16.3L8.67319 13.0603L4.18679 16.3319C3.57707 16.7732 2.90366 16.1772 3.15846 15.4037L4.83745 10.2757L0.341948 7.02236C-0.231366 6.6083 0.105342 5.70738 0.801508 5.75288L6.30259 5.76653L8.00888 0.483858C8.21363 -0.162257 9.13275 -0.157707 9.33751 0.483858Z"
                                  fill="currentColor"></path>
                              </svg>
                            </li>
                          {%endfor %}
                        </ul>
                      </div>
                   {%endif %}
                 {% if block.settings.description != blank %}
                 <div class="testimonial-desc">
                  {{ block.settings.description | replace: '<p><p>', '<br>' }}
                 </div>
                 {%endif %}
                 {% if block.settings.author != blank  or block.setting.text != blank %}
                  <div class="testimonial-author-wrapper">
                    {% if block.settings.author != blank %}
                    <span class="testimonial-author h6">{{ block.settings.author }}</span>
                    {%endif %}
                    {% if block.settings.text != blank %}
                    <p>{{block.settings.text }}</p>
                    {% endif %}
                  </div>
                 {% endif %}
                 {% endcapture %}
                      {% if content != blank %}
                        <div class="testimonial-content">
                          <div class="testimonial-content-inner">
                            {{ content }}
                          </div>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
            <div class="swiper-button swiper-button-prev swiper-button-prev-{{ section.id }}"></div>
            <div class="swiper-button swiper-button-next swiper-button-next-{{ section.id }}"></div>
          </div>
          {% if section.settings.show_thumbnails and section.blocks.size > 0 %}
            <div class="testimonial-reviews-author" data-thumb-slider-{{ section.id }}>
              <div class="swiper-wrapper">
                {% for block in section.blocks %}
                  <span class="swiper-slide reviews-author-img">
                    {% if block.settings.author_image != blank %}
                      {% assign image_url = block.settings.author_image %}

                      <img
                        srcset="
                          {%- if image_url.width >= 50 -%}{{ image_url | image_url: width: 50 }} 50w,{%- endif -%}
                          {%- if image_url.width >= 75 -%}{{ image_url | image_url: width: 75 }} 75w,{%- endif -%}
                          {{ image_url | image_url }} {{ image_url.width }}w
                        "
                        src="{{ image_url | image_url: width: 80 }}"
                        sizes="calc(100vw - 3rem)"
                        alt="{{ image_url.alt | escape }}"
                        height="{{ image_url.height }}"
                        width="{{ image_url.width }}"
                        loading="lazy"
                      >
                    {% else %}
                      {% liquid
                        capture current
                          cycle 1, 2
                        endcapture
                      %}
                      {{ 'hero-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </span>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </custom-slider-element>
      {% endif %}
    </div>
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} {
    --section-top-space:{{ section.settings.top_space_desktop }}px;
    --section-bottom-space:{{ section.settings.bottom_space_desktop }}px;

  }
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --section-top-space:{{ section.settings.top_space_mobile }}px;
      --section-bottom-space:{{ section.settings.bottom_space_mobile }}px;
    }

  }
</style>
{% schema %}
{
  "name": "t:sections.testimonials.name",
  "class": "section-testimonials",
  "tag": "section",
  "max_blocks": 10,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
     {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "primary",
   "label": "t:global.color_scheme.label"
    },
     {
          "type": "image_picker",
          "id": "image",
           "label":"t:global.general_labels.image"
        },
    {
    "type": "select",
    "id": "image_size",
    "label": "t:global.image_ratio.label",
      "default": "adapt",
      "options": [
           {
            "value": "adapt",
            "label": "t:global.image_ratio.options.adapt.label"
          },
          {
            "value": "landscape",
            "label": "t:global.image_ratio.options.landscape.label"
          },
          {
            "value": "portrait",
            "label": "t:global.image_ratio.options.portrait.label"
          },
          {
            "value": "square",
            "label": "t:global.image_ratio.options.square.label"
          }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Our Collections",
      "label":"t:global.general_labels.heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
     "label": "t:global.heading_size.label",
      "options": [
          {
          "value": "h1",
          "label": "t:global.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.heading_size.options.h2.label"
        },
        {
          "value": "h3",
            "label": "t:global.heading_size.options.h3.label"
        },
        {
          "value": "h4",
         "label": "t:global.heading_size.options.h4.label"
        },
        {
          "value": "h5",
           "label": "t:global.heading_size.options.h5.label"
        },
       {
          "value": "h6",
          "label": "t:global.heading_size.options.h6.label"
        }
      ]
    },

{
      "type": "select",
      "id": "heading_alignment",
      "label": "t:global.heading_alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:global.heading_alignment.options.left.label"
        },
        {
          "value": "center",
          "label": "t:global.heading_alignment.options.center.label"
        },
        {
          "value": "right",
          "label": "t:global.heading_alignment.options.right.label"
        }
      ]
    },


        {
      "type": "select",
      "id": "content_alignment",
      "label": "t:global.text_alignment.label",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:global.text_alignment.options.left.label"
        },
        {
          "value": "center",
        "label": "t:global.text_alignment.options.center.label"
        },
        {
          "value": "right",
          "label": "t:global.text_alignment.options.right.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id":"show_thumbnails",
      "default":true,
      "label":"t:sections.testimonials.settings.show_thumbnails.label"
    },
    {
      "type": "header",
       "content": "t:global.section_spacing.label"
    },
     {
      "type": "number",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 80,

    },
    {
      "type": "number",
      "id": "bottom_space_desktop",
       "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 80

    },
    {
      "type": "number",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40
    },
    {
      "type": "number",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "t:sections.testimonials.blocks.name",
      "settings": [

        {
          "type": "range",
          "id": "rating",
          "label": "t:sections.testimonials.blocks.settings.rating.label",
          "default": 4,
          "min": 1,
          "max": 5,
          "step": 1
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label":"t:global.general_labels.heading" ,
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "default": "<p>Add client reviews & testimonials to showcase your store’s happy clients.</p>",
           "label":"t:global.general_labels.description"
        },
        {
          "type": "header",
          "content": "t:sections.testimonials.blocks.settings.author.label"
        },
        {
          "type": "image_picker",
          "id":"author_image",
          "label":"t:sections.testimonials.blocks.settings.author_image.label"
        },
        {
          "type": "text",
          "id": "author",
          "default": "Author name here",
         "label":"t:sections.testimonials.blocks.settings.author.label"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Text",
          "label":"t:global.general_labels.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.presets.name",
      "blocks": [
        {
           "type": "quote"
        },
        {
           "type": "quote"
        },
        {
           "type": "quote"
        }
      ]
    }
  ]
}
{% endschema %}
