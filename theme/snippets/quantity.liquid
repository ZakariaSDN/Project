<div class="product-quantity-wrapper">
  {% if quntity_text != false %}
    <div class="label-text">{{ 'products.product.quantity.label' | t }}</div>
  {% endif %}
  <quantity-input
    id="quantity-Form-{{ product_form_id }}"
    class="quantity quantity-buttons"
    data-url="{{ product.url }}"
    data-section="{{ section.id }}"  
    {% unless sticky %}
        data-main-quantity
        {% else %}
        data-sticky-quantity
      {% endunless %}
    data-form="{{ product_form_id }}"
  >
    <button
      class="minus-button"
      type="button"
      name="minus"
      aria-label="{{ 'products.product.quantity.decrease' | t }}"
      data-quantity-decrement
    >
      <svg width="10" height="2" viewBox="0 0 10 2" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 4.37114e-08L10 2L-8.74228e-08 2L0 -4.37114e-07L10 4.37114e-08Z" fill="currentcolor"/>
      </svg>
    </button>
    <input
      id="product-quantity-{{ product_form_id }}"
      class="quantity-input"
      type="number"
      name="quantity"
      min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
      {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
        max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
      {% endif %}
      step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
      value="1"
      {% unless sticky %}
      form="{{ product_form_id }}"
      {% endunless %}
      data-input-quantity
      aria-label="{{ 'products.product.quantity.label' | t }}"
    >
    <button
      class="plus-button"
      type="button"
      name="plus"
      aria-label="{{ 'products.product.quantity.increase' | t }}"
      data-quantity-increment
    >
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 4V6L0 6L8.74243e-08 4L10 4Z" fill="currentcolor"/>
        <path d="M6 10H4L4 0L6 1.74845e-07L6 10Z" fill="currentcolor"/>
      </svg>
    </button>
  </quantity-input>
</div>
