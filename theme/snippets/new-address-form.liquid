<address-drawer
  id="add-new-address"
  class="address-drawer drawer right"
  id="address-drawer"
  role="dialog"
  aria-modal="true"
>
  <drawer-layer class="overlay" data-close-drawer>
    <drawer-mouse-cursor class="drawer-mouse-cursor" style="transform: translate(850px, 215px);">
      <svg class="icon" stroke="currentColor" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 30L30 10M10 10L30 30" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </drawer-mouse-cursor>
  </drawer-layer>
  <div class="drawer-inner-card">
    <div class="drawer-container">
      <div class="drawer-head">
        <drawer-header>
          <a href="#" class="drawer-close button-right" aria-label="Close" data-close-drawer>
            <svg
              class="drawer-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
            >
              <path d="M18 6L6 18" stroke="currentColor" stroke-width="1.5"></path>
              <path d="M6 6L18 18" stroke="currentColor" stroke-width="1.5"></path>
            </svg>
          </a>
          <h3 class="drawer-heading h5">{{ 'customer.addresses.add_new' | t }}</h3>
        </drawer-header>
      </div>
      <div class="drawer-body">
        <div class="drawer-content-contain">
          {%- form 'customer_address', customer.new_address, class: 'new-address-form' -%}
            <div class="fieldset">
              <div class="form-flex-row">
                <div class="form-flex-item">
                  <label for="AddressFirstNameNew" class="hidden">{{- 'customer.addresses.first_name' | t -}}</label>
                  <input
                    type="text"
                    id="AddressFirstNameNew"
                    name="address[first_name]"
                    value="{{ form.first_name }}"
                    autocomplete="given-name"
                    placeholder=" {{- 'customer.addresses.first_name' | t -}}"
                    class="form-control-input"
                  >
                </div>
                <div class="form-flex-item">
                  <label for="AddressLastNameNew" class="hidden">{{- 'customer.addresses.last_name' | t -}}</label>
                  <input
                    type="text"
                    id="AddressLastNameNew"
                    name="address[last_name]"
                    value="{{ form.last_name }}"
                    autocomplete="family-name"
                    placeholder="{{- 'customer.addresses.last_name' | t -}}"
                    class="form-control-input"
                  >
                </div>
              </div>
              <div class="form-flex-item">
                <label for="AddressCompanyNew" class="hidden">{{- 'customer.addresses.company' | t -}}</label>
                <input
                  type="text"
                  id="AddressCompanyNew"
                  name="address[company]"
                  value="{{ form.company }}"
                  autocomplete="organization"
                  placeholder="{{ 'customer.addresses.company' | t }}"
                  class="form-control-input"
                >
              </div>
              <div class="form-flex-item">
                <label for="AddressAddress1New" class="hidden">{{- 'customer.addresses.address1' | t -}}</label>
                <input
                  type="text"
                  id="AddressAddress1New"
                  name="address[address1]"
                  value="{{ form.address1 }}"
                  autocomplete="address-line1"
                  placeholder="{{- 'customer.addresses.address1' | t -}}"
                  class="form-control-input"
                >
              </div>
              <div class="form-flex-item">
                <label for="AddressAddress2New" class="hidden">{{- 'customer.addresses.address2' | t -}}</label>
                <input
                  type="text"
                  id="AddressAddress2New"
                  name="address[address2]"
                  value="{{ form.address2 }}"
                  autocomplete="address-line2"
                  placeholder=" {{- 'customer.addresses.address2' | t -}}"
                  class="form-control-input"
                >
              </div>
              <div class="form-flex-item">
                <label for="AddressCityNew" class="hidden">{{ 'customer.addresses.city' | t }}</label>
                <input
                  type="text"
                  id="AddressCityNew"
                  name="address[city]"
                  value="{{ form.city }}"
                  autocomplete="address-level2"
                  placeholder="{{ 'customer.addresses.city' | t }}"
                  class="form-control-input"
                >
              </div>
              <div class="form-flex-row">
                <div class="form-flex-item">
                  <label for="AddressCountryNew" class="hidden">{{- 'customer.addresses.country' | t -}}</label>
                  <div class="form-control-field">
                    <select
                      id="AddressCountryNew"
                      name="address[country]"

                      data-default="{{ form.country }}"
                      data-form-id="{{ form.id }}"
                      autocomplete="country"
                      class="form-control-input select"
                      placeholder=" {{- 'customer.addresses.country' | t -}}"
                      tanbindex="0"
                    >
                      {{ all_country_option_tags }}
                    </select>
                  </div>
                </div>
                <div
                  class="form-flex-item"
                  id="AddressProvinceContainerNew"
                  style="display:none;"
                >
                  <label for="AddressProvinceNew" class="hidden">
                    {{- 'customer.addresses.province' | t -}}
                  </label>
                  <select
                    class="form-control-input select"
                    id="AddressProvinceNew"
                    name="address[province]"
                    data-default="{{ form.province }}"
                    autocomplete="address-level1"
                    class="form-control-input select"
                  ></select>
                </div>
                <div class="form-flex-item">
                  <label for="AddressZipNew" class="hidden">{{- 'customer.addresses.zip' | t -}}</label>
                  <input
                    type="text"
                    id="AddressZipNew"
                    name="address[zip]"
                    value="{{ form.zip }}"
                    autocapitalize="characters"
                    autocomplete="postal-code"
                    placeholder="{{- 'customer.addresses.zip' | t -}}"
                    class="form-control-input"
                  >
                </div>
              </div>
              <div class="form-flex-item">
                <label for="AddressPhoneNew" class="hidden">{{ 'customer.addresses.phone' | t }}</label>
                <input
                  type="tel"
                  id="AddressPhoneNew"
                  name="address[phone]"
                  value="{{ form.phone }}"
                  autocomplete="tel"
                  placeholder="{{ 'customer.addresses.phone' | t }}"
                  class="form-control-input"
                >
              </div>

              <div class="form-flex-item custom-checkbox">
                <input type="checkbox" id="address_defaultaddressnew" name="address[default]" value="1">
                <label for="address_defaultaddressnew">{{- 'customer.addresses.set_default' | t -}}</label>
              </div>

              <div class="address_button-wrapper">
                <button type="submit" class="button button-medium button-full">
                  {{ 'customer.addresses.add' | t }}
                </button>
                <a href="{{ routes.account_url  }}" class="button-underline">{{ 'customer.account.return' | t }}</a>
              </div>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</address-drawer>
