<template data-custom-content-container>
  {{ 'contact.css' | asset_url | stylesheet_tag }}
  <query-content-drawer
    class="query-content-drawer drawer right"
    id="query-content-drawer-{{ block.id }}"
    data-drawer-id="{{ block.id }}"
    role="dialog"
    aria-modal="true"
  >
    <drawer-layer class="overlay" data-close-drawer data-block="{{ block.id }}">
      <drawer-mouse-cursor class="drawer-mouse-cursor">
        <svg class="icon" stroke="currentColor" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 30L30 10M10 10L30 30" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </drawer-mouse-cursor>
    </drawer-layer>
    <div class="drawer-inner-card">
      <div class="drawer-container">
        <div class="drawer-head">
          <drawer-header>
            <a
              href="#"
              class="drawer-close button-right"
              aria-label="Close"
              data-close-drawer
              data-block="{{ block.id }}"
            >
              <svg
                class="drawer-icon"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
              >
                <path d="M18 6L6 18" stroke="currentColor" stroke-width="1.5"></path>
                <path d="M6 6L18 18" stroke="currentColor" stroke-width="1.5"></path>
              </svg>
            </a>
            <h3 class="drawer-heading h5">{{ block.settings.text }}</h3>
          </drawer-header>
        </div>
        <div class="drawer-body">
          <div class="drawer-content-contain rte">
            {% if block.settings.content != blank %}
              <div class="rte ">{{ block.settings.content | replace: '<p></p>', '<br>' }}</div>
            {% endif %}
            {%- form 'contact', id: 'ContactUsForm', class: 'contact-us-form' -%}
              <div class="form-flex-row">
                {%- if form.posted_successfully? -%}
                  <div class="form-message success">
                    <span class="form-status form-status-list form__message" tabindex="-1" autofocus>
                      {{ 'templates.contact.form.post_success' | t }}
                    </span>
                  </div>
                {%- elsif form.errors -%}
                  <div class="form-message error">
                    <span class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                      {{ 'templates.contact.form.error_heading' | t }}
                    </span>
                  </div>
                  <ul class="form-status-list caption-large" role="list">
                    <li>
                      <a href="#ContactForm-email" class="link">
                        {{ form.errors.translated_fields.email | capitalize }}
                        {{ form.errors.messages.email }}
                      </a>
                    </li>
                  </ul>
                {%- endif -%}
                <div class="form-flex-item">
                  <label class="hidden" for="ContactFirstName">{{ 'templates.contact.form.firstname' | t }}</label>
                  <input
                    type="text"
                    id="ContactFirstName"
                    name="contact[first_name]"
                    class="form-control-input"
                    autocomplete="email"
                    autocapitalize="off"
                    placeholder="{{ 'templates.contact.form.firstname' | t }}"
                    required=""
                    value="{% if form.first_name %}{{ form.first_name }}{% elsif customer %}{{ customer.first_name }}{% endif %}"
                  >
                </div>
                <div class="form-flex-item">
                  <label class="hidden" for="ContactLastName">{{ 'templates.contact.form.lastname' | t }}</label>
                  <input
                    type="text"
                    id="ContactLastName"
                    name="contact[last_name]"
                    class="form-control-input"
                    autocomplete="email"
                    autocapitalize="off"
                    placeholder="{{ 'templates.contact.form.lastname' | t }}"
                    required=""
                    value="{% if form.last_name %}{{ form.last_name }}{% elsif customer %}{{ customer.last_name }}{% endif %}"
                  >
                </div>
                <div class="form-flex-item">
                  <label class="hidden" for="ContactEmail">{{ 'templates.contact.form.email' | t }}</label>
                  <input
                    type="text"
                    id="ContactEmail"
                    name="contact[email]"
                    class="form-control-input"
                    autocomplete="email"
                    autocapitalize="off"
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                    aria-required="true"
                    spellcheck="false"
                    placeholder="{{ 'templates.contact.form.email' | t }}"
                    pattern="^([a-zA-Z0-9_\\-\\.]+)@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.)|(([a-zA-Z0-9\\-]+\\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\\]?)$"
                    required=""
                  >
                </div>
                <div class="form-flex-item">
                  <label class="hidden" for="ContactPhone">{{ 'templates.contact.form.phone' | t }}</label>
                  <input
                    type="text"
                    id="ContactPhone"
                    name="contact[phone]"
                    class="form-control-input"
                    autocomplete="email"
                    autocapitalize="off"
                    placeholder="{{ 'templates.contact.form.phone' | t }}"
                    required=""
                  >
                </div>
              </div>
              <div class="form-flex-item">
                <label class="hidden" for="ContactMessage">{{ 'templates.contact.form.comment' | t }}</label>
                <textarea
                  rows="6"
                  cols="8"
                  id="ContactMessage"
                  name="contact[message]"
                  class="form-control-input"
                  placeholder="{{ 'templates.contact.form.comment' | t }}"
                  required=""
                ></textarea>
              </div>

              <div class="form-flex-item align-left">
                <button type="submit" class="button button-medium">
                  <span class="button-text">{{ 'templates.contact.form.send' | t }}</span>
                </button>
              </div>
            {% endform %}
          </div>
        </div>
      </div>
    </div>
  </query-content-drawer>
</template>
