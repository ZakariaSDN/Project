{%- assign product_form_id = 'product-form-' | append: section.id -%}

<div class="product-media-info-inner">
  {% for block in section.blocks %}
    {% case block.type %}
      {%- when '@app' -%}
        {% render block %}
      {% when 'vendor' %}
        {% if product.vendor %}
          <div class="product-info-vendor">
            <span class="vendor-item">{{ product.vendor }}</span>
          </div>
        {% endif %}
      {% when 'sku' %}
        {% if current_variant.sku != blank %}
          <div class="product-info-sku" {{ block.shopify_attributes }}>
            <span id="sku-{{ section.id }}" class="sku-title" data-variant-sku>{{ current_variant.sku }}</span>
          </div>
        {% endif %}
      {% when 'title' %}
        {% if template == 'product' and is_quick_view != true %}
          <h1 class="product-info-heading h4" {{ block.shopify_attributes }}>{{- product.title | escape -}}</h1>
        {% else %}
          <h2 class="product-info-heading h4" {{ block.shopify_attributes }}>{{- product.title | escape -}}</h2>
        {% endif %}
      {% when 'text' %}
        <div class="product-text-info text-size-medium " {{ block.shopify_attributes }}>
          {{ block.settings.text }}
        </div>
      {% when 'price' %}
        <div
          id="price-{{ section.id }}"
          class="product-price-wrapper no-js-hidden"
          role="status"
          data-main-price
          {{ block.shopify_attributes }}
        >
          {% render 'price', product: product, section: section %}
          {% unless block.settings.hide_shipping_content %}
            {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
              <span class="product-item-shipping-tax">
                {%- if cart.duties_included and cart.taxes_included -%}
                  {{ 'products.product.duties_and_taxes_included' | t }}
                {%- elsif cart.taxes_included -%}
                  {{ 'products.product.taxes_included' | t }}
                {%- elsif cart.duties_included -%}
                  {{ 'products.product.duties_included' | t }}
                {%- endif -%}
                {%- if shop.shipping_policy.body != blank -%}
                  {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              </span>
            {%- endif -%}
          {% endunless %}
          {% if product != blank %}
            <div {{ block.shopify_attributes }}>
              {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
              {%- form 'product', product, id: product_form_installment_id -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {{ form | payment_terms }}
              {%- endform -%}
            </div>
          {% endif %}
        </div>
      {% when 'inventory' %}
        <div
          class="product-info-inventory {% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
          {{ block.shopify_attributes }}
          id="Inventory-{{ section.id }}"
          data-inventory-message
        >
          {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
            {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
              {%- if product.selected_or_first_available_variant.inventory_quantity <= block.settings.minimun_inventory -%}
                <span class="lowstock">
                  {{- 'products.product.inventory_low_stock' | t -}}
                </span>
              {%- else -%}
                <span class="instock">
                  {{- 'products.product.inventory_in_stock' | t -}}
                </span>
              {%- endif -%}
            {%- else -%}
              {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                <span class="instock">
                  {{- 'products.product.inventory_in_stock' | t -}}
                </span>
              {%- else -%}
                <span class="outofstock">
                  {{- 'products.product.inventory_out_of_stock' | t -}}
                </span>
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
          {% liquid
            assign quantity_max = block.settings.minimun_inventory
            assign quantity_value = product.selected_or_first_available_variant.inventory_quantity
            assign quantity_width = quantity_value | times: quantity_max
            assign quantity_width_new = quantity_width | divided_by: 100
            assign quantity_width = quantity_value | minus: quantity_width_new
            if quantity_width > 100
              assign quantity_width = 100
            endif
          %}
          {% unless quantity_value > quantity_max %}
            <div class="product-rangebar {{ quantity_value }} {{ quantity_max }}">
              <div class="product-rangebar-fill" style="--rangebar-value:{{ quantity_width }}%;"></div>
            </div>
          {% endunless %}
        </div>

      {% when 'variant' %}
        {% render 'product-variants',
          product_form_id: product_form_id,
          product: product,
          section: section,
          block: block
        %}
      {%- when 'quantity' -%}
        {% render 'quantity', product_form_id: product_form_id %}
      {% when 'button' %}
        {% render 'product-form',
          product: product,
          product_form_id: product_form_id,
          current_variant: current_variant,
          block: block
        %}
      {% when 'custom_content' %}
        {% if block.settings.text != blank %}
          <div class="custom-content-wrapper">
            {% if block.settings.option_type == 'link' %}
              <a href="{{ block.settings.link }}" class="custom-content-card">
                {% if block.settings.custom_svg != blank %}
                  {{ block.settings.custom_svg }}
                {% endif %}
                <span>{{ block.settings.text }}</span>
              </a>
            {% else %}
              <custom-content-element data-id="{{ block.id }}">
                <a
                  href="#"
                  class="custom-content-card"
                  data-custom-drawer
                >
                  {% if block.settings.custom_svg != blank %}
                    {{ block.settings.custom_svg }}
                  {% endif %}
                  <span>{{ block.settings.text }}</span>
                </a>
                {% render 'custom-content', block: block %}
              </custom-content-element>
            {% endif %}
          </div>
        {% endif %}
      {% when 'text_icon' %}
        {% capture content %}
          {% for i in (1..3) %}
            {% liquid
              assign icon_index = 'custom_svg_' | append: forloop.index
              assign custom_icon = block.settings[icon_index]
              assign text_index = 'text_' | append: forloop.index
              assign text = block.settings[text_index]
            %}
            {% if text != blank or custom_icon != blank %}
              <li>
                {% if custom_icon != blank %}
                  <span class="product-icon">
                    {{ custom_icon }}
                  </span>
                {% endif %}
                {% if text != blank %}
                  <span>{{ text }}</span>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        {% endcapture %}
        {% if content != blank %}
          <div class="product-icon-wrapper">
            <ul class="list-style-none">
              {{ content }}
            </ul>
          </div>
        {% endif %}
      {%- when 'share' -%}
        {%- render 'social-share',
          share_link: product.url,
          share_title: product.title,
          share_product: product,
          block: block
        %}
      {% when 'description' %}
        <div class="product-info-des description rte" {{ block.shopify_attributes }}>
          {{
            product.description
            | replace: '<table', '<div class="table-content"><table '
            | replace: '</table>', '</table></div>'
          }}
        </div>
      {% when 'custom_liquid' %}
        <div class="custom-liquid rte" {{ block.shopify_attributes }}>
          {{ block.settings.custom_liquid }}
        </div>
      {%- when 'collapsible_content' -%}
        <collapsible class="product-accordion-card">
          {% assign count_int = 1 %}
          {% if block.settings.show_description %}
            {% assign hideContent = true %}
            <collapsible-item class="product-accordion-item">
              <accordion-element
                class="
                  {% if block.settings.open_first_content
                      and block.settings.show_description == false
                      and count_int == 2
                    %}
                    {% assign hideContent = false %}
                    active
                  {% endif %}
                "
              >
                <div detail-summary>
                  {% if block.settings.description_heading != blank %}
                    {{- block.settings.description_heading -}}
                  {% else %}
                    Description
                  {% endif %}
                  <span>
                    <svg
                      class="icon-xxsmall"
                      width="14"
                      height="14"
                      viewBox="0 0 14 14"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path class="line-h" d="M12 5V7L0 7L8.74243e-08 5L12 5Z" fill="currentcolor" />
                      <path class="line-v" d="M7 12H5L5 0L7 1.74845e-07L7 12Z" fill="currentcolor" />
                    </svg>
                  </span>
                </div>
                <div
                  id="collapsed-content-{{ count_int }}"
                  class="collapsible-content rte"
                  {% if hideContent %}
                    style="display:none"
                  {% endif %}
                  detail-expand
                >
                  {{
                    product.description
                    | replace: '<table', '<div class="table-content"><table '
                    | replace: '</table>', '</table></div>'
                  }}
                </div>
              </accordion-element>
            </collapsible-item>
          {% endif %}
          {% for i in (1..3) %}
            {% assign count_int = count_int | plus: 1 %}
            {% liquid
              assign headingindex = 'heading_' | append: forloop.index
              assign heading = block.settings[headingindex]
              assign description_index = 'description_' | append: forloop.index
              assign custom_description = block.settings[description_index]
            %}
            {% if heading != blank %}
              {% assign hideContent = true %}
              <collapsible-item class="product-accordion-item">
                <accordion-element
                  class="
                    {% if block.settings.open_first_content
                      and block.settings.show_description == false
                      and count_int == 2
                    %}
                      {% assign hideContent = false %}
                      active
                    {% endif %}
                  "
                >
                  <div detail-summary>
                    {{- heading -}}
                    <span>
                      <svg
                        class="icon-xxsmall"
                        width="14"
                        height="14"
                        viewBox="0 0 14 14"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path class="line-h" d="M12 5V7L0 7L8.74243e-08 5L12 5Z" fill="currentcolor"/>
                        <path class="line-v" d="M7 12H5L5 0L7 1.74845e-07L7 12Z" fill="currentcolor"/>
                      </svg>
                    </span>
                  </div>
                  <div
                    id="collapsed-content-{{ count_int }}"
                    class="collapsible-content rte"
                    {% if hideContent %}
                      style="display:none"
                    {% endif %}
                    detail-expand
                  >
                    {{ custom_description }}
                  </div>
                </accordion-element>
              </collapsible-item>
            {% endif %}
          {% endfor %}
        </collapsible>
      {%- when 'pickup' -%}
        {%- assign pickup_availabilities = current_variant.store_availabilities | where: 'pick_up_enabled', true -%}
        <pickup-availability
          class="pickup-availability"
          id="pickup-availability-{{ section.id }}"
          data-root-url="{{ routes.root_url }}"
          data-variant-id="{{ current_variant.id }}"
          {% if current_variant.available and pickup_availabilities.size > 0 %}
            available
          {% endif %}
          data-pickup-availability
          {{ block.shopify_attributes }}
        >
          {%- render 'pickup-availability', current_variant: current_variant -%}
        </pickup-availability>
      {% when 'complementary_products' %}
        {% render 'complementary-products', product: product, section: section, block: block %}
    {% endcase %}
  {% endfor %}
</div>{%- comment -%}

