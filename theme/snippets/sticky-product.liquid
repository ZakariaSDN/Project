{%- assign product_form_id = 'product-form-' | append: section.id -%}
<product-cart-sticky class="product-cart-sticky" data-section="{{ section.id }}">
  <div class="product-cart-sticky-card">
    <figure class="product-cart-sticky-image" id="product-image-{{ section.id }}-sticky">
      {%- if product.selected_or_first_available_variant.featured_media != null -%}
        {%- assign featured_media = product.selected_or_first_available_variant.featured_media -%}
      {% else %}
        {%- assign featured_media = product.featured_media -%}
      {% endif %}
      {% if featured_media != blank %}
        <img
          src="{{ featured_media | image_url: width: 100 }}"
          width="100"
          height="100"
          loading="lazy"
          data-sticky-image
        >
      {% else %}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </figure>
    <div class="product-cart-sticky-info">
      <span class="product-cart-sticky-title font-heading">{{ product.title | escape }}</span>
      <div
        id="sticky-price-{{ section.id }}-sticky"
        class="product-price-wrapper no-js-hidden"
        role="status"
        data-sticky-main-price
      >
        {% render 'price', product: product, section: section %}
      </div>
    </div>
    <div class="product-cart-sticky-button">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M15.1407 8.07177L0.999942 8.07037L15.1407 8.07177ZM8.07031 15.1421V1V15.1421Z" fill="currentColor"/>
        <path d="M15.1407 8.07177L0.999942 8.07037M8.07031 15.1421V1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
  <div class="product-cart-sticky-detail">
    {% if product != blank %}
      {%- unless product.has_only_default_variant -%}
        <variant-selector
          id="variant-selects-{{ section.id }}-sticky"
          class="variant-selector-wrapper"
          data-page="{{ template.name }}"
          data-url="{{  product.url }}"
          data-section="{{ section.id }}"
          data-update-url="true"
          data-sticky="1"
        >
          {%- for optionSticky in product.options_with_values -%}
            {%- liquid
              assign color_options = settings.color_name | downcase
              assign down_option = optionSticky.name | downcase
              assign option_index = forloop.index
            -%}
            <fieldset class="product-form__controls stikcy-product-form-options variant-selector-card {% if color_options contains down_option %}color-swatches-box{% else %}product-variants-box{% endif %}">
              <legend class="variant-swatches-text">
                <strong>{{ optionSticky.name -}}</strong>
                :
                <span
                  class="form__label__value selected-option-{{ section.id }}-{{ forloop.index }}"
                  selected-option-value
                >
                  {{- optionSticky.selected_value -}}
                </span>
              </legend>
              {% if settings.option_style == 'swatch' %}
                <div class="variant-swatches-box">
                  <ul class="list-style-none variant-swatches-list {% unless color_options contains down_option -%} variant-options square{% else %} round{% endunless %}">
                    {%- for valueSticky in optionSticky.values -%}
                      {% liquid
                        assign variant_option = 'option' | append: optionSticky.position
                        assign variant_value = product.variants | where: variant_option, valueSticky | compact: 'featured_media' | first

                        if valueSticky.swatch.image
                          assign image_url = valueSticky.swatch.image | image_url: width: 50
                          assign swatch_value = 'background-image: url(' | append: image_url | append: ')'
                          assign swatch_focal_point = valueSticky.swatch.image.presentation.focal_point
                        elsif valueSticky.swatch.color
                          assign swatch_value = '--color-swatch-background: rgb(' | append: valueSticky.swatch.color.rgb | append: ')'
                        else
                          assign swatch_value = null
                        endif
                      -%}
                      <li class="swatches-list-item  {% if option.selected_value == valueSticky %}active{% endif %}">
                        <span>
                          <input
                            type="radio"
                            class="swatch-input"
                            id="sticky-option-{{ option_index }}-{{ forloop.index }}-{{ section.id }}"
                            form="{{ product_form_id }}"
                            name="sticky-option-{{ option_index }}"
                            value="{{ valueSticky | escape }}"
                            title="{{ valueSticky }}"
                            {% if optionSticky.selected_value == valueSticky %}
                              checked
                            {% endif %}
                          >
                          <label
                            for="sticky-option-{{ option_index }}-{{ forloop.index }}-{{ section.id }}"

                            class="swatch-label {% if swatch_focal_point %} variant-image-focal{% endif %}"
                            {% if variant_value and settings.show_variant_image %}
                              style="background-image:url({{ variant_value.featured_media.preview_image | image_url: width: 100 }});"
                            {% else %}
                              {% if swatch_value != null -%}
                                style="{{ swatch_value }}; {% if swatch_focal_point %} --swatch-focal-point: {{ swatch_focal_point }};{% endif %}"
                              {% else %}
                                data-color="{{ valueSticky }}"
                                data-color-name="{{ valueSticky | downcase }}"
                                style="--color-swatch-background:{{ valueSticky }};"
                              {% endif %}
                            {% endif %}
                          >
                            {% if color_options contains down_option -%}
                              <span class="hidden">
                                {{- valueSticky -}}
                              </span>
                            {% else %}
                              {{- valueSticky -}}
                            {%- endif -%}
                          </label>
                        </span>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% else %}
                <div class="select-variant-box">
                  <select
                    id="sticky-option-{{ section.id }}-{{ optionSticky.position }}-{{ forloop.index0 }}"
                    class="select-variant-options select-box"
                    name="sticky-{{ optionSticky.name }}"
                    form
                  >
                    {% for valueSticky in optionSticky.values %}
                      <option
                        {% if optionSticky.selected_value == valueSticky %}
                          selected
                        {% endif %}
                        data-option
                        value="{{ valueSticky }}"
                      >
                        {{- valueSticky -}}
                      </option>
                    {% endfor %}
                  </select>
                </div>
              {% endif %}
            </fieldset>
          {% endfor %}
          <script type="application/json" data-name="main-product">
             {{ product.selected_or_first_available_variant | json }}
          </script>
        </variant-selector>
      {% endunless %}
    {% endif %}
    <div class="add-to-cart-wrapper">
      {% render 'quantity', product_form_id: product_form_id, sticky: true %}

      <button
        type="submit"
        name="add"
        class="addtocart-button button-outline button"
        form="{{ 'product-form-' | append: section.id }}"
        data-sticky-atc-wrapper
        {%- unless current_variant.available -%}
          disabled
        {% endunless %}
        {% if settings.enable_cartdrawer %}
          data-add-to-cart
        {% endif %}
        data-addtocart-main
      >
        <span class="button-text" data-addtocart-text>
          {%- unless current_variant.available -%}
            {{ 'products.product.sold_out' | t }}
          {%- else -%}
            {%- if preorder -%}
              Preorder
            {%- else -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- endif -%}
          {%- endunless -%}
        </span>
        <span class="spinner-loading-btn btn-loader hidden">
          <svg class="btn-loader-icon" viewBox="0 0 24 24">
            <circle cx="4" cy="12" r="3" fill="currentColor">
              <animate id="svg3DotsScale0" attributeName="r" begin="0;svg3DotsScale1.end-0.375s" dur="1.125s" values="3;.2;3"></animate>
            </circle>
            <circle cx="12" cy="12" r="3" fill="currentColor">
              <animate attributeName="r" begin="svg3DotsScale0.end-0.9s" dur="1.125s" values="3;.2;3"></animate>
            </circle>
            <circle cx="20" cy="12" r="3" fill="currentColor">
              <animate id="svg3DotsScale1" attributeName="r" begin="svg3DotsScale0.end-0.675s" dur="1.125s" values="3;.2;3"></animate>
            </circle>
          </svg>
        </span>
      </button>
    </div>
  </div>
</product-cart-sticky>
