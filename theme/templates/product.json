        "custom_liquid_iB3JY4": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%} Description par variante — robuste (Desert/Dawn) {%- endcomment -%}\n{%- assign ns = 'custom' -%}{%- assign key = 'variant_description' -%}\n\n<div id=\"vdesc-{{ section.id }}\" class=\"rte\" hidden></div>\n\n<script id=\"vdesc-data-{{ section.id }}\" type=\"application/json\">\n{\n{%- for v in product.variants -%}\n  \"{{ v.id }}\": {{ v.metafields[ns][key] | metafield_tag | json }}{% unless forloop.last %},{% endunless %}\n{%- endfor -%}\n}\n</script>\n\n<script>\n(() => {\n  const dataEl = document.getElementById('vdesc-data-{{ section.id }}');\n  if (!dataEl) return;\n\n  let map = {};\n  try { map = JSON.parse(dataEl.textContent || '{}'); } catch(e) {}\n  const out = document.getElementById('vdesc-{{ section.id }}');\n\n  function render(id){\n    const html = map[id] || '';\n    out.innerHTML = html || '';\n    out.hidden = !html;\n  }\n\n  function getId(){\n    const form = document.querySelector('form[action*=\"/cart/add\"]');\n    if (!form) return null;\n    const input = form.querySelector('[name=\"id\"]');\n    return input && input.value ? String(input.value) : null;\n  }\n\n  // Initial\n  let last = getId();\n  if (last) render(last);\n\n  // Événements courants de changement de variante\n  ['variant:change','variant:changed','product:variant-change','theme:variant:change'].forEach(evt=>{\n    document.addEventListener(evt, e=>{\n      const v = e.detail && (e.detail.variant || e.detail.productVariant);\n      if (v && v.id) { last = String(v.id); render(last); }\n    });\n  });\n\n  // Écoute générique + MutationObserver + mini polling\n  ['change','input','click'].forEach(evt=>{\n    document.addEventListener(evt, ()=>{\n      const id = getId();\n      if (id && id !== last){ last = id; render(id); }\n    });\n  });\n\n  const form = document.querySelector('form[action*=\"/cart/add\"]');\n  if (form) {\n    const mo = new MutationObserver(() => {\n      const id = getId();\n      if (id && id !== last){ last = id; render(id); }\n    });\n    mo.observe(form, {subtree:true, childList:true, attributes:true, attributeFilter:['value']});\n  }\n\n  setInterval(() => {\n    const id = getId();\n    if (id && id !== last){ last = id; render(id); }\n  }, 500);\n})();\n</script>"
          }
